---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  pageType?: 'event' | 'page';
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = '/og-default.jpg',
  canonicalUrl,
  ogType = 'website',
  pageType = 'page',
  noindex = false,
} = Astro.props;

const siteUrl   = 'https://milancocktaildays.it';
const lang      = Astro.url.pathname.startsWith('/en') ? 'en' : 'it';
const fullTitle = title.includes('Milan Cocktail Days')
  ? title
  : `${title} | Milan Cocktail Days 2027`;
const canonical = canonicalUrl
  ? (canonicalUrl.startsWith('http') ? canonicalUrl : `${siteUrl}${canonicalUrl}`)
  : `${siteUrl}${Astro.url.pathname}`;
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const ogLocale    = lang === 'en' ? 'en_US' : 'it_IT';
const skipLabel   = lang === 'en' ? 'Skip to main content' : 'Vai al contenuto principale';

const jsonLdEvent = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Milan Cocktail Days 2027',
  alternateName: 'MCD 2027',
  description: 'La prima settimana dedicata alla cultura del cocktail a Milano. 10 serate, i migliori bar della città, cocktail signature esclusivi.',
  startDate: '2027-04-01',
  endDate: '2027-05-31',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  image: `${siteUrl}/og-default.jpg`,
  url: siteUrl,
  location: {
    '@type': 'City',
    name: 'Milano',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Milano',
      addressRegion: 'MI',
      addressCountry: 'IT',
    },
  },
  organizer: {
    '@type': 'Organization',
    name: 'Milan Cocktail Days',
    url: siteUrl,
  },
  offers: {
    '@type': 'Offer',
    name: 'Pass Festival',
    availability: 'https://schema.org/InStock',
    validFrom: '2026-01-01',
    url: `${siteUrl}/contatti`,
  },
};

const jsonLdOrg = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Milan Cocktail Days',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  sameAs: [
    'https://www.instagram.com/milancocktailweek',
    'https://www.linkedin.com/company/milancocktailweek',
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Tally embed widget -->
    <script src="https://tally.so/widgets/embed.js"></script>

    <!-- 1. CHARSET + VIEWPORT -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2E4A36" />

    <!-- 2. CRITICAL INLINE CSS: prevent FOUC -->
    <style>
      *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
      html{scroll-behavior:smooth}
      body{background:#F7F2E5;color:#1A1416;font-family:Arial,sans-serif}
      .skip-link{position:absolute;top:-100%;left:1rem;background:#B83A2E;color:#F7F2E5;padding:.5rem 1rem;font-weight:700;font-size:.875rem;text-decoration:none;z-index:9999;transition:top .2s}
      .skip-link:focus{top:1rem}
    </style>

    <!-- 3. PRECONNECT FONT -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- 4. GOOGLE FONTS — Jost (display) + Montserrat (body) -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Montserrat:ital,wght@0,400;0,500;0,700;1,400&display=swap"
    />

    <!-- 5. TITLE + META BASE -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Milan Cocktail Days" />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
    <meta name="generator" content={Astro.generator} />

    <!-- 6. CANONICAL -->
    <link rel="canonical" href={canonical} />

    <!-- 7. OPEN GRAPH -->
    <meta property="og:site_name" content="Milan Cocktail Days" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale} />

    <!-- 8. TWITTER CARD -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- 9. FAVICON -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- 10. JSON-LD — condizionale su pageType -->
    {pageType === 'event'
      ? <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdEvent)} />
      : <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdOrg)} />
    }

    <!-- ============================================================
         TRACKING — Fase 4
         Ordine critico: iubenda PRIMA di GTM
         ============================================================ -->

    <!-- iubenda Cookie Solution — DEVE precedere GTM -->
    <!-- Sostituire YOUR_SITE_ID con il Site ID del progetto iubenda -->
    <script is:inline type="text/javascript">
      var _iub = _iub || [];
      _iub.csConfiguration = {
        siteId: "YOUR_SITE_ID",
        cookiePolicyId: 47664786,
        lang: "it",
        storage: { useSiteId: true },
        banner: {
          position: "bottom",
          backgroundColor: "#1A1410",
          textColor: "#B8AC9A",
          acceptButtonColor: "#C4850D",
          acceptButtonCaptionColor: "#1A1410",
          customizeButtonColor: "#231C19",
          customizeButtonCaptionColor: "#B8AC9A",
          acceptButtonCaption: "Accetta",
          customizeButtonCaption: "Preferenze",
          content: "Utilizziamo cookie per migliorare la tua esperienza su Milan Cocktail Days.",
          rejectButtonDisplay: true,
          rejectButtonColor: "#231C19",
          rejectButtonCaptionColor: "#B8AC9A",
          rejectButtonCaption: "Rifiuta",
          closeButtonDisplay: false,
          fontSizeBody: "13px",
          listPurposes: true,
        },
        callback: {
          onConsentGiven: function() {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({ event: "iubenda_consent_given" });
          },
        },
        consentOnContinuedBrowsing: false,
        perPurposeConsent: true,
        whitelabel: false,
        googleAdditionalConsentMode: false,
      };
    </script>
    <script is:inline type="text/javascript" src="//cdn.iubenda.com/cs/iubenda_cs.js" charset="UTF-8" async></script>
    <!-- Fine iubenda Cookie Solution -->

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-KRJ9XDPV');</script>
    <!-- End Google Tag Manager -->

    <slot name="head-scripts" />
  </head>

  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KRJ9XDPV"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <a href="#main-content" class="skip-link">{skipLabel}</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <slot name="body-scripts" />
  </body>
</html>
