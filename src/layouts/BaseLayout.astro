---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import { getAlternateUrl } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  pageType?: 'event' | 'page';
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = '/og-default.jpg',
  canonicalUrl,
  ogType = 'website',
  pageType = 'page',
  noindex = false,
} = Astro.props;

const siteUrl   = 'https://milanococktaildays.it';
const lang      = Astro.url.pathname.startsWith('/en') ? 'en' : 'it';
const fullTitle = title.includes('Milano Cocktail Days') || title.includes('Milan Cocktail Days')
  ? title
  : `${title} | Milano Cocktail Days 2027`;
const canonical = canonicalUrl
  ? (canonicalUrl.startsWith('http') ? canonicalUrl : `${siteUrl}${canonicalUrl}`)
  : `${siteUrl}${Astro.url.pathname}`;
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const ogLocale    = lang === 'en' ? 'en_US' : 'it_IT';
const skipLabel   = lang === 'en' ? 'Skip to main content' : 'Vai al contenuto principale';

// hreflang alternates — computed from current path + i18n map
const normalPath   = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const alternateUrl = getAlternateUrl(normalPath); // opposite-lang path, or fallback root

// For EN pages: alternateUrl === '/' means either the explicit /en/→/ mapping (home)
// or the fallback "no IT page exists" (e.g. /en/festival/). Distinguish by checking the path.
const hasItPage = lang === 'it' || (lang === 'en' && (normalPath === '/en/' || alternateUrl !== '/'));
const itHref = lang === 'it' ? `${siteUrl}${normalPath}` : (hasItPage ? `${siteUrl}${alternateUrl}` : '');
const enHref = lang === 'en' ? `${siteUrl}${normalPath}` : `${siteUrl}${alternateUrl}`;
const alternates = [
  ...(itHref ? [{ hreflang: 'it', href: itHref }] : []),
  { hreflang: 'en', href: enHref },
  { hreflang: 'x-default', href: itHref || enHref },
];

const jsonLdEvent = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Milano Cocktail Days',
  description: 'Il festival diffuso dei cocktail bar di Milano. 10 giorni tra aprile e maggio 2027 per scoprire i migliori bar della città.',
  startDate: '2027-04-25T18:00',
  endDate: '2027-05-04T23:59',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  image: `${siteUrl}/og-image.jpg`,
  url: siteUrl,
  location: {
    '@type': 'City',
    name: 'Milano',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Milano',
      addressRegion: 'MI',
      addressCountry: 'IT',
    },
  },
  organizer: [
    { '@type': 'Person', name: 'Luca Ferrara' },
    { '@type': 'Person', name: 'Nicole Zattarin' },
  ],
  offers: {
    '@type': 'Offer',
    name: 'Pass Festival',
    availability: 'https://schema.org/InStock',
    validFrom: '2026-01-01',
    url: `${siteUrl}/contatti`,
  },
};

const jsonLdOrg = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Milan Cocktail Days',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  sameAs: [
    'https://www.instagram.com/milancocktailweek',
    'https://www.linkedin.com/company/milancocktailweek',
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- 1. CHARSET + VIEWPORT -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2E4A36" />

    <!-- 2. CRITICAL INLINE CSS: design tokens + above-fold layout -->
    <style>
      *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
      html{scroll-behavior:smooth;overflow-x:hidden}
      body{overflow-x:hidden;background:#F7F2E5;color:#1A1416;font-family:'Montserrat','Gill Sans',Arial,sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased}
      img,picture,video,canvas,svg{display:block;max-width:100%}
      :root{
        --color-basilico:#2E4A36;--color-panna:#F7F2E5;--color-bitter:#B83A2E;
        --color-mora:#4A2540;--color-pesco:#D97A91;--color-inchiostro:#1A1416;
        --color-panna-100:#FBF7EC;--color-panna-300:#E6DCC0;--color-panna-400:#C9BD99;
        --color-basilico-600:#3D6048;--color-bitter-500:#D4503F;
        --color-mora-300:#8A5A7A;--color-pesco-300:#F2C5CD;
        --color-inchiostro-300:#A89BA0;--color-inchiostro-500:#6B5C61;--color-inchiostro-700:#3A2E32;
        --color-avorio:var(--color-panna);--color-fumo:var(--color-mora);
        --font-display:'Jost','Futura','Century Gothic','Trebuchet MS',sans-serif;
        --font-body:'Montserrat','Gill Sans','Gill Sans MT',Arial,sans-serif;
        --text-hero:clamp(3rem,8vw,7rem);--text-h1:clamp(2.2rem,5vw,4rem);
        --text-h2:clamp(1.6rem,3.5vw,2.75rem);--text-h3:clamp(1.2rem,2vw,2rem);
        --text-h4:1.5rem;--text-h5:1.25rem;--text-body-lg:1.125rem;
        --text-body:1rem;--text-small:.875rem;--text-label:.75rem;
        --container:1200px;--section-py:clamp(4rem,8vw,8rem);
        --space-xs:.5rem;--space-sm:1rem;--space-md:2rem;--space-lg:4rem;--space-xl:8rem;
        --radius-sm:4px;--radius-md:8px;--radius-lg:16px;
        --border-hairline:.5px solid var(--color-basilico);
        --border-hairline-dark:.5px solid color-mix(in srgb,var(--color-panna) 35%,transparent);
      }
      /* Sticky header visible immediately */
      .site-header{position:sticky;top:0;z-index:100;background-color:var(--color-basilico);border-bottom:.5px solid var(--color-basilico-600)}
      .header-inner{max-width:var(--container);margin:0 auto;padding:0 2rem;height:64px;display:flex;align-items:center;gap:2rem}
      /* Hero: correct sizing so the LCP image covers the section */
      .s-hero{position:relative;min-height:885px;display:flex;align-items:center;overflow:hidden;background-color:var(--color-mora)}
      .hero-bg{position:absolute;inset:0;z-index:0;display:block;width:100%;height:100%}
      .hero-bg img{width:100%;height:100%;object-fit:cover;object-position:80% center;display:block}
      @media(max-width:768px){.s-hero{min-height:100svh}}
      /* Skip link */
      .skip-link{position:absolute;top:-100%;left:1rem;background:var(--color-bitter);color:var(--color-panna);padding:.5rem 1rem;font-weight:700;font-size:.875rem;text-decoration:none;z-index:9999;transition:top .2s}
      .skip-link:focus{top:1rem}
    </style>

    <!-- 3. PRECONNECT — fonts + third parties -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="preconnect" href="https://cdn.iubenda.com" />
    <link rel="preconnect" href="https://cs.iubenda.com" />
    <link rel="preconnect" href="https://idb.iubenda.com" />
    <link rel="preconnect" href="https://tally.so" />

    <!-- 4. GOOGLE FONTS — non-blocking preload (rel switches to stylesheet on load) -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Montserrat:ital,wght@0,400;0,500;0,700;1,400&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Montserrat:ital,wght@0,400;0,500;0,700;1,400&display=swap"
      />
    </noscript>

    <!-- 5–8. SEO: title, meta, canonical, OG, Twitter -->
    <SEO
      title={fullTitle}
      description={description}
      canonical={canonical}
      ogImage={ogImageAbsolute}
      ogType={ogType}
      noindex={noindex}
      alternates={alternates}
    />
    <meta name="author" content="Milan Cocktail Days" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:locale" content={ogLocale} />

    <!-- 9. FAVICON -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- 10. JSON-LD — condizionale su pageType -->
    {pageType === 'event'
      ? <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdEvent)} />
      : <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdOrg)} />
    }

    <slot name="head-scripts" />
  </head>

  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KRJ9XDPV"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <a href="#main-content" class="skip-link">{skipLabel}</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <!-- Tally embed widget — deferred so it doesn't block render -->
    <script is:inline defer src="https://tally.so/widgets/embed.js"></script>

    <!-- ============================================================
         TRACKING — moved to body so these inline scripts don't block
         initial paint. iubenda config runs before loadTracking IIFE.
         ============================================================ -->

    <!-- iubenda config: must be set before iubenda_cs.js executes -->
    <script is:inline type="text/javascript">
      var _iub = _iub || [];
      _iub.csConfiguration = {
        siteId: "YOUR_SITE_ID",
        cookiePolicyId: 47664786,
        lang: "it",
        storage: { useSiteId: true },
        banner: {
          position: "bottom",
          backgroundColor: "#1A1410",
          textColor: "#B8AC9A",
          acceptButtonColor: "#C4850D",
          acceptButtonCaptionColor: "#1A1410",
          customizeButtonColor: "#231C19",
          customizeButtonCaptionColor: "#B8AC9A",
          acceptButtonCaption: "Accetta",
          customizeButtonCaption: "Preferenze",
          content: "Utilizziamo cookie per migliorare la tua esperienza su Milan Cocktail Days.",
          rejectButtonDisplay: true,
          rejectButtonColor: "#231C19",
          rejectButtonCaptionColor: "#B8AC9A",
          rejectButtonCaption: "Rifiuta",
          closeButtonDisplay: false,
          fontSizeBody: "13px",
          listPurposes: true,
        },
        callback: {
          onConsentGiven: function() {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({ event: "iubenda_consent_given" });
          },
        },
        consentOnContinuedBrowsing: false,
        perPurposeConsent: true,
        whitelabel: false,
        googleAdditionalConsentMode: false,
      };
    </script>

    <!-- iubenda CS + GTM: loaded on first interaction or after 5s -->
    <script is:inline>
      (function () {
        var fired = false;
        function loadTracking() {
          if (fired) return;
          fired = true;
          ['scroll', 'click', 'keydown', 'touchstart'].forEach(function (e) {
            window.removeEventListener(e, loadTracking);
          });
          var iu = document.createElement('script');
          iu.src = '//cdn.iubenda.com/cs/iubenda_cs.js';
          iu.async = true;
          document.head.appendChild(iu);
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0];
            var j = d.createElement(s);
            var dl = l !== 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', 'GTM-KRJ9XDPV');
        }
        ['scroll', 'click', 'keydown', 'touchstart'].forEach(function (e) {
          window.addEventListener(e, loadTracking, { once: true, passive: true });
        });
        window.addEventListener('load', function () {
          setTimeout(loadTracking, 5000);
        }, { once: true });
      })();
    </script>

    <slot name="body-scripts" />
  </body>
</html>
