---
const linkRapidi = [
  { href: '/partecipa', label: 'Partecipa' },
  { href: '/bar',       label: 'Bar Partner' },
  { href: '/sponsor',   label: 'Sponsor' },
];

const social = [
  { href: '#', label: 'Instagram' },
  { href: '#', label: 'Facebook' },
  { href: '#', label: 'LinkedIn' },
];

const annoCorrente = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">

    <div class="footer-col footer-col--brand">
      <a href="/" class="footer-logo" aria-label="Milan Cocktail Days — torna alla home">
        <img src="/logos/logo_1_v.FINAL/Inchiostro.svg" alt="Milan Cocktail Days" class="footer-logo-img" />
      </a>
      <p class="footer-tagline">Milano <span aria-hidden="true">✶</span> Maggio 2027</p>
      <p class="footer-desc">
        La prima settimana dedicata alla cultura del cocktail milanese.
        Trenta bar, dieci giorni, un pass.
      </p>
    </div>

    <div class="footer-col footer-col--nav">
      <h3 class="footer-heading">Link Rapidi</h3>
      <ul class="footer-nav-list" role="list">
        {linkRapidi.map(({ href, label }) => (
          <li>
            <a href={href} class="footer-nav-link">{label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer-col footer-col--social">
      <h3 class="footer-heading">Seguici</h3>
      <ul class="footer-social-list" role="list">
        {social.map(({ href, label }) => (
          <li>
            <a href={href} class="footer-nav-link" target="_blank" rel="noopener noreferrer">
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>

  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <span class="footer-copyright">
        &copy; {annoCorrente} Milan Cocktail Days. Tutti i diritti riservati.
      </span>
      <div class="footer-legal">
        <a
          href="https://www.iubenda.com/privacy-policy/47664786"
          class="iubenda-white iubenda-noiframe iubenda-embed footer-legal-link"
          title="Privacy Policy"
        >Privacy Policy</a>
        <span class="footer-legal-sep" aria-hidden="true">✶</span>
        <a
          href="https://www.iubenda.com/privacy-policy/47664786/cookie-policy"
          class="iubenda-white iubenda-noiframe iubenda-embed footer-legal-link"
          title="Cookie Policy"
        >Cookie Policy</a>
        <span class="footer-legal-sep" aria-hidden="true">✶</span>
        <a
          href="#"
          id="iubenda-cs-preferences-link"
          class="footer-legal-link"
          title="Gestisci preferenze cookie"
        >Preferenze</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-inchiostro);
    border-top: 0.5px solid color-mix(in srgb, var(--color-panna) 8%, transparent);
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) 2rem clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: 1.75fr 1fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    border-bottom: 0.5px solid color-mix(in srgb, var(--color-panna) 8%, transparent);
  }

  /* ---- Logo ---- */
  .footer-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    margin-bottom: var(--space-md);
    opacity: 0.9;
    transition: opacity 0.2s ease;
  }
  .footer-logo:hover { opacity: 1; }

  .footer-logo-img {
    width: 120px;
    height: auto;
    display: block;
    filter: brightness(0) invert(1);
    opacity: 0.85;
  }

  .footer-tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-small);
    color: var(--color-pesco-300);
    letter-spacing: 0.06em;
    margin-bottom: var(--space-sm);
    opacity: 0.65;
  }

  .footer-desc {
    font-size: var(--text-small);
    color: var(--color-panna);
    line-height: 1.75;
    opacity: 0.45;
    max-width: 280px;
  }

  /* ---- Headings ---- */
  .footer-heading {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-panna);
    opacity: 0.35;
    margin-bottom: var(--space-md);
  }

  /* ---- Lists ---- */
  .footer-nav-list,
  .footer-social-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .footer-nav-link {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--color-panna);
    opacity: 0.6;
    text-decoration: none;
    padding: 0.5rem 0;
    border-bottom: 0.5px solid color-mix(in srgb, var(--color-panna) 6%, transparent);
    transition: opacity 0.2s ease, padding-left 0.2s ease;
  }

  .footer-nav-link:hover {
    opacity: 1;
    padding-left: 0.5rem;
  }

  /* ---- Bottom bar ---- */
  .footer-bottom {
    background-color: transparent;
    padding: 1.25rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .footer-copyright {
    font-size: var(--text-label);
    color: var(--color-panna);
    opacity: 0.25;
    letter-spacing: 0.06em;
  }

  .footer-legal {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .footer-legal-link {
    font-family: var(--font-body);
    font-size: var(--text-label);
    color: var(--color-panna) !important;
    opacity: 0.35;
    text-decoration: none;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: opacity 0.2s;
  }

  .footer-legal-link:hover { opacity: 0.75 !important; }

  .footer-legal-sep {
    color: var(--color-panna);
    font-size: 0.5rem;
    opacity: 0.2;
  }

  /* ---- Mobile ---- */
  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .footer-col--brand {
      padding-bottom: var(--space-md);
      border-bottom: 0.5px solid color-mix(in srgb, var(--color-panna) 8%, transparent);
    }

    .footer-bottom-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-sm);
    }
  }
</style>
