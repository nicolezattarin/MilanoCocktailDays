---
/**
 * Footer — three columns: logo/tagline, quick links, social + legal
 * Lang detected from URL — no prop needed.
 */
import { getLang } from '../i18n/utils';

const currentPath  = Astro.url.pathname;
const isEn         = getLang(currentPath) === 'en';
const annoCorrente = new Date().getFullYear();

const linkRapidi = isEn
  ? [
      { href: '/en/',         label: 'Home' },
      { href: '/en/bar',      label: 'Bar Partners' },
      { href: '/en/sponsor',  label: 'Sponsor' },
      { href: '/en/contatti', label: 'Contact' },
    ]
  : [
      { href: '/',         label: 'Home' },
      { href: '/bar',      label: 'Bar Partner' },
      { href: '/sponsor',  label: 'Sponsor' },
      { href: '/contatti', label: 'Contatti' },
    ];

const social = [
  { href: 'https://www.instagram.com/milanococktaildays', label: 'Instagram' },
  { href: 'https://www.linkedin.com/company/milano-cocktail-days/', label: 'LinkedIn' },
  { href: 'https://t.me/+_D1s5hFIlwwyMjA0', label: 'Telegram' },
];
---

<footer class="site-footer mcw-filetto">
  <div class="footer-inner">
    <!-- Colonna sinistra: logo + tagline -->
    <div class="footer-col footer-col--brand">
      <a href="/" class="footer-logo" aria-label="Milan Cocktail Days">
        <img src="/logos/logo_1_v.FINAL/Inchiostro.svg" alt="Milan Cocktail Days" class="footer-logo-img" width="140" height="140" />
      </a>
      <p class="footer-tagline">Milano ✶ {isEn ? 'May 2027' : 'Maggio 2027'}</p>
      <p class="footer-desc">
        {isEn ? "Milan's cocktail culture week." : 'La settimana della cocktail culture milanese.'}<br />
      </p>
    </div>

    <!-- Colonna centrale: link rapidi -->
    <div class="footer-col footer-col--nav">
      <h3 class="footer-heading">{isEn ? 'Quick Links' : 'Link Rapidi'}</h3>
      <ul class="footer-nav-list" role="list">
        {linkRapidi.map(({ href, label }) => (
          <li>
            <a href={href} class="footer-nav-link">{label}</a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Colonna destra: social + legale -->
    <div class="footer-col footer-col--social">
      <h3 class="footer-heading">{isEn ? 'Follow Us' : 'Seguici'}</h3>
      <ul class="footer-social-list" role="list">
        {social.map(({ href, label }) => (
          <li>
            <a href={href} class="footer-nav-link" target="_blank" rel="noopener noreferrer">
              {label}
            </a>
          </li>
        ))}
      </ul>
      <div class="footer-legal">
        <!-- Link generati da iubenda — sostituire href con URL reali dopo setup -->
        <a
          href="https://www.iubenda.com/privacy-policy/47664786"
          class="iubenda-white iubenda-noiframe iubenda-embed"
          title="Privacy Policy"
        >Privacy Policy</a>
        <span class="footer-legal-sep" aria-hidden="true">✶</span>
        <a
          href="https://www.iubenda.com/privacy-policy/47664786/cookie-policy"
          class="iubenda-white iubenda-noiframe iubenda-embed"
          title="Cookie Policy"
        >Cookie Policy</a>
        <span class="footer-legal-sep" aria-hidden="true">✶</span>
        <a
          href="#"
          id="iubenda-cs-preferences-link"
          title={isEn ? 'Manage cookie preferences' : 'Gestisci preferenze cookie'}
        >{isEn ? 'Cookie Preferences' : 'Preferenze Cookie'}</a>
      </div>
    </div>
  </div>

  <!-- Firma di chiusura -->
  <div class="footer-bottom">
    <span class="footer-copyright">
      &copy; {annoCorrente} Milan Cocktail Days. {isEn ? 'All rights reserved.' : 'Tutti i diritti riservati.'}
    </span>
    <span class="footer-signature" aria-hidden="true">✶</span>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-mora);
    padding-top: var(--space-lg);
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-md) var(--space-lg);
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: var(--space-lg);
  }

  /* ---- Logo colonna sinistra ----------------------------- */
  .footer-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    margin-bottom: var(--space-sm);
  }

  .footer-logo-img {
    width: 140px;
    height: auto;
    display: block;
    filter: brightness(0) invert(1);
  }

  .footer-tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 1rem;
    color: var(--color-pesco-300);
    letter-spacing: 0.04em;
    margin-bottom: var(--space-sm);
  }

  .footer-desc {
    font-size: var(--text-small);
    color: var(--color-panna);
    line-height: 1.7;
    opacity: 0.7;
  }

  /* ---- Intestazioni colonne ------------------------------ */
  .footer-heading {
    font-family: var(--font-display);
    font-size: var(--text-h4);
    font-weight: 600;
    color: var(--color-panna);
    margin-bottom: var(--space-sm);
    line-height: 1.25;
  }

  /* ---- Liste link --------------------------------------- */
  .footer-nav-list,
  .footer-social-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .footer-nav-link {
    font-size: var(--text-small);
    color: var(--color-panna);
    opacity: 0.7;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .footer-nav-link:hover {
    opacity: 1;
  }

  /* ---- Social + legale ----------------------------------- */
  .footer-social-list {
    margin-bottom: var(--space-md);
  }

  .footer-legal {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 0.5px solid var(--color-mora-300);
  }

  .footer-legal a {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-panna);
    opacity: 0.7;
    text-decoration: none;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: opacity 0.2s;
  }

  .footer-legal a:hover {
    opacity: 1;
  }

  .footer-legal-sep {
    color: var(--color-mora-300);
    font-size: 0.625rem;
    opacity: 0.8;
  }

  /* ---- Firma di chiusura --------------------------------- */
  .footer-bottom {
    background-color: var(--color-basilico);
    max-width: none;
    padding: var(--space-sm) var(--space-md);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-copyright {
    font-size: 12px;
    color: var(--color-panna-400);
    letter-spacing: 0.04em;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }

  .footer-signature {
    color: var(--color-panna);
    font-size: 1.2rem;
    opacity: 0.4;
  }

  /* ---- Responsive mobile --------------------------------- */
  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .footer-col--brand {
      border-bottom: 0.5px solid var(--color-mora-300);
      padding-bottom: var(--space-md);
    }
  }
</style>
