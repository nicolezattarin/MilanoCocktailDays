---
/**
 * Header — main navigation MCD
 * Desktop: logo · nav links · lang switcher · CTA
 * Mobile: CSS-only hamburger, no JS
 */
import { getLang, getAlternateUrl } from '../i18n/utils';

const currentPath = Astro.url.pathname;
const lang        = getLang(currentPath);
const isEn        = lang === 'en';
const altUrl      = getAlternateUrl(currentPath);

const navLinks = isEn
  ? [
      { href: '/en/bar',      label: 'Bar Partners' },
      { href: '/en/sponsor',  label: 'Sponsor' },
    ]
  : [
      { href: '/bar',      label: 'Bar Partner' },
      { href: '/sponsor',  label: 'Sponsor' },
    ];

const ctaHref       = isEn ? '/en/#lista' : '/#lista';
const ctaLabel      = isEn ? 'Join' : 'Partecipa';
const ctaAriaLabel  = isEn ? 'Join the Milan Cocktail Days waitlist' : "Entra in lista d'attesa Milan Cocktail Days";
const logoAriaLabel = isEn ? 'Milan Cocktail Days — back to home' : 'Milano Cocktail Days — torna alla home';
const menuAriaLabel = isEn ? 'Open navigation menu' : 'Apri il menu di navigazione';

// IT link href: if on EN → altUrl; if on IT → currentPath
const itHref = isEn ? altUrl : currentPath;
const enHref = isEn ? currentPath : altUrl;
---

<header class="site-header">
  <input type="checkbox" id="menu-toggle" class="menu-toggle-input" aria-hidden="true" />

  <div class="header-inner">
    <!-- Logo -->
    <a href={isEn ? '/en/' : '/'} class="site-logo" aria-label={logoAriaLabel}>
      <img src="/logos/logo_3_v.FINAL/Inchiostro.svg" alt={isEn ? "Milan Cocktail Days" : "Milano Cocktail Days"} class="site-logo-img" width="208" height="52" />
    </a>

    <!-- Hamburger (mobile only) -->
    <label for="menu-toggle" class="hamburger" aria-label={menuAriaLabel}>
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </label>

    <!-- Nav + CTA -->
    <nav class="site-nav" aria-label={isEn ? 'Main navigation' : 'Navigazione principale'}>
      <ul class="nav-list" role="list">
        {navLinks.map(({ href, label }) => (
          <li class="nav-item">
            <a
              href={href}
              class:list={['nav-link', { 'is-active': currentPath === href || currentPath.startsWith(href + '/') }]}
              aria-current={currentPath === href ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
        <!-- CTA mobile only -->
        <li class="nav-item nav-item--cta-mobile">
          <a href={ctaHref} class="nav-cta-mobile">{ctaLabel}</a>
        </li>
        <!-- Lang switcher mobile -->
        <li class="nav-item nav-item--lang-mobile">
          <div class="lang-switch-mobile" aria-label={isEn ? 'Language' : 'Lingua'}>
            <a href={itHref} class:list={['lang-btn', { 'lang-btn--active': !isEn }]} hreflang="it" lang="it">IT</a>
            <span class="lang-sep" aria-hidden="true">|</span>
            <a href={enHref} class:list={['lang-btn', { 'lang-btn--active': isEn }]} hreflang="en" lang="en">EN</a>
          </div>
        </li>
      </ul>
    </nav>

    <!-- Lang switcher desktop -->
    <div class="lang-switch" aria-label={isEn ? 'Language' : 'Lingua'}>
      <a href={itHref} class:list={['lang-btn', { 'lang-btn--active': !isEn }]} hreflang="it" lang="it" aria-current={!isEn ? 'true' : undefined}>IT</a>
      <span class="lang-sep" aria-hidden="true">|</span>
      <a href={enHref} class:list={['lang-btn', { 'lang-btn--active': isEn }]} hreflang="en" lang="en" aria-current={isEn ? 'true' : undefined}>EN</a>
    </div>

    <!-- CTA desktop -->
    <a href={ctaHref} class="nav-cta" aria-label={ctaAriaLabel}>
      {ctaLabel}
    </a>
  </div>
</header>

<style>
  /* ---- Header ---------------------------------------------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-basilico);
    border-bottom: 0.5px solid var(--color-basilico-600);
  }

  .header-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
    height: 64px;
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  /* ---- Logo ------------------------------------------------ */
  .site-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    margin-right: auto;
  }

  .site-logo-img {
    height: 52px;
    width: auto;
    display: block;
    filter: brightness(0) invert(1);
  }

  /* ---- Nav links ------------------------------------------- */
  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    color: var(--color-panna);
    text-decoration: none;
    position: relative;
    padding-bottom: 2px;
    transition: color 0.2s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 0.5px;
    background-color: var(--color-bitter);
    transition: width 0.25s ease;
  }

  .nav-link:hover { color: var(--color-panna); }
  .nav-link:hover::after,
  .nav-link.is-active::after { width: 100%; }
  .nav-link.is-active { color: var(--color-panna); }

  /* ---- Lang switcher --------------------------------------- */
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 3px;
    flex-shrink: 0;
  }

  .lang-sep {
    font-size: 10px;
    color: var(--color-panna);
    opacity: 0.25;
    line-height: 1;
    user-select: none;
  }

  .lang-btn {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-panna);
    text-decoration: none;
    opacity: 0.4;
    transition: opacity 0.2s ease;
    padding: 2px 2px;
    line-height: 1;
  }

  .lang-btn:hover { opacity: 0.8; }

  .lang-btn--active {
    opacity: 1;
    border-bottom: 1px solid color-mix(in srgb, var(--color-panna) 60%, transparent);
  }

  /* ---- CTA desktop ----------------------------------------- */
  .nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 6px 16px;
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: var(--color-panna);
    background-color: var(--color-bitter);
    border: 1px solid var(--color-bitter);
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-cta:hover {
    background-color: var(--color-bitter-500);
    border-color: var(--color-bitter-500);
    color: var(--color-panna);
  }

  /* ---- Hamburger ------------------------------------------- */
  .menu-toggle-input { display: none; }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    cursor: pointer;
    padding: 4px;
    flex-shrink: 0;
  }

  .bar {
    display: block;
    width: 100%;
    height: 1px;
    background-color: var(--color-panna);
    transition: transform 0.25s ease, opacity 0.25s ease;
    transform-origin: center;
  }

  /* Hamburger → X animation */
  .menu-toggle-input:checked ~ .header-inner .bar:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .menu-toggle-input:checked ~ .header-inner .bar:nth-child(2) { opacity: 0; }
  .menu-toggle-input:checked ~ .header-inner .bar:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  /* Mobile-only items hidden on desktop */
  .nav-item--cta-mobile  { display: none; }
  .nav-item--lang-mobile { display: none; }

  .nav-cta-mobile {
    display: inline-flex;
    padding: 8px 20px;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: var(--color-panna);
    background-color: var(--color-bitter);
    border-radius: var(--radius-sm);
  }

  .lang-switch-mobile {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: var(--space-sm) 0;
  }

  /* ---- Mobile ≤ 768px ------------------------------------- */
  @media (max-width: 480px) {
    .header-inner { padding: 0 1rem; }
    .nav-list     { padding: var(--space-sm) 1rem; }
  }

  @media (max-width: 768px) {
    .hamburger  { display: flex; }
    .nav-cta    { display: none; }
    .lang-switch { display: none; }

    .site-nav {
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      background-color: var(--color-basilico);
      border-bottom: 0.5px solid var(--color-basilico-600);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }

    .menu-toggle-input:checked ~ .header-inner .site-nav {
      max-height: 400px;
    }

    .nav-list {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: var(--space-sm) 2rem;
    }

    .nav-item {
      width: 100%;
      border-bottom: var(--border-hairline);
    }

    .nav-item:last-child { border-bottom: none; }
    .nav-item--cta-mobile  { display: block; padding: var(--space-sm) 0; }
    .nav-item--lang-mobile { display: block; }

    .nav-link {
      display: block;
      padding: var(--space-sm) 0;
    }

    .lang-switch-mobile .lang-btn {
      font-size: 13px;
      opacity: 0.5;
    }

    .lang-switch-mobile .lang-btn--active {
      opacity: 1;
    }

    .lang-switch-mobile .lang-sep {
      opacity: 0.3;
      font-size: 12px;
    }
  }
</style>
