---
/**
 * Header — navigazione principale MCD
 * Desktop: logo · nav links · CTA "ISCRIVITI"
 * Mobile: hamburger CSS-only, nessun JS
 */

const navLinks = [
  { href: '/festival',  label: 'Festival' },
  { href: '/bars',      label: 'Bars' },
  { href: '/contatti',  label: 'Contatti' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <!-- Checkbox nascosta: gestisce apertura menu mobile via CSS -->
  <input type="checkbox" id="menu-toggle" class="menu-toggle-input" aria-hidden="true" />

  <div class="header-inner">
    <!-- Logo -->
    <a href="/" class="site-logo" aria-label="Milan Cocktail Days — torna alla home">
      <img src="/logos/MCD_Logo_2.svg" alt="Milan Cocktail Days" class="site-logo-img" />
    </a>

    <!-- Hamburger (visibile solo mobile) -->
    <label for="menu-toggle" class="hamburger" aria-label="Apri il menu di navigazione">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </label>

    <!-- Nav principale + CTA -->
    <nav class="site-nav" aria-label="Navigazione principale">
      <ul class="nav-list" role="list">
        {navLinks.map(({ href, label }) => (
          <li class="nav-item">
            <a
              href={href}
              class:list={['nav-link', { 'is-active': currentPath === href || currentPath.startsWith(href + '/') }]}
              aria-current={currentPath === href ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
        <!-- CTA visibile nel menu mobile -->
        <li class="nav-item nav-item--cta-mobile">
          <a href="/contatti" class="nav-cta-mobile">Iscriviti</a>
        </li>
      </ul>
    </nav>

    <!-- CTA bottone desktop -->
    <a href="/contatti" class="nav-cta" aria-label="Iscriviti a Milan Cocktail Days">
      Iscriviti
    </a>
  </div>
</header>

<style>
  /* ---- Header ---------------------------------------------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-basilico);
    border-bottom: 0.5px solid var(--color-basilico-600);
  }

  .header-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
    height: 64px;
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  /* ---- Logo ------------------------------------------------ */
  .site-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    margin-right: auto;
  }

  .site-logo-img {
    height: 300px;
    width: 260px;
    display: block;
    filter: brightness(0) invert(1);
    object-position: center;
    margin-left: 50px;
    margin-right: 50px;
  }

  /* ---- Nav links ------------------------------------------- */
  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    color: var(--color-panna);
    text-decoration: none;
    position: relative;
    padding-bottom: 2px;
    transition: color 0.2s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 0.5px;
    background-color: var(--color-bitter);
    transition: width 0.25s ease;
  }

  .nav-link:hover { color: var(--color-panna); }
  .nav-link:hover::after,
  .nav-link.is-active::after { width: 100%; }
  .nav-link.is-active { color: var(--color-panna); }

  /* ---- CTA desktop ----------------------------------------- */
  .nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 6px 16px;
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: var(--color-panna);
    background-color: var(--color-bitter);
    border: 1px solid var(--color-bitter);
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-cta:hover {
    background-color: var(--color-bitter-500);
    border-color: var(--color-bitter-500);
    color: var(--color-panna);
  }

  /* ---- Hamburger ------------------------------------------- */
  .menu-toggle-input { display: none; }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    cursor: pointer;
    padding: 4px;
    flex-shrink: 0;
  }

  .bar {
    display: block;
    width: 100%;
    height: 1px;
    background-color: var(--color-panna);
    transition: transform 0.25s ease, opacity 0.25s ease;
    transform-origin: center;
  }

  /* Animazione hamburger → X */
  .menu-toggle-input:checked ~ .header-inner .bar:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .menu-toggle-input:checked ~ .header-inner .bar:nth-child(2) { opacity: 0; }
  .menu-toggle-input:checked ~ .header-inner .bar:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  /* CTA mobile nascosto in desktop */
  .nav-item--cta-mobile { display: none; }
  .nav-cta-mobile {
    display: inline-flex;
    padding: 8px 20px;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: var(--color-panna);
    background-color: var(--color-bitter);
    border-radius: var(--radius-sm);
  }

  /* ---- Mobile ≤ 768px ------------------------------------- */
  @media (max-width: 768px) {
    .hamburger { display: flex; }
    .nav-cta   { display: none; }

    .site-nav {
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      background-color: var(--color-basilico);
      border-bottom: 0.5px solid var(--color-basilico-600);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }

    .menu-toggle-input:checked ~ .header-inner .site-nav {
      max-height: 400px;
    }

    .nav-list {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: var(--space-sm) 2rem;
    }

    .nav-item {
      width: 100%;
      border-bottom: var(--border-hairline);
    }

    .nav-item:last-child { border-bottom: none; }
    .nav-item--cta-mobile { display: block; padding: var(--space-sm) 0; }

    .nav-link {
      display: block;
      padding: var(--space-sm) 0;
    }
  }
</style>
