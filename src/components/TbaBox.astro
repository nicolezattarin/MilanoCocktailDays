---
/**
 * TbaBox — box annuncio TBA centrato con mcw-bracket.
 * Sezione con sfondo avorio, usata in bars.astro e programma.astro.
 */
interface Props {
  title: string;
  body: string;
  ctaText: string;
  ctaHref: string;
  ctaClass?: string;
}

const { title, body, ctaText, ctaHref, ctaClass } = Astro.props;
---

<section class="tba-section" aria-labelledby="tba-box-title">
  <div class="wrap">
    <div class="tba-box mcw-bracket">
      <span class="tba-star" aria-hidden="true">✶</span>
      <h2 id="tba-box-title" class="tba-title">{title}</h2>
      <p class="tba-body">{body}</p>
      <a href={ctaHref} class:list={['tba-btn', ctaClass]}>
        {ctaText}
      </a>
    </div>
  </div>
</section>

<style>
  .tba-section {
    background-color: var(--color-panna);
    padding: var(--section-py) 0;
  }

  .wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: center;
  }

  .tba-box {
    max-width: 600px;
    width: 100%;
    padding: var(--space-lg);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .tba-star {
    color: var(--color-basilico);
    font-size: 2rem;
    opacity: 0.6;
  }

  .tba-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h2);
    color: var(--color-basilico);
    line-height: 1.1;
  }

  .tba-body {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-mora);
    line-height: 1.75;
    max-width: 460px;
    margin: 0;
  }

  .tba-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 2rem;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: var(--color-panna);
    background-color: var(--color-bitter);
    border: 1px solid var(--color-bitter);
    border-radius: var(--radius-sm);
    margin-top: var(--space-xs);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .tba-btn:hover {
    background-color: var(--color-bitter-500);
    border-color: var(--color-bitter-500);
    color: var(--color-panna);
  }
</style>
