  .cat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .cat-card {
    position: relative;
    background-color: color-mix(in srgb, var(--color-panna) 5%, var(--color-mora));
    border: 0.5px solid color-mix(in srgb, var(--color-panna) 12%, transparent);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-md) var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    overflow: hidden;
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.35s ease,
      border-color 0.35s ease;
    transition-delay: var(--stagger, 0s);
  }

  .cat-card.is-visible { opacity: 1; transform: none; }

  .cat-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-bitter), var(--color-basilico));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cat-card:hover {
    box-shadow:
      0 24px 64px color-mix(in srgb, var(--color-mora) 70%, transparent),
      0 0 48px color-mix(in srgb, var(--color-bitter) 10%, transparent);
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--color-bitter) 25%, transparent);
  }

  .cat-card.is-visible:hover { transform: translateY(-6px); }

  .cat-card:hover::before { transform: scaleX(1); }

  .cat-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at 60% 0%,
      color-mix(in srgb, var(--color-bitter) 10%, transparent),
      transparent 65%
    );
    opacity: 0;
    transition: opacity 0.45s ease;
    pointer-events: none;
    border-radius: inherit;
  }

  .cat-card:hover .cat-glow { opacity: 1; }

  .cat-icon {
    font-size: 2.25rem;
    line-height: 1;
    margin-bottom: 0.25rem;
    filter: drop-shadow(0 2px 8px color-mix(in srgb, var(--color-bitter) 40%, transparent));
    transition: transform 0.3s ease;
  }

  .cat-card:hover .cat-icon { transform: scale(1.15); }

  .cat-num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: var(--color-bitter);
    opacity: 0.3;
    line-height: 1;
    letter-spacing: -0.03em;
    transition: opacity 0.35s ease;
