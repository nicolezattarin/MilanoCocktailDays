  .app-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
  }

  .app-card {
    background-color: color-mix(in srgb, var(--color-panna) 6%, transparent);
    border: 0.5px solid color-mix(in srgb, var(--color-panna) 15%, transparent);
    border-radius: var(--radius-sm);
    padding: var(--space-md);
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }

  .app-card:hover {
    background-color: color-mix(in srgb, var(--color-panna) 9%, transparent);
    border-color: color-mix(in srgb, var(--color-bitter) 35%, transparent);
  }

  .app-card--wide { grid-column: 1 / -1; }

  .app-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-xs);
  }

  .app-card-icon { font-size: 1.25rem; line-height: 1; }

  .app-card-step {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.5rem;
    color: var(--color-bitter);
    opacity: 0.3;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .app-card:hover .app-card-step { opacity: 0.6; }

  .app-card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-small);
    color: var(--color-panna);
    margin: 0 0 var(--space-xs);
    letter-spacing: 0.02em;
  }

  .app-card-desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-pesco-300);
    line-height: 1.65;
    margin: 0;
    opacity: 0.85;
  }

  /* ── CTA VIDEO ───────────────────────────────────────────── */
  .s-cta-video {
    position: relative;
    padding: clamp(5rem, 12vw, 10rem) 0;
    overflow: hidden;
  }

  .cta-video-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cta-video-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .cta-video-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-mora) 80%, transparent) 0%,
      color-mix(in srgb, var(--color-mora) 40%, transparent) 55%,
      color-mix(in srgb, var(--color-mora) 10%, transparent) 100%
    );
  }

  .cta-video-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    max-width: 560px;
  }

  .cta-star {
    color: var(--color-panna);
    font-size: 1.6rem;
    opacity: 0.5;
  }

  .cta-video-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-panna);
    line-height: 1.05;
    margin: 0;
    text-shadow: 0 2px 16px rgba(0,0,0,0.6);
  }

  .cta-video-sub {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-panna);
    opacity: 0.9;
    line-height: 1.65;
    margin: 0;
    text-shadow: 0 1px 8px rgba(0,0,0,0.5);
  }

  /* ── FORM ────────────────────────────────────────────────── */
  .s-form {
    background-color: var(--color-fumo);
    padding: var(--section-py) 0;
    scroll-margin-top: 64px;
  }

  .form-heading {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
