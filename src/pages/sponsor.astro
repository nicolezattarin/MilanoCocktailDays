---
import BaseLayout from '../layouts/BaseLayout.astro';

const proofRows = [
  { ed: '1ª edizione', bar: '18', part: '600' },
  { ed: '3ª edizione', bar: '45', part: '2.400' },
  { ed: '5ª edizione', bar: '80', part: '6.000' },
];

const categories = [
  {
    cat: 'Beverage',
    n: '01',
    icon: '🍸',
    desc: 'Spirits, soft drink, acque premium, vermouth, liquori. Il contesto perfetto: i partecipanti MCD sono consumatori consapevoli, con alta spesa media.',
    examples: 'Spirits · Soft drink · Acque premium · Vermouth',
  },
  {
    cat: 'Tech',
    n: '02',
    icon: '📱',
    desc: 'App, piattaforme di booking, mobile payment, digital services. Un pubblico 25–40, urban, early adopter, con alta affinità tecnologica.',
    examples: 'App · Booking · Pagamenti · Digital services',
  },
  {
    cat: 'Mobility',
    n: '03',
    icon: '🚗',
    desc: "Trasporto premium, car sharing, servizi di mobilità urbana. Chi frequenta MCD si sposta tra i quartieri ogni sera: un'opportunità unica.",
    examples: 'Car sharing · Taxi premium · Monopattini · Mobilità urbana',
  },
];

const offerings = [
  { val: '1.000+', label: "Partecipanti attesi" },
  { val: 'TBA',    label: 'Bar partner' },
  { val: '10',     label: 'Serate di festival' },
  { val: '25–40',  label: "Fascia d'età principale" },
];

const appFeatures = [
  { step: '01', icon: '🏷️', title: 'Logo in evidenza',     desc: 'Il logo del partner è presente nella home app, nelle schede bar, nelle email agli utenti.', wide: false },
  { step: '02', icon: '🍸', title: 'Prodotti in evidenza', desc: 'I tuoi prodotti possono essere taggati nei cocktail signature dei bar. Ogni scan QR mostra il tuo brand.', wide: false },
  { step: '03', icon: '💬', title: 'Community',            desc: 'Accesso alla sezione community per interazioni dirette con i partecipanti. Post sponsorizzati, challenge, premi.', wide: false },
  { step: '04', icon: '📊', title: 'Report dati',          desc: 'A fine festival: impression, click, interazioni, profilo demografico degli utenti che hanno interagito con il tuo brand.', wide: false },
];

const faqs = [
  { q: 'Quali formati di partnership esistono?',   a: 'Logo in app, prodotti in evidenza nelle schede cocktail, masterclass co-branded, comunicazione social MCD, presenza fisica durante le serate. I pacchetti si definiscono in call.' },
  { q: 'Ci sono esclusive di categoria?',          a: "Sì. Per ogni categoria (beverage, tech, mobility) puntiamo a un solo partner principale. Chi si muove prima ha l'esclusiva di categoria." },
  { q: 'Entro quando chiudere la partnership?',    a: 'Le partnership principali vanno chiuse entro dicembre 2026 per essere integrate in tutta la comunicazione pre-festival.' },
  { q: "Qual è l'investimento minimo?",            a: "Non c'è un listino pubblico. La call serve a capire gli obiettivi del brand e costruire un pacchetto con senso. Parliamone." },
];
---

<BaseLayout
  title="Sponsor"
  description="Diventa sponsor di Milan Cocktail Days 2027. Partnership per brand beverage, tech e mobility. Pubblico premium 25-40, esclusiva di categoria."
>

  <!-- HERO -------------------------------------------------- -->
  <section class="s-hero" aria-labelledby="sponsor-h1">
    <picture class="hero-bg" aria-hidden="true">
      <img
        src="/images/Sunira Moses Unsplash.jpg"
        alt=""
        width="1920" height="1000"
        fetchpriority="high" loading="eager"
      />
    </picture>
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="hero-overline">Sponsor · Partnership Aperte</p>
      <h1 id="sponsor-h1" class="hero-h1">
        Un evento sostenuto<br /><em>da chi conosce</em><br />il settore.
      </h1>
      <p class="hero-sub">
        Beverage, tech, mobility. Un pubblico premium, un contesto curato,
        un'esclusiva di categoria.
      </p>
      <a href="#form" class="btn btn--primary">Parliamone →</a>
    </div>
  </section>

  <!-- STATS BAND -------------------------------------------- -->
  <section class="s-stats" aria-label="Numeri chiave">
    <div class="stats-glow" aria-hidden="true"></div>
    <div class="wrap stats-inner">
      {offerings.map(({ val, label }, i) => (
        <div class="stat-card reveal" style={`--stagger: ${i * 0.1}s`}>
          <span class="stat-val">{val}</span>
          <span class="stat-label">{label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- IL MODELLO -------------------------------------------- -->
  <section class="s-model" aria-labelledby="model-h2">
    <div class="model-bg-img" aria-hidden="true">
      <img src="/images/Egemen Sahin Unsplash (1).jpg" alt="" width="900" height="1200" loading="lazy" />
    </div>
    <div class="model-bg-overlay" aria-hidden="true"></div>
    <div class="wrap model-inner">
      <div class="model-content">
        <div class="model-text reveal">
          <p class="overline--dark">Il modello e i numeri</p>
          <h2 id="model-h2" class="section-h2--dark">
            Un format che funziona.<br />Una città che aspettava.
          </h2>
          <p class="body-text">
            CocktailX Munich ha validato il modello: festival di bar-hopping con
            pass unico, crescita anno su anno, comunità fedele di appassionati.
            Milano è il mercato più maturo d'Italia per la cocktail culture —
            e non aveva ancora un suo evento dedicato.
          </p>
          <p class="body-text">
            MCD è la prima edizione. Chi entra ora co-costruisce il brand
            con noi, con esclusiva di categoria e massima visibilità fin dal lancio.
          </p>
        </div>
        <div class="model-table-side reveal reveal-d1">
          <p class="table-label">CocktailX Munich · crescita per edizione</p>
          <table class="proof-table" aria-label="Crescita CocktailX Munich">
            <thead>
              <tr>
                <th scope="col">Edizione</th>
                <th scope="col">Bar</th>
                <th scope="col">Partecipanti</th>
              </tr>
            </thead>
            <tbody>
              {proofRows.map(({ ed, bar, part }) => (
                <tr>
                  <td>{ed}</td>
                  <td class="num-cell">{bar}</td>
                  <td class="num-cell">{part}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="milan-tag">
            <span class="milan-label">Milano</span>
            <p class="milan-desc">4° mercato cocktail in Europa · crescita YoY +18%</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CATEGORIE DI PARTNERSHIP ----------------------------- -->
  <section class="s-categories" aria-labelledby="cat-h2">
    <div class="wrap">
      <div class="section-header reveal">
        <p class="overline">Categorie di partnership</p>
        <h2 id="cat-h2" class="section-h2">
          Tre categorie.<br />Un solo partner per ognuna.
        </h2>
      </div>
      <div class="cat-grid">
        {categories.map(({ cat, n, icon, desc, examples }, i) => (
          <article class="cat-card" style={`--stagger: ${i * 0.12}s`}>
            <div class="cat-icon" aria-hidden="true">{icon}</div>
            <div class="cat-num" aria-hidden="true">{n}</div>
            <h3 class="cat-title">{cat}</h3>
            <p class="cat-desc">{desc}</p>
            <p class="cat-examples">{examples}</p>
            <div class="cat-glow" aria-hidden="true"></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- L'APP PER I PARTNER ----------------------------------- -->
  <section class="s-app" aria-labelledby="app-h2">
    <div class="wrap app-inner">
      <div class="app-mock" aria-hidden="true">
        <img
          src="/images/Google Pixel 4 Mockup/app_sponsor-portrait.png"
          alt=""
          class="mockup-img"
          loading="lazy"
        />
      </div>
      <div class="app-content">
        <p class="overline--dark reveal">L'app per i partner</p>
        <h2 id="app-h2" class="app-h2 reveal">Il tuo brand<br />dentro l'esperienza.</h2>
        <p class="app-sub reveal reveal-d1">Logo, prodotti, community, dati. Tutto in un unico contesto premium.</p>
        <div class="app-cards reveal reveal-d2">
          {appFeatures.map(({ step, icon, title, desc, wide }) => (
            <div class:list={['app-card', { 'app-card--wide': wide }]}>
              <div class="app-card-header">
                <span class="app-card-icon" aria-hidden="true">{icon}</span>
                <span class="app-card-step" aria-hidden="true">{step}</span>
              </div>
              <h3 class="app-card-title">{title}</h3>
              <p class="app-card-desc">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA VIDEO --------------------------------------------- -->
  <section class="s-cta-video" aria-labelledby="cta-video-h2">
    <picture class="cta-video-bg" aria-hidden="true">
      <img
        src="/images/Iris Yan Unsplash.jpg"
        alt=""
        width="1920" height="1080"
        loading="lazy"
      />
    </picture>
    <div class="cta-video-overlay" aria-hidden="true"></div>
    <div class="wrap cta-video-inner">
      <span class="cta-star" aria-hidden="true">✶</span>
      <h2 id="cta-video-h2" class="cta-video-title reveal">
        Costruiamo<br />qualcosa insieme.
      </h2>
      <p class="cta-video-sub reveal reveal-d1">
        Parliamo degli obiettivi del tuo brand. 30 minuti.
      </p>
      <a href="#form" class="btn btn--primary reveal reveal-d2">Parliamone →</a>
    </div>
  </section>

  <!-- FORM -------------------------------------------------- -->
  <section class="s-form" id="form" aria-labelledby="form-h2">
    <div class="wrap">
      <h2 id="form-h2" class="form-heading reveal">
        Manifestazione d'interesse <span aria-hidden="true">✶</span>
      </h2>
      <p class="form-intro reveal reveal-d1">
        Lascia i tuoi contatti. Il fondatore ti risponde personalmente
        per fissare una conversazione.
      </p>
      <div class="form-placeholder reveal reveal-d2">
        <p class="placeholder-note">
          Il form sponsor è in arrivo. Nel frattempo scrivici direttamente:
          <a href="mailto:sponsor@milancocktaildays.it" class="placeholder-link">
            sponsor@milancocktaildays.it
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ --------------------------------------------------- -->
  <section class="s-faq" aria-labelledby="faq-h2">
    <div class="wrap faq-wrap">
      <div class="faq-header reveal">
        <p class="section-kicker">FAQ</p>
        <h2 id="faq-h2" class="faq-h2">Domande,<br />in due righe.</h2>
      </div>
      <div class="faq-list reveal reveal-d1" id="faq-list">
        {faqs.map(({ q, a }) => (
          <details class="faq-item">
            <summary class="faq-q">
              {q}
              <span class="faq-icon" aria-hidden="true">✶</span>
            </summary>
            <p class="faq-a">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ── All sections: local stacking context ────────────────── */
  section { position: relative; z-index: 0; }

  /* ── Reveal animations ───────────────────────────────────── */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal.is-visible { opacity: 1; transform: none; }
  .reveal-d1 { transition-delay: 0.12s; }
  .reveal-d2 { transition-delay: 0.24s; }
  .reveal-d3 { transition-delay: 0.38s; }

  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .cat-card,
    .stat-card { opacity: 1 !important; transform: none !important; transition: none !important; }
  }

  /* ── Cinematic vignette — top shadow on non-hero sections ── */
  .s-stats::before,
  .s-model::before,
  .s-categories::before,
  .s-app::before,
  .s-cta-video::before,
  .s-form::before,
  .s-faq::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 80px;
    background: linear-gradient(to bottom, rgba(0,0,0,0.18), transparent);
    pointer-events: none;
    z-index: 10;
  }

  /* Hero bottom shadow */
  .s-hero::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 140px;
    background: linear-gradient(to top, rgba(0,0,0,0.55), transparent);
    pointer-events: none;
    z-index: 1;
  }

  /* ── HERO ────────────────────────────────────────────────── */
  .s-hero {
    position: relative;
    min-height: 885px;
    display: flex;
    align-items: center;
    padding: var(--section-py) 0;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-mora) 75%, transparent) 0%,
      color-mix(in srgb, var(--color-mora) 40%, transparent) 55%,
      transparent 100%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: 680px;
    padding: 28px 40px;
    background: color-mix(in srgb, var(--color-mora) 28%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid color-mix(in srgb, var(--color-panna) 14%, transparent);
    border-radius: var(--radius-md);
  }

  .hero-overline {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-panna);
    opacity: 0.65;
    margin: 0;
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.25rem, 5.5vw, 5rem);
    color: var(--color-panna);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .hero-h1 em {
    font-style: italic;
    color: var(--color-bitter);
  }

  .hero-sub {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-pesco-300);
    line-height: 1.55;
    margin: 0;
    max-width: 480px;
  }

  /* ── BUTTON ──────────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.875rem 2rem;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    margin-top: var(--space-sm);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.18s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.2s ease;
  }

  .btn--primary {
    background-color: var(--color-bitter);
    color: var(--color-panna);
    border: 1px solid var(--color-bitter);
  }

  .btn--primary:hover {
    background-color: var(--color-bitter-500);
    border-color: var(--color-bitter-500);
    transform: translateY(-2px);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--color-bitter) 28%, transparent);
  }

  .btn--primary:active { transform: translateY(0); }

  /* ── STATS BAND ──────────────────────────────────────────── */
  .s-stats {
    background-color: var(--color-avorio);
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-mora) 6%, transparent) 1px,
      transparent 1px
    );
    background-size: 28px 28px;
    padding: var(--section-py) 0;
    overflow: hidden;
  }

  .stats-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(ellipse 60% 80% at 80% 50%, color-mix(in srgb, var(--color-bitter) 8%, transparent), transparent),
      radial-gradient(ellipse 50% 70% at 15% 50%, color-mix(in srgb, var(--color-basilico) 6%, transparent), transparent);
  }

  .stats-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .stat-card {
    background-color: var(--color-panna);
    border: 0.5px solid var(--color-panna-300);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-sm) var(--space-md) var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 6px;
    position: relative;
    overflow: hidden;
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.35s ease,
      border-color 0.35s ease;
    transition-delay: var(--stagger, 0s);
  }

  .stat-card.is-visible { opacity: 1; transform: none; }

  .stat-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-bitter), var(--color-basilico));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stat-card:hover {
    box-shadow: 0 16px 40px -8px color-mix(in srgb, var(--color-mora) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-basilico) 25%, transparent);
    transform: translateY(-4px);
  }

  .stat-card.is-visible:hover { transform: translateY(-4px); }

  .stat-card:hover::before { transform: scaleX(1); }

  .stat-val {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--color-mora);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-basilico);
  }

  /* ── MODEL ───────────────────────────────────────────────── */
  .s-model {
    background-color: var(--color-avorio);
    padding: clamp(2.5rem, 5vw, 4rem) 0;
    overflow: hidden;
  }

  .model-bg-img {
    position: absolute;
    inset: 0 0 0 22%;
    z-index: 0;
  }

  .model-bg-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center -1000px;
  }

  .model-bg-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      105deg,
      var(--color-avorio) 36%,
      color-mix(in srgb, var(--color-avorio) 96%, transparent) 44%,
      color-mix(in srgb, var(--color-avorio) 78%, transparent) 54%,
      color-mix(in srgb, var(--color-avorio) 45%, transparent) 66%,
      color-mix(in srgb, var(--color-avorio) 12%, transparent) 82%,
      transparent 100%
    );
  }

  .model-inner {
    position: relative;
    z-index: 2;
  }

  .model-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: start;
    max-width: 85%;
  }

  .model-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .overline--dark {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-basilico);
    margin: 0 0 var(--space-xs);
  }

  .section-h2--dark {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-mora);
    line-height: 1.05;
    margin-bottom: var(--space-sm);
  }

  .body-text {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-inchiostro);
    line-height: 1.8;
    margin: 0 0 var(--space-sm);
  }

  .model-table-side {
    background-color: var(--color-panna);
    border: 0.5px solid var(--color-panna-300);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    box-shadow: 0 8px 32px -8px color-mix(in srgb, var(--color-mora) 10%, transparent);
  }

  .table-label {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-inchiostro-500);
    margin-bottom: var(--space-sm);
  }

  .proof-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
    font-size: var(--text-small);
    margin-bottom: var(--space-md);
  }

  .proof-table thead tr { border-bottom: 1px solid var(--color-basilico); }

  .proof-table th {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 11px;
    color: var(--color-basilico);
    padding: 8px 12px 8px 0;
    text-align: left;
  }

  .proof-table td {
    padding: 10px 20px 10px 0;
    color: var(--color-inchiostro);
    border-bottom: 0.5px solid var(--color-panna-300);
  }

  .num-cell {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-body);
    color: var(--color-mora);
  }

  .milan-tag {
    background-color: var(--color-basilico);
    border-radius: var(--radius-sm);
    padding: var(--space-sm) var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .milan-label {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-panna);
    opacity: 0.7;
  }

  .milan-desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-panna);
    line-height: 1.5;
    margin: 0;
  }

  /* ── CATEGORIE ───────────────────────────────────────────── */
  .s-categories {
    background-color: var(--color-fumo);
    padding: var(--section-py) 0;
  }

  .section-header { margin-bottom: var(--space-lg); }

  .overline {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-panna);
    opacity: 0.65;
    margin: 0 0 var(--space-xs);
  }

  .section-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-panna);
