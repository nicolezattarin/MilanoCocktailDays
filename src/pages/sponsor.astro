  }

  .placeholder-link:hover { opacity: 0.7; }

  /* ── FAQ ─────────────────────────────────────────────────── */
  .s-faq {
    background-color: var(--color-panna);
    padding: clamp(3rem, 6vw, 5rem) 0;
  }

  .faq-wrap {
    display: grid;
    grid-template-columns: 0.6fr 1fr;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: start;
  }

  .faq-header {
    position: sticky;
    top: 5rem;
  }

  .section-kicker {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-basilico);
    margin: 0 0 var(--space-sm);
    display: block;
  }

  .faq-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    color: var(--color-mora);
    line-height: 0.97;
    margin: 0;
    letter-spacing: -0.03em;
  }

  .faq-list { display: flex; flex-direction: column; }

  .faq-item { border-top: 0.5px solid var(--color-panna-300); }
  .faq-item:last-child { border-bottom: 0.5px solid var(--color-panna-300); }

  .faq-q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) 0;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-body);
    color: var(--color-mora);
    list-style: none;
    user-select: none;
