---
import BaseLayout from '../layouts/BaseLayout.astro';

const ospiteSteps = [
  { n: '01', title: 'ACQUISTA IL PASS',      desc: 'I partecipanti acquistano il Pass Festival prima del festival. Tu non fai nulla.' },
  { n: '02', title: 'SCEGLI IL BAR',       desc: 'Tramite app MCD possono visionare i bar disponibili e scegliere dove andare.' },
  { n: '03', title: 'ORDINA E DEGUSTA',      desc: 'Arrivano, mostrano il pass, ordinano il tuo cocktail signature. €6 fisso — tu incassi.' },
];

const benefits = [
  { title: 'Traffico qualificato',    desc: 'Solo appassionati di cocktail, non turisti di passaggio. Il pubblico MCD conosce il drink e sa apprezzarlo.' },
  { title: 'Visibilità',              desc: 'Presenza sull\'app MCD con profilo bar, foto e cocktail. Social media MCD, comunicati stampa, mappa.' },
  { title: 'Credenziale editoriale',  desc: 'Essere nella selezione MCD è un riconoscimento. Un segnale di qualità verso chi frequenta la scena.' },
  { title: 'Analytics visite',        desc: 'Dashboard con dati su visite, conversioni, rating. Capisci chi viene, quando e come ti valutano.' },
];

const requirements = [
  { label: 'Fee di adesione', val: '€0',    sub: 'Partecipare non costa nulla.',          img: '/images/bar_photo1.jpg' },
  { label: 'Prezzo cocktail', val: '€6',    sub: 'Fisso per ogni cocktail signature MCD.',img: '/images/Person Holding Glass Photo.jpg' },
  { label: 'Cocktail MCD',   val: '×1',    sub: "Una ricetta tua, esclusiva per l'evento.", img: '/images/Photo by Mediha Ekici.jpg' },
];

const criteria = [
  'Carta dei drink curata e aggiornata',
  'Bartender professionali, con esperienza',
  'Ambiente adatto a una serata di qualità',
  'Localizzazione in uno dei quartieri selezionati',
  'Disponibilità a creare un cocktail signature dedicato',
  'Capacità operativa di gestire slot di prenotazione',
];

const appFeatures = [
  { title: 'Analytics visite',         desc: 'Dati reali su quanti utenti visitano il tuo profilo, prenotano uno slot, vengono fisicamente nel locale.' },
  { title: 'Recensioni verificate',    desc: 'Solo i partecipanti con pass possono lasciare recensioni. Feedback autentico, non spam.' },
  { title: 'Posizionamento sulla mappa', desc: 'Il tuo bar è in primo piano sulla mappa del festival, con foto, descrizione e link alla prenotazione.' },
  { title: 'Community',                desc: 'Accesso alla sezione community: interagisci con i partecipanti, rispondi alle recensioni, crea contenuti.' },
];

const faqs = [
  { q: 'Quanto costa partecipare?',           a: 'Zero. La partecipazione al festival è gratuita per i bar. L\'unico elemento economico è il prezzo fisso del cocktail signature MCD: €6 al cliente.' },
  { q: 'Quante serate devo coprire?',          a: 'Il minimo è 3 serate su 10. Più serate copri, maggiore è la visibilità. Molti bar scelgono di partecipare a tutte e 10.' },
  { q: 'Devo creare un cocktail nuovo?',       a: 'Sì. Ogni bar crea un cocktail signature esclusivo per MCD. Non deve essere necessariamente innovativo — ma deve essere tuo e fatto bene.' },
  { q: 'Come funzionano le prenotazioni?',     a: 'I partecipanti prenotano via app MCD uno slot nel tuo bar. Ricevi le prenotazioni con 24h di anticipo. Tu decidi quanti slot mettere a disposizione per serata.' },
  { q: 'Chi seleziona i bar?',                 a: 'Il team MCD fa una selezione qualitativa. Non c\'è un numero fisso di bar. Cerchiamo qualità e diversità geografica nei quartieri di Milano.' },
];
---

<BaseLayout
  title="Bar Partner"
  description="Candida il tuo bar a Milan Cocktail Days 2027. €0 fee, €6 fisso, traffico qualificato di appassionati di cocktail. Selezione aperta."
>

  <!-- HERO -------------------------------------------------- -->
  <section class="s-hero" aria-labelledby="bar-h1">
    <picture class="hero-bg" aria-hidden="true">
      <img
        src="/images/Andrea De Santis Photo.jpg"
        alt=""
        width="1920" height="1080"
        fetchpriority="high" loading="eager"
      />
    </picture>
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="hero-overline">Bar Partner · Selezione Aperta</p>
      <h1 id="bar-h1" class="hero-h1">
        Stiamo costruendo<br /><em>la selezione.</em>
      </h1>
      <p class="hero-sub">
        Cerchiamo i migliori cocktail bar di Milano per la prima edizione di MCD.
      </p>
      <a href="#form" class="btn btn--primary">Candida il tuo bar →</a>
    </div>
  </section>

  <!-- COME FUNZIONA PER I TUOI OSPITI ----------------------- -->
  <section class="s-how" aria-labelledby="how-h2">
    <div class="how-bg-img" aria-hidden="true">
      <img src="/images/Louis Hansel Photo.jpg" alt="" width="900" height="1200" loading="lazy" />
    </div>
    <div class="how-bg-overlay" aria-hidden="true"></div>
    <div class="wrap how-inner">
      <div class="how-content">
        <div class="section-header">
          <p class="overline">Come funziona per i tuoi ospiti</p>
          <h2 id="how-h2" class="section-h2">Tre passi.<br />Zero complessità operativa.</h2>
        </div>
        <ol class="step-list" role="list">
          {ospiteSteps.map(({ n, title, desc }) => (
            <li class="step">
              <span class="step-n" aria-hidden="true">{n}</span>
              <div class="step-body">
                <h3 class="step-title">{title}</h3>
                <p class="step-desc">{desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- COSA OTTIENI ------------------------------------------ -->
  <section class="s-benefits" aria-labelledby="benefits-h2">
    <div class="wrap benefits-inner">
      <div class="benefits-lead reveal">
        <p class="overline--dark">Cosa ottieni</p>
        <h2 id="benefits-h2" class="section-h2--dark">
          Valore reale.<br />Nessun rischio.
        </h2>
      </div>
      <div class="benefits-grid">
        {benefits.map(({ title, desc }, i) => (
          <div class="benefit-card reveal" style={`--stagger: ${i * 0.12}s`}>
            <span class="benefit-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="benefit-title">{title}</h3>
            <p class="benefit-desc">{desc}</p>
            <div class="benefit-glow" aria-hidden="true"></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COSA TI CHIEDIAMO ------------------------------------- -->
  <section class="s-req" aria-labelledby="req-h2">
    <div class="wrap req-inner">
      <div class="req-lead">
        <p class="overline">Cosa ti chiediamo</p>
        <h2 id="req-h2" class="section-h2">
          Semplice.<br />Sostenibile.
        </h2>
      </div>
      <div class="req-grid">
        {requirements.map(({ label, val, sub, img }) => (
          <div class="req-item" style={`--req-bg: url('${img}')`}>
            <div class="req-img-overlay" aria-hidden="true"></div>
            <div class="req-content">
              <p class="req-label">{label}</p>
              <p class="req-val">{val}</p>
              <p class="req-sub">{sub}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CHI STIAMO SELEZIONANDO ------------------------------- -->
  <section class="s-criteria" aria-labelledby="criteria-h2">
    <div class="wrap criteria-inner">
      <div class="criteria-text">
        <p class="overline--dark">Chi stiamo selezionando</p>
        <h2 id="criteria-h2" class="section-h2--dark">
          Qualità prima.<br />Tutto il resto viene da sé.
        </h2>
        <p class="body-text">
          Non cerchiamo i bar più famosi di Milano. Cerchiamo quelli che fanno
          le cose bene: drink curati, bartender appassionati, un'atmosfera che vale
          la pena scoprire. Dimensioni e notorietà contano poco.
        </p>
      </div>
      <ul class="criteria-list" role="list">
        {criteria.map((c) => (
          <li class="criteria-item">
            <span class="c-star" aria-hidden="true">✶</span>
            <span>{c}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- L'APP PER IL TUO BAR ---------------------------------- -->
  <section class="s-app" aria-labelledby="app-h2">
    <div class="wrap app-inner">
      <div class="app-content">
        <p class="overline">L'app per il tuo bar</p>
        <h2 id="app-h2" class="section-h2">
          Dati reali.<br />Community attiva.
        </h2>
        <div class="app-features">
          {appFeatures.map(({ title, desc }) => (
            <div class="app-feature">
              <h3 class="app-feature-title">{title}</h3>
              <p class="app-feature-desc">{desc}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="app-mock" aria-hidden="true">
        <div class="phone-frame">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            <div class="phone-header-bar"></div>
            <div class="phone-card-lg"></div>
            <div class="phone-card-row">
              <div class="phone-card-sm"></div>
              <div class="phone-card-sm"></div>
            </div>
            <div class="phone-card-lg phone-card-lg--xs"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA BANNER -------------------------------------------- -->
  <section class="s-cta-video" aria-labelledby="cta-video-h2">
    <video
      class="cta-video-bg"
      aria-hidden="true"
      autoplay
      muted
      loop
      playsinline
    >
      <source src="/images/Video 1920x1080 from Luca Ferrara.mp4" type="video/mp4" />
    </video>
    <div class="cta-video-overlay" aria-hidden="true"></div>
    <div class="wrap cta-video-inner">
      <span class="cta-star" aria-hidden="true">✶</span>
      <h2 id="cta-video-h2" class="cta-video-title">Vuoi far parte<br />della selezione?</h2>
      <p class="cta-video-sub">La candidatura è gratuita e non vincolante.</p>
      <a href="#form" class="cta-video-btn cta-partner">Candida il tuo bar →</a>
    </div>
  </section>

  <!-- FORM CANDIDATURA -------------------------------------- -->
  <section class="s-form" id="form" aria-labelledby="form-h2">
    <div class="wrap">
      <h2 id="form-h2" class="form-heading">
        Candida il tuo bar <span aria-hidden="true">✶</span>
      </h2>
      <p class="form-intro">
        Compila il form. Ti rispondiamo entro 5 giorni lavorativi,
        poi organizziamo una call di 30 minuti per valutare insieme.
      </p>
      <div class="tally-wrap">
        <iframe
          data-tally-src="https://tally.so/embed/vGEKJQ?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1&hideFooter=1"
          loading="lazy"
          width="100%"
          height="564"
          title="Milan Cocktail Days — Candidatura bar partner"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- FAQ --------------------------------------------------- -->
  <section class="s-faq" aria-labelledby="faq-h2">
    <div class="wrap faq-wrap">

      <div class="faq-header reveal">
        <p class="section-kicker">FAQ</p>
        <h2 id="faq-h2" class="faq-h2">Domande<br />frequenti.</h2>
      </div>

      <div class="faq-list reveal reveal-d1" id="faq-list">
        {faqs.map(({ q, a }) => (
          <details class="faq-item">
            <summary class="faq-q">
              {q}
              <span class="faq-icon" aria-hidden="true">✶</span>
            </summary>
            <p class="faq-a">{a}</p>
          </details>
        ))}
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ---- Reveal animations -------------------------------- */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1);
  }
  .reveal.is-visible { opacity: 1; transform: none; }
  .reveal-d1 { transition-delay: 0.12s; }
  .reveal-d2 { transition-delay: 0.24s; }
  .reveal-d3 { transition-delay: 0.38s; }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
  }

  /* ---- HERO (dark) --------------------------------------- */
  .s-hero {
    position: relative;
    min-height: 70svh;
    display: flex;
    align-items: center;
    padding: var(--section-py) 0;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-inchiostro) 45%, transparent) 0%,
      color-mix(in srgb, var(--color-inchiostro) 62%, transparent) 100%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    max-width: 720px;
    padding: 32px 40px;
    background: color-mix(in srgb, var(--color-inchiostro) 30%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid color-mix(in srgb, var(--color-panna) 14%, transparent);
    border-radius: var(--radius-md);
  }

  .hero-overline {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-panna);
    opacity: 0.65;
    margin: 0;
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-hero);
    color: var(--color-panna);
    line-height: 0.92;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .hero-h1 em {
    font-style: italic;
    color: var(--color-bitter);
  }

  .hero-sub {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    color: var(--color-pesco-300);
    line-height: 1.55;
    margin: 0;
    max-width: 480px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 2rem;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    margin-top: var(--space-sm);
    transition: background-color 0.2s ease;
  }

  .btn--primary {
    background-color: var(--color-bitter);
    color: var(--color-panna);
    border: 1px solid var(--color-bitter);
  }

  .btn--primary:hover {
    background-color: var(--color-bitter-500);
    border-color: var(--color-bitter-500);
  }

  .section-header { margin-bottom: var(--space-lg); }

  /* ---- COME FUNZIONA (fumo) ------------------------------ */
  .s-how {
    background-color: var(--color-fumo);
    padding: var(--section-py) 0;
    position: relative;
    overflow: hidden;
  }

  .how-bg-img {
    position: absolute;
    inset: 0 0 0 42%;
    z-index: 0;
  }

  .how-bg-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .how-bg-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      115deg,
      var(--color-fumo) 38%,
      color-mix(in srgb, var(--color-fumo) 72%, transparent) 58%,
      color-mix(in srgb, var(--color-fumo) 20%, transparent) 78%,
      transparent 100%
    );
  }

  .how-inner {
    position: relative;
    z-index: 2;
  }

  .how-content {
    max-width: 52%;
  }

  .overline {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-panna);
    opacity: 0.65;
    margin: 0 0 var(--space-xs);
  }

  .section-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-panna);
    line-height: 1.05;
  }

  .step-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 560px;
  }

  .step {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    position: relative;
    padding-bottom: 5px;
  }

  .step:last-child { padding-bottom: 0; }

  /* dashed connector */
  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 31px;
    top: 64px;
    bottom: 0;
    width: 0;
    border-left: 2px dashed color-mix(in srgb, var(--color-bitter) 38%, transparent);
  }

  .step-n {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-bitter);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.15rem;
    color: var(--color-panna);
    letter-spacing: -0.02em;
    position: relative;
    z-index: 1;
    box-shadow:
      0 0 0 5px color-mix(in srgb, var(--color-bitter) 18%, transparent),
      0 4px 20px color-mix(in srgb, var(--color-bitter) 40%, transparent);
  }

  .step-body { padding-top: 18px; }

  .step-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-body);
    color: var(--color-panna);
    letter-spacing: 0.04em;
    margin-bottom: 4px;
  }

  .step-desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-pesco-300);
    line-height: 1.65;
    margin: 0;
  }

  /* ---- BENEFITS (avorio) --------------------------------- */
  .s-benefits {
    background-color: var(--color-avorio);
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-mora) 7%, transparent) 1px,
      transparent 1px
    );
    background-size: 28px 28px;
    padding: 70px 0;
    position: relative;
    overflow: hidden;
  }

  .s-benefits::before {
    content: '';
    position: absolute;
    top: -30%;
    right: -15%;
    width: 65vw;
    height: 65vw;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-bitter) 10%, transparent) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .s-benefits .wrap { position: relative; z-index: 1; }

  .benefits-inner {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .benefits-lead {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .overline--dark {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-basilico);
    margin: 0 0 var(--space-xs);
  }

  .section-h2--dark {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-mora);
    line-height: 1.05;
    margin-bottom: var(--space-sm);
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-sm);
  }

  .benefit-card {
    position: relative;
    background-color: var(--color-panna);
    border: 0.5px solid var(--color-panna-300);
    border-radius: var(--radius-md);
    padding: var(--space-sm) calc(var(--space-sm) * 1.25);
    overflow: hidden;
    transition:
      transform 0.38s cubic-bezier(0.16,1,0.3,1),
      box-shadow 0.38s cubic-bezier(0.16,1,0.3,1),
      border-color 0.38s ease,
      opacity 0.7s cubic-bezier(0.16,1,0.3,1);
  }

  .benefit-card:not(.is-visible) {
    transition-delay: var(--stagger, 0s);
  }

  .benefit-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 48px -10px color-mix(in srgb, var(--color-mora) 14%, transparent);
    border-color: color-mix(in srgb, var(--color-basilico) 30%, transparent);
  }

  .benefit-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-bitter), var(--color-basilico));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s cubic-bezier(0.16,1,0.3,1);
  }

  .benefit-card:hover::before {
    transform: scaleX(1);
  }

  .benefit-num {
    display: block;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    color: var(--color-bitter);
    opacity: 0.22;
    line-height: 1;
    margin-bottom: var(--space-xs);
    letter-spacing: -0.04em;
    transition: opacity 0.38s ease;
  }

  .benefit-card:hover .benefit-num {
    opacity: 0.5;
  }

  .benefit-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at 60% 0%,
      color-mix(in srgb, var(--color-bitter) 9%, transparent),
      transparent 65%
    );
    opacity: 0;
    transition: opacity 0.45s ease;
    pointer-events: none;
    border-radius: inherit;
  }

  .benefit-card:hover .benefit-glow {
    opacity: 1;
  }

  .benefit-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-body);
    color: var(--color-mora);
    margin-bottom: var(--space-xs);
  }

  .benefit-desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro-500);
    line-height: 1.7;
    margin: 0;
  }

  /* ---- COSA TI CHIEDIAMO (fumo) -------------------------- */
  .s-req {
