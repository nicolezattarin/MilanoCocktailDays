---
import BaseLayout from '../layouts/BaseLayout.astro';

const social = [
  { label: 'Instagram', href: 'https://www.instagram.com/milanococktaildays', handle: '@milanococktaildays' },
  { label: 'LinkedIn',  href: 'https://www.linkedin.com/company/milano-cocktail-days/', handle: 'Milano Cocktail Days' },
  { label: 'Telegram',  href: 'https://t.me/+_D1s5hFIlwwyMjA0', handle: 'Canale ufficiale' },
];
---

<BaseLayout
  title="Grazie per l'iscrizione"
  description="Abbiamo ricevuto la tua iscrizione a Milan Cocktail Days 2027. Ti contatteremo presto."
>
  <section class="s-grazie">
    <div class="wrap">
      <p class="overline">Milan Cocktail Days · 2027</p>
      <h1 class="grazie-h1">Ci siamo.<span aria-hidden="true"> ✶</span></h1>
      <p class="grazie-sub">Abbiamo ricevuto la tua iscrizione. Ti contatteremo noi non appena le vendite saranno aperte.</p>

      <div class="grazie-divider"></div>

      <p class="grazie-label">Nel frattempo, seguici</p>
      <div class="social-list">
        {social.map(({ label, href, handle }) => (
          <a href={href} class="social-item" target="_blank" rel="noopener noreferrer">
            <span class="social-platform">{label}</span>
            <span class="social-handle">{handle}</span>
          </a>
        ))}
      </div>

      <div class="grazie-divider"></div>

      <p class="grazie-label">Contatti</p>
      <a href="mailto:milanococktaildays@gmail.com" class="grazie-email">milanococktaildays@gmail.com</a>

      <a href="/" class="grazie-back">← Torna alla home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .s-grazie {
    background-color: var(--color-panna);
    min-height: 80svh;
    padding: var(--section-py) 0;
    display: flex;
    align-items: center;
  }

  .wrap {
    max-width: 640px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .overline {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-basilico);
    opacity: 0.7;
    margin: 0;
  }

  .grazie-h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-mora);
    line-height: 1.05;
    margin: 0;
  }

  .grazie-sub {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    color: var(--color-inchiostro);
    line-height: 1.6;
    max-width: 520px;
    margin: 0;
  }

  .grazie-divider {
    height: 0.5px;
    background-color: var(--color-panna-300);
    margin: var(--space-sm) 0;
  }

  .grazie-label {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-inchiostro-500);
    margin: 0;
  }

  .social-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .social-item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    padding: 10px 0;
    border-bottom: 0.5px solid var(--color-panna-300);
    transition: opacity 0.2s ease;
  }

  .social-item:last-child { border-bottom: none; }
  .social-item:hover { opacity: 0.65; }

  .social-platform {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-inchiostro-500);
    min-width: 90px;
  }

  .social-handle {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-basilico);
  }

  .grazie-email {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-basilico);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .grazie-email:hover { color: var(--color-basilico-600); }

  .grazie-back {
    margin-top: var(--space-md);
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro-500);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .grazie-back:hover { color: var(--color-mora); }

  @media (max-width: 480px) {
    .wrap { padding: 0 1rem; }
  }
</style>
