---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import TbaBox from '../components/TbaBox.astro';
import CtaBanner from '../components/CtaBanner.astro';

const placeholders = Array.from({ length: 12 }, (_, i) => i + 1);
const quartieri = ['Navigli', 'Brera', 'Isola', 'Porta Romana', 'Centro'];
---

<BaseLayout
  title="I Bar Partner"
  description="I bar partner di Milan Cocktail Days 2027. Navigli, Brera, Isola, Porta Romana. Annuncio ufficiale in arrivo."
>

  <SectionHero
    title="I Bar"
    subtitle="TBA · I bar partner saranno annunciati presto"
    overline="Bar Partner"
  />

  <TbaBox
    title="Bar partner in arrivo"
    body="Stiamo selezionando i migliori bar di Milano per la prima edizione di MCD. Ogni bar creerà un cocktail signature esclusivo per il festival. L'annuncio ufficiale è previsto per i prossimi mesi."
    ctaText="Ricevi l'annuncio →"
    ctaHref="/contatti"
    ctaClass="cta-newsletter"
  />

  <!-- PLACEHOLDER GRID (dark) ----------------------------- -->
  <section class="s-grid" aria-labelledby="grid-h2">
    <div class="wrap">
      <div class="grid-header">
        <h2 id="grid-h2" class="section-h2--light">I Bar Partecipanti</h2>
        <span class="grid-tba" aria-label="Da annunciare">TBA</span>
      </div>

      <div class="bars-grid">
        {placeholders.map((i) => (
          <article class="bar-card">
            <!-- Placeholder 3/2: dimensioni esplicite anti-CLS -->
            <div
              class="bar-img mcw-dot-grid"
              role="img"
              aria-label={`Bar partner MCD ${i} — in arrivo`}
            >
              <span class="bar-star" aria-hidden="true">✶</span>
            </div>
            <div class="bar-info">
              <p class="bar-coming">Coming soon</p>
              <p class="bar-city">Milano</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- QUARTIERI (chiara) ---------------------------------- -->
  <section class="s-quartieri" aria-labelledby="quartieri-h2">
    <div class="wrap">
      <p class="overline">I bar selezionati coprono tutta Milano</p>
      <div
        class="pills"
        role="list"
        aria-label="Quartieri di Milano coinvolti nel festival"
      >
        {quartieri.map((q) => (
          <span class="pill" role="listitem">{q}</span>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner
    title="Vuoi portare il tuo bar a MCD?"
    subtitle="Siamo alla ricerca di cocktail bar di qualità per la prima edizione."
    ctaText="Diventa partner →"
    ctaHref="#form-partner"
    variant="borgogna"
    ctaClass="cta-partner"
  />

  <!-- FORM BAR PARTNER (dark) ------------------------------ -->
  <section class="s-form-partner" id="form-partner" aria-labelledby="form-partner-h2">
    <div class="wrap">
      <h2 id="form-partner-h2" class="form-heading">
        Diventa bar partner <span aria-hidden="true">✶</span>
      </h2>
      <p class="form-intro">
        Compila il form per candidare il tuo bar a Milan Cocktail Days 2027.
        Ti contatteremo per valutare insieme la partnership.
      </p>

      <div class="tally-wrap">
        <iframe
          data-tally-src="https://tally.so/embed/vGEKJQ?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1&hideFooter=1"
          loading="lazy"
          width="100%"
          height="564"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          title="Vuoi far parte dei Milano Cocktail Days con il tuo Cocktail Bar?"
        ></iframe>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-h2--light {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-panna);
    line-height: 1.05;
  }

  /* ---- GRID (dark) -------------------------------------- */
  .s-grid {
    background-color: var(--color-fumo);
    padding: var(--section-py) 0;
  }

  .grid-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .grid-tba {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-panna);
    opacity: 0.5;
  }

  .bars-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .bar-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  /* Placeholder 3/2: dimensioni esplicite anti-CLS */
  .bar-img {
    aspect-ratio: 3 / 2;
    width: 100%;
    background-color: var(--color-marmo);
    border: var(--border-hairline);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .bar-star {
    color: var(--color-panna);
    font-size: 2rem;
    opacity: 0.25;
  }

  .bar-info { padding: var(--space-xs) 0 0; }

  .bar-coming {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-pesco-300);
    margin: 0 0 2px;
    opacity: 0.7;
  }

  .bar-city {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-panna);
    opacity: 0.5;
    margin: 0;
  }

  /* ---- QUARTIERI (avorio) -------------------------------- */
  .s-quartieri {
    background-color: var(--color-avorio);
    padding: var(--section-py) 0;
  }

  .overline {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-basilico);
    margin: 0 0 var(--space-md);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* Pill: bordo Basilico, radius 2px, PJS uppercase */
  .pill {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-basilico);
    border: 0.5px solid var(--color-basilico);
    border-radius: 2px;
    background-color: transparent;
  }

  /* ---- FORM PARTNER (dark) ------------------------------ */
  .s-form-partner {
    background-color: var(--color-fumo);
    padding: var(--section-py) 0;
    scroll-margin-top: 64px;
  }

  .form-heading {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-panna);
    line-height: 1.05;
    margin-bottom: var(--space-sm);
  }

  .form-heading span {
    color: var(--color-panna);
    font-size: 0.5em;
    vertical-align: middle;
    opacity: 0.5;
  }

  .form-intro {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-pesco-300);
    line-height: 1.65;
    max-width: 560px;
    margin: 0 0 var(--space-lg);
    opacity: 0.85;
  }

  .tally-wrap {
    max-width: 760px;
  }

  /* ---- RESPONSIVE --------------------------------------- */
  @media (max-width: 768px) {
    .bars-grid { grid-template-columns: 1fr 1fr; }
    .grid-header { flex-direction: column; gap: var(--space-xs); }
    .tally-tbd { padding: var(--space-md); }
  }

  @media (max-width: 480px) {
    .bars-grid { grid-template-columns: 1fr; }
  }
</style>
