---
import BaseLayout from '../layouts/BaseLayout.astro';

const placeholders = Array.from({ length: 12 }, (_, i) => i + 1);
const quartieri = ['Navigli', 'Brera', 'Isola', 'Porta Romana', 'Centro'];
---

<BaseLayout
  title="I Bar Partner — Milan Cocktail Days"
  description="I bar partner di Milan Cocktail Days 2027. Navigli, Brera, Isola, Porta Romana. Annuncio ufficiale in arrivo."
  pageType="page"
>

  <!-- S01 · HERO ─────────────────────────────────────────────── -->
  <section class="s-hero" aria-labelledby="bars-h1">
    <picture class="hero-bg" aria-hidden="true">
      <img
        src="/images/Timothe Durand Photo from Unsplash.jpg"
        alt=""
        width="1920" height="1080"
        fetchpriority="high" loading="eager"
      />
    </picture>
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="hero-overline">
        Bar Partner <span aria-hidden="true">✶</span> Milano 2027
      </p>
      <div class="hero-h1-wrap mcw-bracket mcw-bracket--dark">
        <h1 id="bars-h1" class="hero-h1">I Bar</h1>
      </div>
      <p class="hero-sub">TBA · I bar partner saranno annunciati presto</p>
    </div>
  </section>

  <!-- S02 · EDITORIALE TBA ───────────────────────────────────── -->
  <section class="s-tba" aria-labelledby="tba-h2">
    <div class="wrap tba-wrap">

      <div class="tba-editorial">
        <p class="section-kicker reveal">In arrivo</p>
        <h2 id="tba-h2" class="tba-h2 reveal reveal-d1">
          Bar partner<br /><em class="tba-em">in arrivo.</em>
        </h2>
        <p class="tba-body reveal reveal-d2">
          Stiamo selezionando i migliori bar di Milano per la prima edizione di MCD.
          Ogni bar creerà un cocktail signature esclusivo per il festival.
          L'annuncio ufficiale è previsto per i prossimi mesi.
        </p>
        <a href="/contatti" class="btn btn--primary cta-newsletter reveal reveal-d3">
          Ricevi l'annuncio <span aria-hidden="true">✶</span>
        </a>
      </div>

      <div class="tba-stats reveal reveal-d2">
        <div class="stat-item">
          <span class="stat-num">30</span>
          <span class="stat-label">Bar selezionati</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-item">
          <span class="stat-num">30</span>
          <span class="stat-label">Cocktail esclusivi</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-item">
          <span class="stat-num">€6</span>
          <span class="stat-label">Ovunque, sempre</span>
        </div>
      </div>

    </div>
  </section>

  <!-- S03 · GRID PLACEHOLDER ─────────────────────────────────── -->
  <section class="s-grid" aria-labelledby="grid-h2">
    <div class="grid-glow" aria-hidden="true"></div>
    <div class="wrap">

      <div class="grid-header reveal">
        <h2 id="grid-h2" class="grid-h2">I Bar Partecipanti</h2>
        <span class="grid-tba-badge">TBA</span>
      </div>

      <div class="bars-grid">
        {placeholders.map((_, i) => (
          <article class="bar-card">
            <div class="bar-img-wrap">
              <img
                src={`/images/${i % 2 === 0 ? 'TBABAR.png' : 'TBABAR 2.png'}`}
                alt={`Bar partner MCD ${i + 1} — in arrivo`}
                class="bar-img"
                loading="lazy"
                width="600" height="400"
              />
              <div class="bar-img-overlay" aria-hidden="true"></div>
            </div>
            <div class="bar-info">
              <p class="bar-coming">Coming soon</p>
              <p class="bar-city">Milano</p>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- S04 · QUARTIERI ────────────────────────────────────────── -->
  <section class="s-quartieri" aria-labelledby="quartieri-h2">
    <div class="wrap quartieri-wrap">

      <div class="quartieri-text">
        <p class="section-kicker reveal">Quartieri</p>
        <h2 id="quartieri-h2" class="quartieri-h2 reveal reveal-d1">
          I bar selezionati<br />coprono tutta Milano.
        </h2>
      </div>

      <div
        class="pills reveal reveal-d2"
        role="list"
        aria-label="Quartieri di Milano coinvolti nel festival"
      >
        {quartieri.map((q) => (
          <span class="pill" role="listitem">{q}</span>
        ))}
      </div>

    </div>
  </section>

  <!-- S05 · CTA PARTNER ──────────────────────────────────────── -->
  <section class="s-cta-partner" aria-labelledby="cta-partner-h2">
    <picture class="cta-partner-bg" aria-hidden="true">
      <img
        src="/images/Carson Masterson Photo.jpg"
        alt=""
        class="cta-partner-bg-img"
        loading="lazy"
        width="1920" height="1080"
      />
    </picture>
    <div class="cta-partner-overlay" aria-hidden="true"></div>
    <div class="wrap cta-partner-inner">
      <p class="section-kicker section-kicker--light reveal">Per i bar</p>
      <h2 id="cta-partner-h2" class="cta-partner-h2 reveal reveal-d1">
        Vuoi portare<br />il tuo bar a MCD?
      </h2>
      <p class="cta-partner-sub reveal reveal-d2">
        Siamo alla ricerca di cocktail bar di qualità per la prima edizione.
      </p>
      <a href="#form-partner" class="btn btn--final cta-partner reveal reveal-d3">
        Diventa partner <span aria-hidden="true">✶</span>
      </a>
    </div>
  </section>

  <!-- S06 · FORM BAR PARTNER ─────────────────────────────────── -->
  <section class="s-form" id="form-partner" aria-labelledby="form-h2">
    <div class="wrap">
      <h2 id="form-h2" class="form-h2 reveal">
        Diventa bar partner <span aria-hidden="true">✶</span>
      </h2>
      <p class="form-intro reveal reveal-d1">
        Compila il form per candidare il tuo bar a Milan Cocktail Days 2027.
        Ti contatteremo per valutare insieme la partnership.
      </p>
      <div class="tally-wrap">
        <iframe
          data-tally-src="https://tally.so/embed/vGEKJQ?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1&hideFooter=1"
          loading="lazy"
          width="100%"
          height="564"
          title="Vuoi far parte dei Milano Cocktail Days con il tuo Cocktail Bar?"
        ></iframe>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ── SECTION KICKER ───────────────────────────────────────── */
  .section-kicker {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-basilico);
    margin: 0 0 var(--space-sm);
    display: block;
  }
  .section-kicker--light {
    color: var(--color-pesco-300);
    opacity: 0.8;
  }

  /* ── SHARED BTN ───────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.875rem 2rem;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.18s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.2s ease;
    margin-top: var(--space-sm);
  }
  .btn--primary {
    background-color: var(--color-bitter);
    color: var(--color-panna);
    border: 1px solid var(--color-bitter);
  }
  .btn--primary:hover {
    background-color: var(--color-bitter-500);
    border-color: var(--color-bitter-500);
    transform: translateY(-2px);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--color-bitter) 24%, transparent);
  }
  .btn--final {
    background-color: var(--color-bitter);
    color: var(--color-panna);
    border: 1px solid var(--color-bitter);
    font-size: var(--text-body);
    padding: 1rem 2.5rem;
    margin-top: 0;
  }
  .btn--final:hover {
    background-color: var(--color-bitter-500);
    border-color: var(--color-bitter-500);
    transform: translateY(-2px);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--color-bitter) 24%, transparent);
  }
  .btn:active { transform: translateY(0); }

  /* ── REVEAL ANIMATION ─────────────────────────────────────── */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal.is-visible { opacity: 1; transform: none; }
  .reveal-d1 { transition-delay: 0.12s; }
  .reveal-d2 { transition-delay: 0.24s; }
  .reveal-d3 { transition-delay: 0.38s; }

  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .bar-card { opacity: 1 !important; transform: none !important; transition: none !important; }
  }

  /* ── VIGNETTE — identica a index.astro ───────────────────── */
  section { position: relative; z-index: 0; }

  /* Hero: bottom darkens toward section below */
  .s-hero::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 120px;
    background: linear-gradient(to top, rgba(0,0,0,0.55), transparent);
    pointer-events: none;
    z-index: 1;
  }

  /* Top shadow on all non-hero sections */
  .s-tba::before,
  .s-grid::before,
  .s-quartieri::before,
  .s-cta-partner::before,
  .s-form::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 80px;
    background: linear-gradient(to bottom, rgba(0,0,0,0.22), transparent);
    pointer-events: none;
    z-index: 2;
  }

  /* Content wrappers above vignette (z:2) */
  .tba-wrap        { position: relative; z-index: 3; }
  .quartieri-wrap  { position: relative; z-index: 3; }
  .cta-partner-inner { position: relative; z-index: 3; }

  /* ── S01 · HERO ───────────────────────────────────────────── */
  .s-hero {
    min-height: 60svh;
    display: flex;
    align-items: center;
    padding: clamp(3rem, 8vw, 6rem) 0;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-mora) 70%, transparent) 0%,
      color-mix(in srgb, var(--color-mora) 35%, transparent) 45%,
      transparent 75%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .hero-overline {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-panna);
    margin: 0;
    opacity: 0.7;
  }

  .hero-h1-wrap {
    padding: var(--space-sm) var(--space-md);
    align-self: flex-start;
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3rem, 9vw, 7rem);
    color: var(--color-panna);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .hero-sub {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    color: var(--color-pesco-300);
    line-height: 1.5;
    margin: 0;
    opacity: 0.8;
  }

  /* ── S02 · TBA EDITORIALE ─────────────────────────────────── */
  .s-tba {
    background-color: var(--color-panna);
    padding: clamp(3rem, 6vw, 5rem) 0;
    overflow: hidden;
  }

  .tba-wrap {
    display: flex;
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
    flex-wrap: wrap;
  }

  .tba-editorial {
    flex: 1;
    min-width: 280px;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .tba-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 4vw, 3.5rem);
    color: var(--color-mora);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .tba-em {
    font-style: italic;
    color: var(--color-bitter);
  }

  .tba-body {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    color: var(--color-inchiostro-500);
    line-height: 1.7;
    margin: 0;
    max-width: 480px;
  }

  .tba-stats {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-left: 0.5px solid var(--color-panna-300);
    padding-left: clamp(2rem, 4vw, 4rem);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: var(--space-sm) 0;
  }

  .stat-divider {
    height: 0.5px;
    background: var(--color-panna-300);
  }

  .stat-num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--color-bitter);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-inchiostro-500);
  }

  /* ── S03 · GRID ───────────────────────────────────────────── */
  .s-grid {
    background-color: var(--color-mora);
    padding: clamp(3rem, 6vw, 5rem) 0;
    overflow: hidden;
  }

  .grid-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 55% 45% at 90% 10%, color-mix(in srgb, var(--color-bitter) 8%, transparent), transparent),
      radial-gradient(ellipse 40% 55% at 5% 90%, color-mix(in srgb, var(--color-basilico) 16%, transparent), transparent);
  }

  .s-grid .wrap { position: relative; z-index: 3; }

  .grid-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    flex-wrap: wrap;
  }

  .grid-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.8rem, 3.5vw, 2.75rem);
    color: var(--color-panna);
    line-height: 1.05;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .grid-tba-badge {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-panna);
    opacity: 0.45;
  }

  .bars-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .bar-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bar-card.is-visible { opacity: 1; transform: none; }

  .bar-img-wrap {
    position: relative;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 0.5px solid color-mix(in srgb, var(--color-panna) 10%, transparent);
    transition: border-color 0.25s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bar-card:hover .bar-img-wrap {
    border-color: color-mix(in srgb, var(--color-bitter) 30%, transparent);
    transform: translateY(-3px);
  }

  .bar-img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bar-card:hover .bar-img { transform: scale(1.04); }

  .bar-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.35), transparent 60%);
  }

  .bar-info { padding: var(--space-xs) 0 0; }

  .bar-coming {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-pesco-300);
    margin: 0 0 2px;
    opacity: 0.65;
  }

  .bar-city {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-panna);
    opacity: 0.45;
    margin: 0;
  }

  /* ── S04 · QUARTIERI ──────────────────────────────────────── */
  .s-quartieri {
    background-color: var(--color-panna);
    padding: clamp(3rem, 6vw, 5rem) 0;
    overflow: hidden;
  }

  .quartieri-wrap {
    display: flex;
    align-items: flex-end;
    gap: clamp(3rem, 7vw, 6rem);
    flex-wrap: wrap;
  }

  .quartieri-text { flex: 1; min-width: 240px; }

  .quartieri-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.8rem, 3.5vw, 2.75rem);
    color: var(--color-mora);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    flex: 1;
    min-width: 240px;
    align-self: center;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-basilico);
    border: 0.5px solid var(--color-basilico);
    border-radius: 2px;
    background-color: transparent;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .pill:hover {
    background-color: var(--color-basilico);
    color: var(--color-panna);
  }

  /* ── S05 · CTA PARTNER ────────────────────────────────────── */
  .s-cta-partner {
    position: relative;
    overflow: hidden;
    min-height: clamp(380px, 55vh, 600px);
    display: flex;
    align-items: center;
    padding: clamp(4rem, 8vw, 7rem) 0;
  }

  .cta-partner-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cta-partner-bg-img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
  }

  .cta-partner-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-mora) 55%, transparent) 0%,
      color-mix(in srgb, var(--color-mora) 25%, transparent) 55%,
      transparent 85%
    );
  }

  .cta-partner-inner {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .cta-partner-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.5rem, 6vw, 5rem);
    color: var(--color-panna);
    line-height: 0.97;
    letter-spacing: -0.025em;
    margin: 0;
  }

  .cta-partner-sub {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    color: var(--color-pesco-300);
    line-height: 1.6;
    margin: 0;
    max-width: 440px;
    opacity: 0.85;
  }

  /* ── S06 · FORM ───────────────────────────────────────────── */
  .s-form {
    background-color: var(--color-mora);
    padding: clamp(3rem, 6vw, 5rem) 0;
    scroll-margin-top: 64px;
    overflow: hidden;
  }

  .s-form .wrap { position: relative; z-index: 3; }

  .form-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-panna);
    line-height: 1.05;
    margin: 0 0 var(--space-sm);
  }

  .form-h2 span {
    font-size: 0.5em;
    vertical-align: middle;
    opacity: 0.5;
  }

  .form-intro {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-pesco-300);
    line-height: 1.65;
    max-width: 560px;
    margin: 0 0 var(--space-lg);
    opacity: 0.85;
  }

  .tally-wrap { max-width: 760px; }

  /* ── RESPONSIVE ───────────────────────────────────────────── */
  @media (max-width: 900px) {
    .tba-wrap       { flex-direction: column; }
    .tba-stats      { border-left: none; border-top: 0.5px solid var(--color-panna-300); padding-left: 0; padding-top: var(--space-md); flex-direction: row; flex-wrap: wrap; gap: var(--space-md); }
    .stat-divider   { display: none; }
    .quartieri-wrap { flex-direction: column; align-items: flex-start; }
    .bars-grid      { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 768px) {
    .bars-grid  { grid-template-columns: repeat(2, 1fr); }
    .grid-header { flex-direction: column; gap: var(--space-xs); }
  }

  @media (max-width: 480px) {
    .bars-grid { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  function makeVisible(el: Element) { el.classList.add('is-visible'); }

  requestAnimationFrame(() => {
    // Universal .reveal
    const revealEls = document.querySelectorAll('.reveal');
    if (revealEls.length) {
      const obs = new IntersectionObserver(
        entries => entries.forEach(e => { if (e.isIntersecting) { makeVisible(e.target); obs.unobserve(e.target); } }),
        { threshold: 0.05 }
      );
      revealEls.forEach(el => obs.observe(el));
    }

    // Bar cards: staggered reveal
    const barCards = document.querySelectorAll('.bar-card');
    if (barCards.length) {
      const io = new IntersectionObserver(
        entries => entries.forEach(e => {
          if (e.isIntersecting) {
            const card = e.target as HTMLElement;
            const idx = Array.from(barCards).indexOf(card);
            setTimeout(() => makeVisible(card), (idx % 4) * 80);
            io.unobserve(card);
          }
        }),
        { threshold: 0.05 }
      );
      barCards.forEach(c => io.observe(c));
    }

    // Safety fallback: show any still-hidden after 2.5s
    setTimeout(() => {
      document.querySelectorAll('.reveal:not(.is-visible), .bar-card:not(.is-visible)').forEach(makeVisible);
    }, 2500);
  });

  // Hero parallax — reduced-motion safe
  const heroBgImg = document.querySelector<HTMLImageElement>('.hero-bg img');
  if (heroBgImg && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    window.addEventListener('scroll', () => {
      heroBgImg.style.transform = `translateY(${window.scrollY * 0.22}px)`;
    }, { passive: true });
  }
</script>
