  .app-card--wide { grid-column: 1 / -1; }
  .app-card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-xs); }
  .app-card-icon { font-size: 1.25rem; line-height: 1; }
  .app-card-step { font-family: var(--font-display); font-weight: 900; font-size: 1.5rem; color: var(--color-bitter); opacity: 0.3; line-height: 1; letter-spacing: -0.04em; }
  .app-card:hover .app-card-step { opacity: 0.6; }
  .app-card-title { font-family: var(--font-display); font-weight: 700; font-size: var(--text-small); color: var(--color-panna); margin: 0 0 var(--space-xs); letter-spacing: 0.02em; }
  .app-card-desc { font-family: var(--font-body); font-size: var(--text-small); color: var(--color-pesco-300); line-height: 1.65; margin: 0; opacity: 0.85; }

  /* CTA VIDEO */
  .s-cta-video { position: relative; padding: clamp(5rem, 12vw, 10rem) 0; overflow: hidden; }
