</style>

<script>
  document.querySelectorAll('.faq-item').forEach(detail => {
    detail.addEventListener('toggle', () => {
      if ((detail as HTMLDetailsElement).open) {
        document.querySelectorAll('.faq-item').forEach(other => {
          if (other !== detail) (other as HTMLDetailsElement).open = false;
        });
      }
    });
  });

  function makeVisible(el: Element) { el.classList.add('is-visible'); }

  requestAnimationFrame(() => {
    const statsGrid = document.querySelector('.stats-inner');
    if (statsGrid) {
      const statCards = statsGrid.querySelectorAll('.stat-card');
      const statsObs = new IntersectionObserver(
        entries => { if (entries[0].isIntersecting) { statCards.forEach(makeVisible); statsObs.disconnect(); } },
        { threshold: 0.1 }
      );
      statsObs.observe(statsGrid);
    }

    const catGrid = document.querySelector('.cat-grid');
    if (catGrid) {
      const catCards = catGrid.querySelectorAll('.cat-card');
      const catObs = new IntersectionObserver(
        entries => { if (entries[0].isIntersecting) { catCards.forEach(makeVisible); catObs.disconnect(); } },
        { threshold: 0.08 }
      );
      catObs.observe(catGrid);
    }

    const revealEls = document.querySelectorAll('.reveal');
    if (revealEls.length) {
      const revealObs = new IntersectionObserver(
        entries => entries.forEach(e => { if (e.isIntersecting) { makeVisible(e.target); revealObs.unobserve(e.target); } }),
        { threshold: 0.05 }
      );
      revealEls.forEach(el => revealObs.observe(el));
      setTimeout(() => {
        document.querySelectorAll('.reveal:not(.is-visible), .stat-card:not(.is-visible), .cat-card:not(.is-visible)').forEach(makeVisible);
      }, 2500);
    }
  });

  const heroBgImg = document.querySelector<HTMLImageElement>('.s-hero .hero-bg img');
  if (heroBgImg && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    window.addEventListener('scroll', () => {
      heroBgImg.style.transform = `translateY(${window.scrollY * 0.2}px)`;
    }, { passive: true });
  }
</script>
