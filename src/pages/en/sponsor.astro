---
import BaseLayout from '../../layouts/BaseLayout.astro';

const proofRows = [
  { ed: '1st edition', bar: '18', part: '600' },
  { ed: '3rd edition', bar: '45', part: '2,400' },
  { ed: '5th edition', bar: '80', part: '6,000' },
];

const categories = [
  {
    cat: 'Beverage',
    n: '01',
    icon: '🍸',
    desc: "Put your brand in front of the right audience, at the heart of Milan's cocktail culture: engaged, on-target consumers.",
    examples: 'Spirits · Soft drinks · Premium water · Vermouth',
  },
  {
    cat: 'Tech',
    n: '02',
    icon: '📱',
    desc: 'Integrate your services into an ecosystem of users aged 25–40: urban, early-adopter, high tech affinity.',
    examples: 'Apps · Booking · Payments · Digital services',
  },
  {
    cat: 'Mobility',
    n: '03',
    icon: '🚗',
    desc: 'Premium transport, car sharing, urban mobility services. MCD guests move between quartieri every evening — a unique opportunity.',
    examples: 'Car sharing · Premium taxi · E-scooters · Urban mobility',
  },
];

const offerings = [
  { val: '1,000+', label: 'Expected attendees' },
  { val: 'TBA',    label: 'Partner bars' },
  { val: '10',     label: 'Festival evenings' },
  { val: '25–40',  label: 'Primary age range' },
];

const appFeatures = [
  { step: '01', icon: '🔗', title: 'Tracked links',     desc: 'On every product used in partner bar recipes. Full interaction tracking.', wide: false },
  { step: '02', icon: '📋', title: 'Surveys',            desc: 'Measure awareness and consumption preferences directly among attendees.', wide: false },
  { step: '03', icon: '📊', title: 'Data collection',    desc: 'Real consumption and traffic data from festival evenings. Anonymised and structured.', wide: false },
  { step: '04', icon: '📱', title: 'In-app placement',   desc: 'Strategic positioning for direct activation on your products and services.', wide: false },
];

const faqs = [
  { q: 'What partnership formats are available?',     a: 'Logo in-app, product placement on cocktail pages, co-branded masterclasses, MCD social coverage, physical presence during evenings. Packages are defined on a call.' },
  { q: 'Is there category exclusivity?',              a: 'Yes. For each category (beverage, tech, mobility), we aim for one principal partner. First in gets the category exclusive.' },
  { q: 'What is the deadline to close a partnership?', a: 'Principal partnerships need to close by December 2026 to be integrated across all pre-festival communications.' },
  { q: "What's the minimum investment?",              a: "There's no public rate card. The call is where we understand your brand's goals and build a package that makes sense. Let's talk." },
];
---

<BaseLayout
  title="Sponsor"
  description="Become a sponsor of Milan Cocktail Days 2027. Partnerships for beverage, tech, and mobility brands. Premium audience 25–40, category exclusivity."
>

  <!-- HERO -->
  <section class="s-hero" aria-labelledby="sponsor-h1">
    <picture class="hero-bg" aria-hidden="true">
      <img
        src="/images/Sunira Moses Unsplash.jpg"
        alt=""
        width="1920" height="1000"
        fetchpriority="high" loading="eager"
      />
    </picture>
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="hero-overline">Sponsor · Partnerships Open</p>
      <h1 id="sponsor-h1" class="hero-h1">
        Thirty Milan bars.<br /><em>Ten days</em><br />of cocktails.
      </h1>
      <p class="hero-sub">
        Beverage, tech, and mobility meet in Milan.
        We offer partners a premium audience, a curated environment, and category exclusivity.
      </p>
      <a href="#form" class="btn btn--primary">Let's talk →</a>
    </div>
  </section>

  <!-- STATS BAND -->
  <section class="s-stats" aria-label="Key numbers">
    <div class="stats-glow" aria-hidden="true"></div>
    <div class="wrap stats-inner">
      {offerings.map(({ val, label }, i) => (
        <div class="stat-card reveal" style={`--stagger: ${i * 0.1}s`}>
          <span class="stat-val">{val}</span>
          <span class="stat-label">{label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- THE MODEL -->
  <section class="s-model" aria-labelledby="model-h2">
    <div class="model-inner">
      <div class="model-content">
        <div class="model-text reveal">
          <p class="overline--dark">The model and the numbers</p>
          <h2 id="model-h2" class="section-h2--dark">
            A proven format.<br />Finally in Milan.
          </h2>
          <p class="body-text">
            CocktailX Munich validated the model: a bar-hopping festival with a single pass,
            year-on-year growth, a loyal community of enthusiasts.
          </p>
          <div class="model-points">
            <p class="body-text"><strong>The Model:</strong> A proven, successful format — a bar-hopping festival with a single pass, growing year on year with a loyal community of enthusiasts.</p>
            <p class="body-text"><strong>The Paradox:</strong> Milan has Italy's most advanced cocktail culture, and no festival to match it. Until now.</p>
            <p class="body-text"><strong>The Opportunity:</strong> The first edition is where the foundation gets built. Getting in now means showing Milan this event was always going to happen.</p>
          </div>
        </div>
        <div class="model-visual reveal reveal-d1">
          <picture class="model-picture">
            <img
              src="/images/Egemen Sahin Unsplash (1).jpg"
              alt="bartender preparing a signature cocktail at a selected Milan bar"
              width="900" height="1200"
              loading="lazy"
              class="model-picture-img"
            />
          </picture>
          <div class="model-table-side">
            <p class="table-label">CocktailX Munich · growth by edition</p>
            <table class="proof-table" aria-label="CocktailX Munich growth">
              <thead>
                <tr>
                  <th scope="col">Edition</th>
                  <th scope="col">Bars</th>
                  <th scope="col">Attendees</th>
                </tr>
              </thead>
              <tbody>
                {proofRows.map(({ ed, bar, part }) => (
                  <tr>
                    <td>{ed}</td>
                    <td class="num-cell">{bar}</td>
                    <td class="num-cell">{part}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <div class="milan-tag">
              <span class="milan-label">Milano</span>
              <p class="milan-desc">4th cocktail market in Europe · YoY growth +18%</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PARTNERSHIP CATEGORIES -->
  <section class="s-categories" aria-labelledby="cat-h2">
    <div class="wrap">
      <div class="section-header reveal">
        <p class="overline">Partnership categories</p>
        <h2 id="cat-h2" class="section-h2">
          Three categories.<br />One complete experience.
        </h2>
      </div>
      <div class="cat-grid">
        {categories.map(({ cat, n, icon, desc, examples }, i) => (
          <article class="cat-card" style={`--stagger: ${i * 0.12}s`}>
            <div class="cat-icon" aria-hidden="true">{icon}</div>
            <div class="cat-num" aria-hidden="true">{n}</div>
            <h3 class="cat-title">{cat}</h3>
            <p class="cat-desc">{desc}</p>
            <p class="cat-examples">{examples}</p>
            <div class="cat-glow" aria-hidden="true"></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SPONSORSHIP OPPORTUNITIES -->
  <section class="s-opp" aria-labelledby="opp-h2">
    <div class="wrap">
      <div class="section-header reveal">
        <p class="overline opp-overline">Sponsorship opportunities</p>
        <h2 id="opp-h2" class="section-h2 opp-h2">
          More than a logo<br />and impressions.
        </h2>
      </div>
      <div class="opp-grid">
        <article class="opp-card reveal" style="--stagger: 0s">
          <div class="opp-img-wrap">
            <img src="/images/drink_hand_1.jpg" alt="cocktail with sponsor product at Milano Cocktail Days" width="692" height="864" loading="lazy" class="opp-img" />
          </div>
          <div class="opp-body">
            <h3 class="opp-title">Your products in the recipes</h3>
            <p class="opp-desc">Your products go into the signature cocktail recipes of partner bars. Real presence — not just visual.</p>
          </div>
        </article>
        <article class="opp-card reveal" style="--stagger: 0.12s">
          <div class="opp-img-wrap">
            <img src="/images/app_sponsor.png" alt="Milano Cocktail Days app — sponsor visibility section" width="780" height="1800" loading="lazy" class="opp-img" />
          </div>
          <div class="opp-body">
            <h3 class="opp-title">Direct engagement</h3>
            <p class="opp-desc">Your brand is present in the app. Access reviews and real-time engagement data.</p>
          </div>
        </article>
        <article class="opp-card reveal" style="--stagger: 0.24s">
          <div class="opp-img-wrap">
            <img src="/images/bar_people_1.jpg" alt="people at a cocktail bar during Milano Cocktail Days 2027" width="1295" height="864" loading="lazy" class="opp-img" />
          </div>
          <div class="opp-body">
            <h3 class="opp-title">Unique consumption data</h3>
            <p class="opp-desc">Real data on consumption and audience preferences. Collected during the festival, anonymised and structured.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- THE PARTNER APP -->
  <section class="s-app" aria-labelledby="app-h2">
    <div class="wrap app-inner">
      <div class="app-mock" aria-hidden="true">
        <img
          src="/images/Google Pixel 4 Mockup/app_sponsor-portrait.png"
          alt=""
          width="1280" height="2680"
          class="mockup-img"
          loading="lazy"
        />
      </div>
      <div class="app-content">
        <p class="overline--dark reveal">The partner app</p>
        <h2 id="app-h2" class="app-h2 reveal">Real data.<br />Measurable value.</h2>
        <p class="app-sub reveal reveal-d1">An offline event powered by technology. We capture meaningful data and activate attendees directly.</p>
        <div class="app-cards reveal reveal-d2">
          {appFeatures.map(({ step, icon, title, desc, wide }) => (
            <div class:list={['app-card', { 'app-card--wide': wide }]}>
              <div class="app-card-header">
                <span class="app-card-icon" aria-hidden="true">{icon}</span>
                <span class="app-card-step" aria-hidden="true">{step}</span>
              </div>
              <h3 class="app-card-title">{title}</h3>
              <p class="app-card-desc">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="s-cta-video" aria-labelledby="cta-video-h2">
    <picture class="cta-video-bg" aria-hidden="true">
      <img src="/images/Iris Yan Unsplash.jpg" alt="" width="1920" height="1080" loading="lazy" />
    </picture>
    <div class="cta-video-overlay" aria-hidden="true"></div>
    <div class="wrap cta-video-inner">
      <span class="cta-star" aria-hidden="true">✶</span>
      <h2 id="cta-video-h2" class="cta-video-title reveal">
        Let's build<br />something together.
      </h2>
      <p class="cta-video-sub reveal reveal-d1">
        Tell us about your brand's goals. 30 minutes.
      </p>
      <a href="#form" class="btn btn--primary reveal reveal-d2">Let's talk →</a>
    </div>
  </section>

  <!-- FORM -->
  <section class="s-form" id="form" aria-labelledby="form-h2">
    <div class="wrap">
      <h2 id="form-h2" class="form-heading reveal">
        Expression of interest <span aria-hidden="true">✶</span>
      </h2>
      <p class="form-intro reveal reveal-d1">
        Leave your details. The founder will reply personally to set up a call.
      </p>
      <div class="tally-wrap reveal reveal-d2">
        <iframe
          data-tally-src="https://tally.so/embed/0QDV99?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
          loading="lazy"
          width="100%"
          height="949"
          title="Sponsor Milan Cocktail Days"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="s-faq" aria-labelledby="faq-h2">
    <div class="wrap faq-wrap">
      <div class="faq-header reveal">
        <p class="section-kicker">FAQ</p>
        <h2 id="faq-h2" class="faq-h2">Questions.<br />Two lines each.</h2>
      </div>
      <div class="faq-list reveal reveal-d1" id="faq-list">
        {faqs.map(({ q, a }) => (
          <details class="faq-item">
            <summary class="faq-q">
              {q}
              <span class="faq-icon" aria-hidden="true">✶</span>
            </summary>
            <p class="faq-a">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .wrap { max-width: var(--container); margin: 0 auto; padding: 0 2rem; }
  section { position: relative; z-index: 0; }

  .reveal { opacity: 0; transform: translateY(20px); transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  .reveal.is-visible { opacity: 1; transform: none; }
  .reveal-d1 { transition-delay: 0.12s; }
  .reveal-d2 { transition-delay: 0.24s; }
  .reveal-d3 { transition-delay: 0.38s; }

  @media (prefers-reduced-motion: reduce) {
    .reveal, .cat-card, .stat-card { opacity: 1 !important; transform: none !important; transition: none !important; }
  }

  .s-stats::before, .s-model::before, .s-categories::before, .s-app::before, .s-cta-video::before, .s-form::before, .s-faq::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 80px;
    background: linear-gradient(to bottom, rgba(0,0,0,0.18), transparent); pointer-events: none; z-index: 10;
  }

  .s-hero::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 140px; background: linear-gradient(to top, rgba(0,0,0,0.55), transparent); pointer-events: none; z-index: 1; }

  /* HERO */
  .s-hero { position: relative; min-height: 885px; display: flex; align-items: center; padding: var(--section-py) 0; overflow: hidden; background-color: var(--color-mora); }
  .hero-bg { position: absolute; inset: 0; z-index: 0; }
  .hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .hero-overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(to right, color-mix(in srgb, var(--color-mora) 75%, transparent) 0%, color-mix(in srgb, var(--color-mora) 40%, transparent) 55%, transparent 100%); }
  .hero-inner { position: relative; z-index: 3; display: flex; flex-direction: column; align-items: flex-start; gap: 0.75rem; max-width: 680px; padding: 28px 40px; background: color-mix(in srgb, var(--color-mora) 28%, transparent); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid color-mix(in srgb, var(--color-panna) 14%, transparent); border-radius: var(--radius-md); }
  .hero-overline { font-family: var(--font-body); font-size: var(--text-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.22em; color: var(--color-panna); opacity: 0.65; margin: 0; }
  .hero-h1 { font-family: var(--font-display); font-weight: 900; font-size: clamp(2.25rem, 5.5vw, 5rem); color: var(--color-panna); line-height: 0.95; letter-spacing: -0.02em; margin: 0; }
  .hero-h1 em { font-style: italic; color: var(--color-bitter); }
  .hero-sub { font-family: var(--font-body); font-size: 1rem; color: var(--color-pesco-300); line-height: 1.55; margin: 0; max-width: 480px; }

  /* BUTTON */
  .btn { display: inline-flex; align-items: center; gap: 0.4em; padding: 0.875rem 2rem; font-family: var(--font-body); font-size: var(--text-small); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; text-decoration: none; border-radius: var(--radius-sm); margin-top: var(--space-sm); transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease; }
  .btn--primary { background-color: var(--color-bitter); color: var(--color-panna); border: 1px solid var(--color-bitter); }
  .btn--primary:hover { background-color: var(--color-bitter-500); border-color: var(--color-bitter-500); transform: translateY(-2px); box-shadow: 0 8px 22px color-mix(in srgb, var(--color-bitter) 28%, transparent); }
  .btn--primary:active { transform: translateY(0); }

  /* STATS */
  .s-stats { background-color: var(--color-avorio); background-image: radial-gradient(circle, color-mix(in srgb, var(--color-mora) 6%, transparent) 1px, transparent 1px); background-size: 28px 28px; padding: var(--section-py) 0; overflow: hidden; }
  .stats-glow { position: absolute; inset: 0; pointer-events: none; z-index: 0; background: radial-gradient(ellipse 60% 80% at 80% 50%, color-mix(in srgb, var(--color-bitter) 8%, transparent), transparent), radial-gradient(ellipse 50% 70% at 15% 50%, color-mix(in srgb, var(--color-basilico) 6%, transparent), transparent); }
  .stats-inner { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-md); }
  .stat-card { background-color: var(--color-panna); border: 0.5px solid var(--color-panna-300); border-radius: var(--radius-md); padding: var(--space-md) var(--space-sm) var(--space-md) var(--space-md); display: flex; flex-direction: column; gap: 6px; position: relative; overflow: hidden; opacity: 0; transform: translateY(20px); transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease, border-color 0.35s ease; transition-delay: var(--stagger, 0s); }
  .stat-card.is-visible { opacity: 1; transform: none; }
  .stat-card::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 2px; background: linear-gradient(90deg, var(--color-bitter), var(--color-basilico)); transform: scaleX(0); transform-origin: left; transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1); }
  .stat-card:hover { box-shadow: 0 16px 40px -8px color-mix(in srgb, var(--color-mora) 12%, transparent); border-color: color-mix(in srgb, var(--color-basilico) 25%, transparent); transform: translateY(-4px); }
  .stat-card.is-visible:hover { transform: translateY(-4px); }
  .stat-card:hover::before { transform: scaleX(1); }
  .stat-val { font-family: var(--font-display); font-weight: 900; font-size: clamp(2rem, 4vw, 3rem); color: var(--color-mora); line-height: 1; letter-spacing: -0.02em; }
  .stat-label { font-family: var(--font-body); font-size: var(--text-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-basilico); }

  /* MODEL */
  .s-model { background-color: var(--color-avorio); overflow: hidden; }
  .model-inner { position: relative; }
  .model-content { display: grid; grid-template-columns: 1fr 1fr; align-items: stretch; height: clamp(480px, 60vw, 650px); }
  .model-text { padding: clamp(1.5rem, 4vw, 3.5rem) clamp(1rem, 3vw, 2.5rem); display: flex; flex-direction: column; gap: var(--space-xs); justify-content: center; overflow-y: auto; min-width: 0; }
  .model-visual { position: relative; overflow: hidden; min-height: 0; }
  .model-picture { display: block; width: 100%; height: 100%; }
  .model-picture-img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
  .model-visual .model-table-side { position: absolute; top: var(--space-md); left: var(--space-md); right: var(--space-md); z-index: 2; backdrop-filter: blur(8px); background: color-mix(in srgb, var(--color-panna) 90%, transparent); border-radius: var(--radius-md); }
  .overline--dark { font-family: var(--font-body); font-size: var(--text-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.18em; color: var(--color-basilico); margin: 0 0 var(--space-xs); }
  .section-h2--dark { font-family: var(--font-display); font-weight: 900; font-size: var(--text-h1); color: var(--color-mora); line-height: 1.05; margin-bottom: var(--space-sm); }
  .body-text { font-family: var(--font-body); font-size: var(--text-body); color: var(--color-inchiostro); line-height: 1.8; margin: 0 0 var(--space-sm); }
  .model-points { display: flex; flex-direction: column; gap: 8px; }
  .model-points .body-text { margin: 0; }
  .model-table-side { background-color: var(--color-panna); border: 0.5px solid var(--color-panna-300); border-radius: var(--radius-md); padding: var(--space-md); box-shadow: 0 8px 32px -8px color-mix(in srgb, var(--color-mora) 10%, transparent); }
  .table-label { font-family: var(--font-body); font-size: var(--text-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-inchiostro-500); margin-bottom: var(--space-sm); }
  .proof-table { width: 100%; border-collapse: collapse; font-family: var(--font-body); font-size: var(--text-small); margin-bottom: var(--space-md); }
  .proof-table thead tr { border-bottom: 1px solid var(--color-basilico); }
  .proof-table th { font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: 11px; color: var(--color-basilico); padding: 8px 12px 8px 0; text-align: left; }
  .proof-table td { padding: 10px 20px 10px 0; color: var(--color-inchiostro); border-bottom: 0.5px solid var(--color-panna-300); }
  .num-cell { font-family: var(--font-display); font-weight: 700; font-size: var(--text-body); color: var(--color-mora); }
  .milan-tag { background-color: var(--color-basilico); border-radius: var(--radius-sm); padding: var(--space-sm) var(--space-md); display: flex; flex-direction: column; gap: 4px; }
  .milan-label { font-family: var(--font-body); font-size: var(--text-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-panna); opacity: 0.7; }
  .milan-desc { font-family: var(--font-body); font-size: var(--text-small); color: var(--color-panna); line-height: 1.5; margin: 0; }

  /* OPP */
  .s-opp { background-color: var(--color-panna-100); padding: var(--section-py) 0; }
  .overline.opp-overline { color: var(--color-mora); opacity: 0.6; }
  .section-h2.opp-h2 { color: var(--color-bitter); font-style: italic; }
  .opp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); }
  .opp-card { background: var(--color-panna); border: 0.5px solid var(--color-panna-300); border-radius: var(--radius-md); overflow: hidden; display: flex; flex-direction: column; }
  .opp-img-wrap { aspect-ratio: 4 / 3; overflow: hidden; }
  .opp-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s ease; }
  .opp-card:hover .opp-img { transform: scale(1.04); }
  .opp-body { padding: var(--space-md); display: flex; flex-direction: column; gap: var(--space-xs); flex: 1; }
  .opp-title { font-family: var(--font-display); font-weight: 700; font-size: var(--text-h3); color: var(--color-mora); margin: 0; }
  .opp-desc { font-family: var(--font-body); font-size: var(--text-body); color: var(--color-mora); opacity: 0.7; line-height: 1.6; margin: 0; }

  /* CATEGORIES */
  .s-categories { background-color: var(--color-fumo); padding: var(--section-py) 0; }
  .section-header { margin-bottom: var(--space-lg); }
