  .cta-video-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .cta-video-overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(to right, color-mix(in srgb, var(--color-mora) 80%, transparent) 0%, color-mix(in srgb, var(--color-mora) 40%, transparent) 55%, color-mix(in srgb, var(--color-mora) 10%, transparent) 100%); }
  .cta-video-inner { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-sm); max-width: 560px; }
  .cta-star { color: var(--color-panna); font-size: 1.6rem; opacity: 0.5; }
