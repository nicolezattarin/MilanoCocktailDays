---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocialLinks from '../../components/SocialLinks.astro';
---

<BaseLayout
  title="Thanks for reaching out"
  description="We've received your partnership enquiry for Milan Cocktail Days 2027. We'll be in touch shortly."
>
  <section class="s-grazie">
    <div class="wrap">
      <p class="overline">Milan Cocktail Days · Partnership</p>
      <h1 class="grazie-h1">Received.<span aria-hidden="true"> ✶</span></h1>
      <p class="grazie-sub">We'll reply directly. Every enquiry gets our full attention — we'll be in touch.</p>

      <img src="/images/dogbartender.gif" alt="Dog bartender" class="grazie-gif" />

      <div class="grazie-divider"></div>

      <p class="grazie-label">In the meantime, follow us</p>
      <SocialLinks variant="dark" />

      <div class="grazie-divider"></div>

      <p class="grazie-label">Direct contact</p>
      <a href="mailto:milanococktaildays@gmail.com" class="grazie-email">milanococktaildays@gmail.com</a>

      <div class="grazie-links">
        <a href="/en/sponsor" class="grazie-back">← Back to Sponsor</a>
        <a href="/bar" class="grazie-back">← Back to Bar Partners</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .s-grazie { background-color: var(--color-mora); min-height: 80svh; padding: var(--section-py) 0; display: flex; align-items: center; }
  .wrap { max-width: 640px; margin: 0 auto; padding: 0 2rem; display: flex; flex-direction: column; gap: var(--space-sm); }
  .overline { font-family: var(--font-body); font-size: var(--text-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.18em; color: var(--color-panna); opacity: 0.55; margin: 0; }
  .grazie-h1 { font-family: var(--font-display); font-weight: 900; font-size: var(--text-h1); color: var(--color-panna); line-height: 1.05; margin: 0; }
  .grazie-sub { font-family: var(--font-body); font-size: var(--text-body-lg); color: var(--color-panna); opacity: 0.8; line-height: 1.6; max-width: 520px; margin: 0; }
  .grazie-divider { height: 0.5px; background-color: var(--color-mora-300); margin: var(--space-sm) 0; }
  .grazie-label { font-family: var(--font-body); font-size: var(--text-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-panna); opacity: 0.55; margin: 0; }
  .grazie-email { font-family: var(--font-body); font-size: var(--text-body); color: var(--color-pesco-300); text-decoration: none; transition: opacity 0.2s ease; }
  .grazie-email:hover { opacity: 0.7; }
  .grazie-links { display: flex; gap: var(--space-md); flex-wrap: wrap; margin-top: var(--space-md); }
  .grazie-back { font-family: var(--font-body); font-size: var(--text-small); color: var(--color-panna); opacity: 0.5; text-decoration: none; transition: opacity 0.2s ease; }
  .grazie-back:hover { opacity: 1; }
  .grazie-gif { width: 100%; max-width: 320px; border-radius: var(--radius-md); margin: var(--space-sm) 0; }
  @media (max-width: 480px) { .wrap { padding: 0 1rem; } .grazie-links { flex-direction: column; gap: var(--space-xs); } }
</style>
