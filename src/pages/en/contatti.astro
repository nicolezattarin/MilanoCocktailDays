---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';
import SocialLinks from '../../components/SocialLinks.astro';

const contatti = [
  { label: 'General', email: 'milanococktaildays@gmail.com' },
];
---

<BaseLayout
  title="Contact"
  description="Contact Milan Cocktail Days 2027. Email, social, and contact form."
>

  <SectionHero
    title="Contact"
    subtitle="Get in touch for info, press, or partnerships ✶"
    overline="Milan Cocktail Days · 2027"
  />

  <!-- DIRECT CONTACTS + SOCIAL -->
  <section class="s-info" aria-labelledby="info-h2">
    <div class="wrap">
      <h2 id="info-h2" class="section-h2">Direct contact</h2>

      <div class="info-grid">
        {contatti.map(({ label, email }) => (
          <div class="info-col">
            <p class="info-label">{label}</p>
            <a href={`mailto:${email}`} class="info-email">{email}</a>
          </div>
        ))}
      </div>

      <SocialLinks variant="light" />
    </div>
  </section>

  <!-- FORM -->
  <section class="s-form" id="form" aria-labelledby="form-h2">
    <div class="wrap">
      <h2 id="form-h2" class="form-heading">
        Write to us <span aria-hidden="true">✶</span>
      </h2>
      <p class="form-intro">
        Fill in the form and we'll reply directly.
      </p>
      <div class="tally-wrap">
        <iframe
          data-tally-src="https://tally.so/embed/Y5pkp5?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1&hideFooter=1"
          loading="lazy"
          width="100%"
          height="689"
          title="Milan Cocktail Days — Contact"
        ></iframe>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .wrap { max-width: var(--container); margin: 0 auto; padding: 0 2rem; }

  .section-h2 { font-family: var(--font-display); font-weight: 900; font-size: var(--text-h1); color: var(--color-mora); line-height: 1.05; margin-bottom: var(--space-md); }

  .s-info { background-color: var(--color-avorio); padding: var(--section-py) 0; }

  .info-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-lg); margin-bottom: var(--space-lg); padding-top: var(--space-md); border-top: 0.5px solid var(--color-panna-300); }

  .info-col { display: flex; flex-direction: column; gap: var(--space-xs); }

  .info-label { font-family: var(--font-body); font-size: var(--text-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-inchiostro-500); margin: 0; }

  .info-email { font-family: var(--font-body); font-size: var(--text-small); color: var(--color-basilico); text-decoration: none; transition: color 0.2s ease; }
  .info-email:hover { color: var(--color-basilico-600); }

  .s-form { background-color: var(--color-fumo); padding: var(--section-py) 0; scroll-margin-top: 64px; }

  .form-heading { font-family: var(--font-display); font-weight: 900; font-size: var(--text-h1); color: var(--color-panna); line-height: 1.05; margin-bottom: var(--space-sm); }

  .form-heading span { color: var(--color-panna); font-size: 0.5em; vertical-align: middle; opacity: 0.5; }

  .form-intro { font-family: var(--font-body); font-size: var(--text-body); color: var(--color-pesco-300); line-height: 1.65; max-width: 560px; margin: 0 0 var(--space-lg); opacity: 0.85; }

  .tally-wrap { max-width: 760px; }

  @media (max-width: 768px) { .info-grid { grid-template-columns: 1fr; gap: var(--space-md); } }
  @media (max-width: 480px) { .wrap { padding: 0 1rem; } }
</style>
