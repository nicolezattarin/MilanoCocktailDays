    margin: 0;
    letter-spacing: -0.02em;
  }

  .why-em { font-style: italic; font-weight: 700; color: var(--color-bitter); }

  .why-body { font-family: var(--font-body); font-size: var(--text-small); color: var(--color-inchiostro-500); line-height: 1.5; margin: 0.25rem 0 0; }

  .why-price-block { flex-shrink: 0; border-left: 0.5px solid var(--color-panna-300); border-right: 0.5px solid var(--color-panna-300); padding: 0 clamp(1.5rem, 3vw, 3rem); }

  .panel-price { display: flex; align-items: baseline; gap: 0.5rem; }

  .price-from { font-family: var(--font-body); font-size: var(--text-small); font-weight: 500; color: var(--color-inchiostro-500); }

  .price-main { font-family: var(--font-display); font-weight: 900; font-size: clamp(2.5rem, 5vw, 4rem); color: var(--color-bitter); line-height: 1; letter-spacing: -0.03em; }

  .price-was { font-family: var(--font-body); font-size: var(--text-body); color: var(--color-inchiostro-300); text-decoration: line-through; text-decoration-thickness: 1px; opacity: 0.55; align-self: center; }

  .why-action { flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-sm); }

  .why-proof { display: flex; align-items: center; gap: var(--space-sm); }

  .proof-avatars { display: flex; }

  .avatar { width: 24px; height: 24px; border-radius: 50%; border: 1.5px solid var(--color-panna); margin-left: -8px; }
  .av-1 { background: var(--color-bitter-500); margin-left: 0; }
  .av-2 { background: var(--color-basilico); }
  .av-3 { background: var(--color-mora-300); }

  .proof-copy { font-family: var(--font-body); font-size: var(--text-small); color: var(--color-inchiostro-500); margin: 0; }
  .proof-n { color: var(--color-mora); font-weight: 700; }

  /* ── WHO IT'S FOR ─────────────────────────────────────────── */
  .s-perchi {
    background-color: var(--color-basilico);
    padding: clamp(3rem, 6vw, 5rem) 0;
    overflow: hidden;
    position: relative;
  }

  .perchi-header { text-align: center; margin-bottom: clamp(2rem, 4vw, 3rem); }

  .perchi-h2 { font-family: var(--font-display); font-weight: 900; font-size: clamp(2rem, 4vw, 3.5rem); color: var(--color-panna); line-height: 1.05; margin: 0.5rem 0 0; letter-spacing: -0.025em; }

  .perchi-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-sm); }

  .perchi-card { position: relative; border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 3 / 4; border: 1px solid color-mix(in srgb, var(--color-panna) 15%, transparent); cursor: default; }

  .perchi-card > .perchi-card-img,
  .perchi-card picture { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }

  .perchi-card-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }

  .perchi-card:hover .perchi-card-img { transform: scale(1.05); }

  .perchi-card-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, color-mix(in srgb, var(--color-inchiostro) 90%, transparent) 0%, color-mix(in srgb, var(--color-inchiostro) 55%, transparent) 40%, color-mix(in srgb, var(--color-inchiostro) 15%, transparent) 70%, transparent 100%);
  }

  .perchi-card-body { position: absolute; bottom: 0; left: 0; right: 0; padding: var(--space-md); display: flex; flex-direction: column; gap: var(--space-xs); }

  .perchi-card-icon { width: 2.5rem; height: 2.5rem; background: var(--color-bitter); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--color-panna); padding: 0.5rem; margin-bottom: var(--space-xs); box-shadow: 0 0 16px color-mix(in srgb, var(--color-bitter) 45%, transparent); flex-shrink: 0; }

  .perchi-card-icon :global(svg) { width: 100%; height: 100%; }

  .perchi-card-title { font-family: var(--font-display); font-weight: 800; font-size: var(--text-h5); color: var(--color-panna); text-transform: uppercase; letter-spacing: 0.04em; margin: 0; line-height: 1.2; }

  .perchi-card-desc { font-family: var(--font-body); font-size: var(--text-small); color: var(--color-pesco-300); line-height: 1.6; margin: 0; }

  .perchi-reveal { opacity: 0; transform: translateY(28px); transition: opacity 0.7s ease, transform 0.7s ease; }
  .perchi-reveal:nth-child(2) { transition-delay: 0.1s; }
  .perchi-reveal:nth-child(3) { transition-delay: 0.2s; }
  .perchi-reveal.is-visible { opacity: 1; transform: none; }

  /* ── PARTNER BARS ─────────────────────────────────────────── */
  .s-bars { background-color: var(--color-avorio); padding: clamp(1.75rem, 3.5vw, 2.5rem) 0; }

  .bars-header { display: flex; align-items: baseline; gap: clamp(1.5rem, 4vw, 3rem); margin-bottom: var(--space-md); flex-wrap: wrap; }

  .bars-h2 { font-family: var(--font-display); font-weight: 900; font-size: clamp(1.5rem, 2.5vw, 2.25rem); color: var(--color-mora); line-height: 1.05; margin: 0; flex: 1; min-width: 220px; }

  .bars-lead { font-family: var(--font-body); font-size: var(--text-small); color: var(--color-inchiostro-500); line-height: 1.65; margin: 0; flex: 1; min-width: 220px; }

  .criteria-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-sm); margin-bottom: var(--space-md); }

  .criterion-card { border-radius: var(--radius-md); overflow: hidden; background-color: var(--color-panna); border: 0.5px solid var(--color-panna-300); display: flex; flex-direction: column; transition: box-shadow 0.25s ease, transform 0.25s ease; }

  .criterion-card:hover { box-shadow: 0 12px 40px color-mix(in srgb, var(--color-mora) 12%, transparent); transform: translateY(-4px); }

  .criterion-img-wrap { aspect-ratio: 4 / 3; overflow: hidden; background-color: var(--color-panna-300); }

  .criterion-img-wrap picture { display: block; width: 100%; height: 100%; }

  .criterion-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
  .criterion-card:hover .criterion-img { transform: scale(1.05); }

  .criterion-body { padding: var(--space-sm) var(--space-sm) var(--space-md); border-top: 2px solid var(--color-basilico); flex: 1; }

  .criterion-title { font-family: var(--font-display); font-weight: 700; font-size: var(--text-body); color: var(--color-mora); margin: 0 0 var(--space-xs); }

  .criterion-desc { font-family: var(--font-body); font-size: var(--text-small); color: var(--color-inchiostro-500); line-height: 1.65; margin: 0; }

  .bars-cta { margin-top: 0; }

  /* ── APP ──────────────────────────────────────────────────── */
  .s-app { background-color: var(--color-panna); padding: clamp(2rem, 5vw, 4rem) 0; position: relative; overflow: hidden; }

  .s-app::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/images/pattern2.svg');
    background-repeat: repeat;
    background-size: 180px;
    opacity: 0.15;
    pointer-events: none;
    z-index: 1;
    -webkit-mask-image: linear-gradient(to top right, black 25%, transparent 65%);
    mask-image: linear-gradient(to top right, black 25%, transparent 65%);
  }

  .app-inner { display: grid; grid-template-columns: 1fr 1.4fr; gap: var(--space-lg); align-items: center; }

  .app-mock { display: flex; justify-content: center; align-items: center; }

  .mockup-img { max-width: 260px; width: 100%; height: auto; display: block; }

  .app-content { display: flex; flex-direction: column; gap: var(--space-md); }

  .app-h2 { font-family: var(--font-display); font-weight: 900; font-size: var(--text-h1); color: var(--color-inchiostro); line-height: 1.05; margin: 0; }

  .app-sub { font-family: var(--font-body); font-size: var(--text-body); color: var(--color-inchiostro-500); line-height: 1.6; margin: 0; opacity: 0.85; }

  .app-cards { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-sm); position: relative; }

  .app-card { background-color: color-mix(in srgb, var(--color-inchiostro) 5%, var(--color-panna)); border: 1.5px solid color-mix(in srgb, var(--color-bitter) 35%, transparent); border-radius: var(--radius-lg); padding: var(--space-md); transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease; position: relative; z-index: 1; }

  .app-card:hover { background-color: color-mix(in srgb, var(--color-inchiostro) 9%, var(--color-panna)); border-color: var(--color-bitter); box-shadow: 0 0 24px color-mix(in srgb, var(--color-bitter) 15%, transparent); }

  .app-card--wide { grid-column: 1 / -1; }

  .app-card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-xs); }

  .app-card-icon { font-size: 2.2rem; line-height: 1; display: block; margin-bottom: var(--space-xs); }

  .app-card-step { font-family: var(--font-display); font-weight: 900; font-size: 1.5rem; color: var(--color-bitter); opacity: 0.5; line-height: 1; letter-spacing: -0.04em; }
  .app-card:hover .app-card-step { opacity: 0.85; }

  .app-card-title { font-family: var(--font-display); font-weight: 700; font-size: var(--text-h5); color: var(--color-inchiostro); margin: 0 0 var(--space-xs); letter-spacing: 0.02em; }

  .app-card-desc { font-family: var(--font-body); font-size: var(--text-small); color: var(--color-inchiostro-500); line-height: 1.65; margin: 0; opacity: 0.85; }

  /* ── QUOTES ───────────────────────────────────────────────── */
  .s-quotes { background-color: var(--color-panna-100); padding: clamp(2rem, 5vw, 4rem) 0; overflow: hidden; border-top: 0.5px solid var(--color-panna-300); border-bottom: 0.5px solid var(--color-panna-300); position: relative; }

  .s-quotes::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/images/pattern2.svg');
    background-repeat: repeat;
    background-size: 180px;
    opacity: 0.09;
    pointer-events: none;
    z-index: 1;
    -webkit-mask-image: linear-gradient(to bottom right, black 25%, transparent 65%);
    mask-image: linear-gradient(to bottom right, black 25%, transparent 65%);
  }

  .quotes-header { margin-bottom: var(--space-md); display: flex; align-items: baseline; gap: var(--space-md); flex-wrap: wrap; }

  .quotes-h2 { font-family: var(--font-display); font-weight: 900; font-size: var(--text-h2); color: var(--color-mora); margin: 0; }

  .quotes-counter { font-family: var(--font-body); font-size: var(--text-small); color: var(--color-inchiostro-500); margin: 0; }

  .quotes-counter .counter-num { font-size: var(--text-body); color: var(--color-basilico); }

  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  .quotes-outer { overflow: hidden; padding: 0 0 var(--space-sm); mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent); }

  .quotes-track { display: flex; gap: var(--space-md); width: max-content; animation: marquee 40s linear infinite; }

  .quotes-outer:hover .quotes-track { animation-play-state: paused; }

  @media (prefers-reduced-motion: reduce) { .quotes-track { animation: none; } .quotes-outer { overflow-x: auto; } }

  .quote-card { flex: 0 0 min(320px, 80vw); background-color: var(--color-panna); border: 0.5px solid var(--color-panna-300); border-radius: var(--radius-md); padding: var(--space-md); display: flex; flex-direction: column; gap: var(--space-sm); }

  .quote-text { font-family: var(--font-body); font-style: italic; font-size: var(--text-body); color: var(--color-mora); line-height: 1.65; quotes: none; margin: 0; }

  .quote-author { font-family: var(--font-body); font-size: var(--text-label); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-inchiostro-700); }

  /* ── CTA FINALE ───────────────────────────────────────────── */
  .s-cta-final { position: relative; overflow: hidden; min-height: clamp(400px, 60vh, 700px); display: flex; align-items: center; }

  .cta-bg { position: absolute; inset: 0; z-index: 0; }

  .cta-bg-img { width: 100%; height: 100%; object-fit: cover; object-position: center calc(35% - 100px); display: block; }

  .cta-overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(to right, color-mix(in srgb, var(--color-mora) 40%, transparent) 0%, color-mix(in srgb, var(--color-mora) 20%, transparent) 50%, transparent 100%); }

  .cta-final-inner { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-md); padding-top: clamp(4rem, 8vw, 7rem); padding-bottom: clamp(4rem, 8vw, 7rem); margin-left: 10px; margin-right: 10px; }

  .cta-final-h2 { font-family: var(--font-display); font-weight: 900; font-size: clamp(3.5rem, 9vw, 8rem); color: var(--color-panna); line-height: 0.9; margin: 0; letter-spacing: -0.03em; }

  .cta-trust { font-family: var(--font-body); font-size: var(--text-small); color: var(--color-pesco-300); opacity: 0.65; margin: 0; font-style: italic; }

  /* ── FAQ ──────────────────────────────────────────────────── */
  .s-faq { background-color: var(--color-panna); padding: clamp(3rem, 6vw, 5rem) 0; }

  .faq-wrap { display: grid; grid-template-columns: 0.6fr 1fr; gap: clamp(3rem, 7vw, 7rem); align-items: start; }

  .faq-header { position: sticky; top: 5rem; }

  .faq-h2 { font-family: var(--font-display); font-weight: 900; font-size: clamp(2.5rem, 5vw, 4.5rem); color: var(--color-mora); line-height: 0.97; margin: 0; letter-spacing: -0.03em; }

  .faq-list { display: flex; flex-direction: column; }

  .faq-item { border-top: 0.5px solid var(--color-panna-300); }
  .faq-item:last-child { border-bottom: 0.5px solid var(--color-panna-300); }

  .faq-q { display: flex; justify-content: space-between; align-items: center; gap: var(--space-sm); padding: var(--space-md) 0; cursor: pointer; font-family: var(--font-display); font-weight: 700; font-size: var(--text-body); color: var(--color-mora); list-style: none; user-select: none; }
  .faq-q::-webkit-details-marker { display: none; }

  .faq-icon { color: var(--color-bitter); flex-shrink: 0; transition: transform 0.25s ease; font-size: 0.9em; }
  details[open] .faq-icon { transform: rotate(45deg); }

  .faq-a { font-family: var(--font-body); font-size: var(--text-body); color: var(--color-inchiostro); line-height: 1.75; margin: 0; padding: 0 var(--space-lg) var(--space-md) 0; }

  /* ── FORM ─────────────────────────────────────────────────── */
  .s-lista { background-color: var(--color-fumo); padding: clamp(2rem, 5vw, 4rem) 0; scroll-margin-top: 64px; }

  .lista-h2 { font-family: var(--font-display); font-weight: 900; font-size: var(--text-h1); color: var(--color-panna); line-height: 1.05; margin: 0 0 var(--space-sm); }

  .lista-h2 span { font-size: 0.5em; vertical-align: middle; opacity: 0.5; }

  .lista-intro { font-family: var(--font-body); font-size: var(--text-body); color: var(--color-pesco-300); line-height: 1.65; max-width: 560px; margin: 0 0 var(--space-lg); opacity: 0.85; }

  .tally-wrap { max-width: 760px; }

  /* ── REVEALS ──────────────────────────────────────────────── */
  section { position: relative; z-index: 0; }

  .reveal { opacity: 0; transform: translateY(20px); transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  .reveal.is-visible { opacity: 1; transform: none; }
  .reveal-d1 { transition-delay: 0.12s; }
  .reveal-d2 { transition-delay: 0.24s; }
  .reveal-d3 { transition-delay: 0.38s; }

  @media (prefers-reduced-motion: reduce) {
    .reveal, .how-card, .perchi-reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
  }

  /* Vignette */
  .s-how::before, .s-why::before, .s-perchi::before, .s-bars::before, .s-app::before, .s-cta-final::before, .s-lista::before, .s-faq::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 80px; background: linear-gradient(to bottom, rgba(0,0,0,0.22), transparent); pointer-events: none; z-index: 2;
  }

  .s-hero::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 120px; background: linear-gradient(to top, rgba(0,0,0,0.55), transparent); pointer-events: none; z-index: 1; }
  .hero-inner { z-index: 3; }

  .s-how .wrap { position: relative; z-index: 3; }
  .why-wrap { position: relative; z-index: 3; }
  .s-perchi .wrap { position: relative; z-index: 3; }
  .s-bars .wrap { position: relative; z-index: 3; }
  .app-inner { position: relative; z-index: 3; }
  .quotes-header, .quotes-outer { position: relative; z-index: 3; }
  .s-lista .wrap { position: relative; z-index: 3; }
  .faq-wrap { position: relative; z-index: 3; }

  .s-quotes { background-image: radial-gradient(ellipse 60% 50% at 85% 55%, color-mix(in srgb, var(--color-pesco) 6%, transparent), transparent), radial-gradient(ellipse 40% 60% at 12% 40%, color-mix(in srgb, var(--color-basilico) 5%, transparent), transparent); }

  .btn { transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease; }
  .btn:hover { transform: translateY(-2px); box-shadow: 0 8px 22px color-mix(in srgb, var(--color-bitter) 24%, transparent); }
  .btn:active { transform: translateY(0); }

  /* ── RESPONSIVE ───────────────────────────────────────────── */
  @media (max-width: 900px) {
    .how-steps { grid-template-columns: 1fr; }
    .how-connector { display: none; }
    .why-wrap { flex-direction: column; align-items: stretch; }
    .why-price-block { border-left: none; border-right: none; border-top: 0.5px solid var(--color-panna-300); border-bottom: 0.5px solid var(--color-panna-300); padding: var(--space-sm) 0; }
    .criteria-grid { grid-template-columns: repeat(2, 1fr); }
    .bars-header { flex-direction: column; gap: var(--space-sm); }
    .perchi-cards { grid-template-columns: repeat(2, 1fr); }
