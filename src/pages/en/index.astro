  .how-card:nth-child(3) { transition-delay: 0.2s; }

  .how-card:hover {
    box-shadow: 0 24px 64px color-mix(in srgb, var(--color-mora) 70%, transparent), 0 0 60px color-mix(in srgb, var(--color-bitter) 30%, transparent), 0 0 0 1px color-mix(in srgb, var(--color-bitter) 60%, transparent);
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--color-bitter) 70%, transparent);
  }

  .how-card.is-visible:hover { transform: translateY(-6px); }

  .how-card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-xs); }

  .how-card-num {
