      radial-gradient(ellipse 45% 55% at 5% 85%, color-mix(in srgb, var(--color-basilico) 35%, transparent), transparent),
      radial-gradient(ellipse 40% 40% at 50% 50%, color-mix(in srgb, var(--color-mora) 25%, transparent), transparent);
  }

  .s-how .wrap { position: relative; z-index: 2; }

  .how-h2 {
