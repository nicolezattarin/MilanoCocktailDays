    .wrap { padding: 0 1rem; }
    .hero-inner { padding: 20px 16px; }
    .hero-logo { max-width: min(380px, 90%); }
    .bars-h2 { min-width: 0; font-size: clamp(1.3rem, 7vw, 1.8rem); }
    .bars-lead { min-width: 0; }
    .how-card { padding: var(--space-sm); }
    .cta-final-inner { padding: var(--space-lg) var(--space-sm); }
    .how-sub { font-size: var(--text-body-lg); }
    .perchi-h2 { font-size: clamp(1.6rem, 7vw, 2.5rem); }
  }
</style>

<script>
  document.querySelectorAll('.faq-item').forEach(detail => {
    detail.addEventListener('toggle', () => {
      if ((detail as HTMLDetailsElement).open) {
        document.querySelectorAll('.faq-item').forEach(other => {
          if (other !== detail) (other as HTMLDetailsElement).open = false;
        });
      }
    });
  });

  function makeVisible(el: Element) { el.classList.add('is-visible'); }

  requestAnimationFrame(() => {
    const perchiSection = document.querySelector('.s-perchi');
    if (perchiSection) {
      const perchiRevealEls = perchiSection.querySelectorAll('.perchi-reveal');
      const perchiObs = new IntersectionObserver(
        entries => { if (entries[0].isIntersecting) { perchiRevealEls.forEach(makeVisible); perchiObs.disconnect(); } },
        { threshold: 0.1 }
      );
      perchiObs.observe(perchiSection);
    }

    const howCards = document.querySelectorAll('.how-card');
    if (howCards.length) {
      const io = new IntersectionObserver(
        entries => entries.forEach(e => { if (e.isIntersecting) { makeVisible(e.target); io.unobserve(e.target); } }),
        { threshold: 0.05 }
      );
      howCards.forEach(c => io.observe(c));
    }

    const revealEls = document.querySelectorAll('.reveal');
    if (revealEls.length) {
      const revealObs = new IntersectionObserver(
        entries => entries.forEach(e => { if (e.isIntersecting) { makeVisible(e.target); revealObs.unobserve(e.target); } }),
        { threshold: 0.05 }
      );
      revealEls.forEach(el => revealObs.observe(el));
      setTimeout(() => {
        document.querySelectorAll('.reveal:not(.is-visible), .how-card:not(.is-visible), .perchi-reveal:not(.is-visible)').forEach(makeVisible);
      }, 2500);
    }
  });

  const heroBgImg = document.querySelector<HTMLImageElement>('.hero-bg img');
  if (heroBgImg && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    window.addEventListener('scroll', () => {
      heroBgImg.style.transform = `translateY(${window.scrollY * 0.22}px)`;
    }, { passive: true });
  }
</script>
