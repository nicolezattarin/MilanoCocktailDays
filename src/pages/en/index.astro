---
import BaseLayout from '../../layouts/BaseLayout.astro';

const steps = [
  {
    n: '01',
    title: 'Get your pass',
    desc: 'One pass. Good for all ten days. Early bird from €15.',
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="9" width="28" height="14" rx="2"/><line x1="10" y1="9" x2="10" y2="23" stroke-dasharray="3 3" opacity="0.6"/><circle cx="2" cy="16" r="2.5" fill="currentColor" stroke="none" opacity="0.25"/><circle cx="30" cy="16" r="2.5" fill="currentColor" stroke="none" opacity="0.25"/></svg>`,
  },
  {
    n: '02',
    title: 'Explore the bars',
    desc: 'Thirty hand-picked cocktail bars, from Navigli to NoLo. Move at your own pace — no bookings, no fixed route.',
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M16 3C11.6 3 8 6.6 8 11c0 6 8 18 8 18s8-12 8-18c0-4.4-3.6-8-8-8z"/><circle cx="16" cy="11" r="2.5"/></svg>`,
  },
  {
    n: '03',
    title: 'Order the exclusive cocktail',
    desc: 'Order the drink made just for these ten days. Flat €6, at every venue.',
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M5 4h22L16 17 5 4z"/><line x1="16" y1="17" x2="16" y2="25"/><line x1="10" y1="28" x2="22" y2="28"/></svg>`,
  },
];

const criteria = [
  {
    title: 'The cocktail at the centre.',
    desc: 'Cocktails are the heart of the offering — not an afterthought on the menu.',
    altText: 'cocktail glass at a selected Milan cocktail bar',
    img: '/images/Clear Wine Glass Photo.jpg',
  },
  {
    title: 'Neighbourhoods that pulse.',
    desc: 'From Brera to Lambrate, Navigli to NoLo. Milan, quartiere by quartiere.',
    altText: 'people at a cocktail bar in a Milan neighbourhood',
    img: '/images/Szymon Fischer.jpg',
  },
  {
    title: 'A clear point of view.',
    desc: 'Curated, seasonal drink lists. Every cocktail earns its place.',
    altText: 'bartender preparing a signature cocktail in Milan',
    img: '/images/bartender_1.jpg',
  },
];

const appFeatures = [
  {
    step: '01',
    icon: '🎫',
    title: 'One pass. The whole city.',
    desc: "Buy your ticket and get access to the app: every bar, every cocktail, right in your pocket. Your pass works for all ten days.",
    wide: false,
  },
  {
    step: '02',
    icon: '🗺️',
    title: 'Discover bars and cocktails.',
    desc: "Browse which bars are taking part and preview their signature cocktails.",
    wide: false,
  },
  {
    step: '03',
    icon: '📱',
    title: 'Scan and order.',
    desc: "At the bar, scan the QR code in the app and order your signature cocktail. No reservation needed.",
    wide: false,
  },
  {
    step: '04',
    icon: '⭐',
    title: 'Collect stamps, unlock rewards.',
    desc: "Every signature cocktail earns a digital stamp. More stamps, more perks.",
    wide: false,
  },
];

const perchiCards = [
  {
    title: 'Cocktail lovers',
    desc: 'For anyone who always orders something new and wants to see what the best bars in Milan can do.',
    altText: 'cocktail glass at a Milan cocktail bar during Milano Cocktail Days',
    img: '/images/Clear Wine Glass Photo.jpg',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h14l-7 9-7-9z"/><line x1="12" y1="13" x2="12" y2="20"/><line x1="8" y1="20" x2="16" y2="20"/></svg>`,
  },
  {
    title: 'Nights out with friends',
    desc: 'For a different kind of evening — the right cocktails and the urge to wander between neighbourhoods.',
    altText: 'friends at a cocktail bar in Milan during Milano Cocktail Days',
    img: '/images/Szymon Fischer.jpg',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    title: 'The curious',
    desc: 'For anyone who wants to discover new bars and neighbourhoods across Milan, one drink at a time.',
    altText: 'bartender at the counter of a Milan cocktail bar at Milano Cocktail Days',
    img: '/images/bartender_1.jpg',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>`,
  },
];

const quotes = [
  { text: "Finally an event like London Cocktail Week, right here in Milan.", name: 'Giulia', age: 25 },
  { text: "A cocktail at €6 is already enough reason to buy the pass.", name: 'Marco', age: 24 },
  { text: "An excuse to go out during the week in Milan.", name: 'Elena', age: 30 },
  { text: "Sounds like a great way to discover new bars.", name: 'Luca', age: 34 },
  { text: "Can't wait to explore parts of the city I've never been to.", name: 'Sara', age: 28 },
  { text: "Perfect for cocktail lovers who hate paying central prices.", name: 'Davide', age: 31 },
  { text: "Already convinced all my friends to sign up.", name: 'Martina', age: 26 },
  { text: "€15 for ten days around Milan? Done.", name: 'Valentina', age: 32 },
  { text: "The idea of a unique cocktail at every bar is brilliant.", name: 'Chiara', age: 29 },
  { text: "Exactly the kind of event this city was missing.", name: 'Riccardo', age: 35 },
  { text: "Finally something worth doing in Milan in May.", name: 'Andrea', age: 33 },
  { text: "Curious to see which bars make the cut.", name: 'Filippo', age: 27 },
];

const imgSources: Record<string, { avif: string; webp: string }> = {
  '/images/Clear Wine Glass Photo.jpg': {
    avif: '/images/clear-wine-glass-400.avif 400w',
    webp: '/images/clear-wine-glass-400.webp 400w',
  },
  '/images/Szymon Fischer.jpg': {
    avif: '/images/szymon-fischer-400.avif 400w',
    webp: '/images/szymon-fischer-400.webp 400w',
  },
  '/images/bartender_1.jpg': {
    avif: '/images/bartender-1-500.avif 500w',
    webp: '/images/bartender-1-500.webp 500w',
  },
};

const faqs = [
  {
    q: 'What is Milano Cocktail Days?',
    a: "Ten days, once a year, when Milan becomes the capital of cocktail culture. Thirty of the city's best bars create a signature drink — exclusive, made for the festival, available nowhere else. Buy the pass and do the tour.",
  },
  {
    q: 'When is the next edition?',
    a: "May 2027. Official dates coming soon — join the waitlist to find out first and lock in your early bird pass.",
  },
  {
    q: 'Where does it take place?',
    a: "Everywhere. This is a diffuse festival. The thirty partner bars — announced very soon — are spread across Milan. Each one opens its doors to serve their exclusive creation.",
  },
  {
    q: 'Do I need a separate ticket for each bar?',
    a: "No. One pass (from €15) gives you access to all thirty partner bars. Show your pass and order the festival cocktail for a flat €6 — instead of the usual €10–15.",
  },
  {
    q: 'Do I need to book in advance?',
    a: "No bookings, no fixed schedule. Check the bar's opening hours, walk up to the bancone, and order with your pass — accessible directly from our web app.",
  },
  {
    q: 'Where can I buy a pass?',
    a: "Passes go on sale exclusively online, right here. Join the waitlist to know exactly when they drop and secure your early bird price.",
  },
  {
    q: "I don't know much about cocktails. Is this for me?",
    a: "Yes. MCD is not a trade fair for industry insiders — it's for anyone who likes a well-made drink and wants to discover new places. Whether you're a regular or a curious first-timer, you belong here.",
  },
  {
    q: 'Is it worth going for just one evening?',
    a: "Absolutely. One evening is enough to find your next favourite bar. And the economics make sense: three cocktails at €6 each already covers the cost of an early bird pass.",
  },
  {
    q: "My friends aren't interested — should I still come?",
    a: "Yes. That's what cocktail bars are for. Sit at the bancone, let the bartender do their thing. A good bar is the best social space there is.",
  },
  {
    q: 'Is there an age limit?',
    a: "Yes — 18+. The programme is exclusively alcoholic beverages.",
  },
];
---

<BaseLayout
  title="Milano Cocktail Days — Thirty bars, ten days, one pass."
  description="May 2027: thirty bars across Milan, ten days, one cocktail made just for the festival at every bancone — €6. Join the list for early bird passes from €15."
  pageType="event"
>

  <!-- S01 · HERO -->
  <section class="s-hero" aria-labelledby="home-h1">
    <picture class="hero-bg" aria-hidden="true">
      <source
        type="image/avif"
        srcset="/images/bar_photo1-430.avif 430w, /images/bar_photo1-500.avif 500w, /images/bar_photo1-1024.avif 1024w, /images/bar_photo1-1920.avif 1920w"
        sizes="100vw"
      />
      <source
        type="image/webp"
        srcset="/images/bar_photo1-430.webp 430w, /images/bar_photo1-500.webp 500w, /images/bar_photo1-1024.webp 1024w, /images/bar_photo1-1920.webp 1920w"
        sizes="100vw"
      />
      <img
        src="/images/bar_photo1.jpg"
        alt=""
        width="1920" height="1080"
        fetchpriority="high" loading="eager"
      />
    </picture>
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="wrap hero-inner">
      <img src="/logos/logo_3_v.FINAL/Panna.svg" alt="Milan Cocktail Days" class="hero-logo" width="500" height="125" />

      <p class="hero-overline">
        Milano <span aria-hidden="true">✶</span> May 2027 <span aria-hidden="true">✶</span> First Edition
      </p>

      <h1 id="home-h1" class="hero-h1">
        Thirty bars in Milan.<br />Ten days.<br />One pass.
      </h1>

      <p class="hero-sub">
        Every bar creates a cocktail made just for the event — €6 flat, only during the ten days of May.
        Join the list — early bird passes from €15.
      </p>

      <a href="#lista" class="btn btn--primary">
        Join the waitlist <span aria-hidden="true">✶</span>
      </a>
    </div>
  </section>

  <!-- S02 · HOW IT WORKS -->
  <section class="s-how" aria-labelledby="how-h2">
    <div class="how-bg-glow" aria-hidden="true"></div>
    <div class="wrap">

      <h2 id="how-h2" class="how-h2 reveal">Three things.<br />That's it.</h2>
      <p class="how-sub reveal">One ticket gives you access to all 30 bars and every cocktail.</p>

      <div class="how-steps-wrap">
        <div class="how-connector" aria-hidden="true"></div>
        <div class="how-steps">
          {steps.map(({ n, icon, title, desc }) => (
            <article class="how-card">
              <div class="how-card-top">
                <div class="how-card-num" aria-hidden="true">{n}</div>
                <div class="how-card-icon" aria-hidden="true" set:html={icon} />
              </div>
              <h3 class="how-card-title">{title}</h3>
              <div class="how-card-desc-box">
                <p class="how-card-desc">{desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>

      <div class="how-footer reveal reveal-d1">
        <p class="how-strap">
          Thirty bars, thirty recipes made for the week. A new way to drink Milan.
          <span aria-hidden="true">✶</span>
        </p>
        <a href="#lista" class="btn btn--primary how-cta">
          Join the waitlist <span aria-hidden="true">✶</span>
        </a>
      </div>

    </div>
  </section>

  <!-- S03 · EARLY BIRD -->
  <section class="s-why" aria-labelledby="why-h2">
    <div class="why-texture" aria-hidden="true"></div>
    <div class="wrap why-wrap">

      <div class="why-editorial">
        <p class="why-kicker">Early bird <span aria-hidden="true">✶</span> Launch price</p>
        <h2 id="why-h2" class="why-h2">
          The best price.<br />
          <em class="why-em">For the waitlist only.</em>
        </h2>
        <p class="why-body">Price goes to €30 once early bird spots are gone.</p>
      </div>

      <div class="why-price-block">
        <div class="panel-price">
          <span class="price-from">From</span>
          <span class="price-main">€15</span>
          <span class="price-was">€30</span>
        </div>
      </div>

      <div class="why-action">
        <div class="why-proof">
          <div class="proof-avatars" aria-hidden="true">
            <span class="avatar av-1"></span>
            <span class="avatar av-2"></span>
            <span class="avatar av-3"></span>
          </div>
          <p class="proof-copy"><strong class="proof-n">347</strong> already signed up</p>
        </div>
        <a href="#lista" class="btn btn--primary">
          Join the waitlist <span aria-hidden="true">✶</span>
        </a>
      </div>

    </div>
  </section>

  <!-- S05 · WHO IT'S FOR -->
  <section class="s-perchi" aria-labelledby="perchi-h2">
    <div class="wrap">

      <div class="perchi-header perchi-reveal">
        <p class="section-kicker section-kicker--light">Who it's for</p>
        <h2 id="perchi-h2" class="perchi-h2">
          For people who love Milan.<br />And those who want to know it, one cocktail at a time.
        </h2>
      </div>

      <div class="perchi-cards">
        {perchiCards.map(({ title, desc, img, icon, altText }) => (
          <article class="perchi-card perchi-reveal">
            {imgSources[img] ? (
              <picture>
                <source type="image/avif" srcset={imgSources[img].avif} sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw" />
                <source type="image/webp" srcset={imgSources[img].webp} sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw" />
                <img src={img} alt={altText} class="perchi-card-img" loading="lazy" />
              </picture>
            ) : (
              <img src={img} alt={altText} class="perchi-card-img" loading="lazy" />
            )}
            <div class="perchi-card-overlay"></div>
            <div class="perchi-card-body">
              <div class="perchi-card-icon" set:html={icon} />
              <h3 class="perchi-card-title">{title}</h3>
              <p class="perchi-card-desc">{desc}</p>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- S06a · PARTNER BARS -->
  <section class="s-bars" aria-labelledby="bars-h2">
    <div class="wrap">
      <div class="bars-header reveal">
        <h2 id="bars-h2" class="bars-h2">Not every bar in Milan. The thirty that matter.</h2>
        <p class="bars-lead">
          Independent bars, bartenders with something to say, drinks that tell a story.
        </p>
      </div>

      <div class="criteria-grid">
        {criteria.map(({ title, desc, img, altText }, i) => (
          <div class:list={['criterion-card', 'reveal', i === 1 && 'reveal-d1', i === 2 && 'reveal-d2']}>
            <div class="criterion-img-wrap">
              {imgSources[img] ? (
                <picture>
                  <source type="image/avif" srcset={imgSources[img].avif} sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw" />
                  <source type="image/webp" srcset={imgSources[img].webp} sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw" />
                  <img src={img} alt={altText} class="criterion-img" loading="lazy" />
                </picture>
              ) : (
                <img src={img} alt={altText} class="criterion-img" loading="lazy" />
              )}
            </div>
            <div class="criterion-body">
              <h3 class="criterion-title">{title}</h3>
              <p class="criterion-desc">{desc}</p>
            </div>
          </div>
        ))}
      </div>

      <a href="#lista" class="btn btn--primary bars-cta reveal reveal-d1">
        Join the waitlist <span aria-hidden="true">✶</span>
      </a>
    </div>
  </section>

  <!-- S06b · THE APP -->
  <section class="s-app" aria-labelledby="app-h2">
    <div class="wrap app-inner">
      <div class="app-mock" aria-hidden="true">
        <img
          src="/images/Google Pixel 4 Mockup/app_user-portrait.png"
          alt=""
          class="mockup-img"
          loading="lazy"
        />
      </div>

      <div class="app-content">
        <h2 id="app-h2" class="app-h2 reveal">Buy your ticket.<br />Enjoy the festival.</h2>
        <p class="app-sub reveal reveal-d1">
          Ticket → map → QR → cocktail. Three taps.
        </p>

        <div class="app-cards reveal reveal-d2">
          {appFeatures.map(({ step, icon, title, desc, wide }) => (
            <div class:list={['app-card', { 'app-card--wide': wide }]}>
              <div class="app-card-header">
                <span class="app-card-icon" aria-hidden="true">{icon}</span>
                <span class="app-card-step" aria-hidden="true">{step}</span>
              </div>
              <h3 class="app-card-title">{title}</h3>
              <p class="app-card-desc">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- S07 · VOICES FROM THE LIST -->
  <section class="s-quotes" aria-labelledby="quotes-h2">
    <div class="wrap quotes-header reveal">
      <h2 id="quotes-h2" class="quotes-h2">What people on the list are saying</h2>
      <p class="quotes-counter" aria-live="polite">
        <strong class="counter-num" id="counter-quotes">347</strong> people signed up
      </p>
    </div>

    <div class="quotes-outer">
      <div class="quotes-track" id="quotes-track" aria-label="Testimonials">
        {[...quotes, ...quotes].map(({ text, name, age }, i) => (
          <article class="quote-card" aria-hidden={i >= quotes.length ? 'true' : 'false'}>
            <blockquote class="quote-text">"{text}"</blockquote>
            <footer class="quote-author">— {name}, {age}</footer>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- S08 · FINAL CTA -->
  <section class="s-cta-final" aria-labelledby="cta-final-h2">
    <picture class="cta-bg" aria-hidden="true">
      <img
        src="/images/Photo by Mahyaddin Jabbarli.jpg"
        alt=""
        class="cta-bg-img"
        loading="lazy"
        width="1920" height="1080"
      />
    </picture>
    <div class="cta-overlay" aria-hidden="true"></div>
    <div class="wrap cta-final-inner">
      <p class="section-kicker section-kicker--light reveal">Milan, May 2027</p>
      <h2 id="cta-final-h2" class="cta-final-h2 reveal reveal-d1">
        Join the first edition.<br /> May 2027.
      </h2>
      <a href="#lista" class="btn btn--final reveal reveal-d2">
        Join the waitlist <span aria-hidden="true">✶</span>
      </a>
      <p class="cta-trust reveal reveal-d3">Join the waitlist for priority access to early bird passes at the best price.</p>
    </div>
  </section>

  <!-- FORM -->
  <section class="s-lista" id="lista" aria-labelledby="lista-h2">
    <div class="wrap">
      <h2 id="lista-h2" class="lista-h2 reveal">
        Waitlist <span aria-hidden="true">✶</span>
      </h2>
      <p class="lista-intro reveal reveal-d1">
        Sign up free. You'll hear from us first when passes go on sale.
      </p>
      <div class="tally-wrap">
        <iframe
          data-tally-src="https://tally.so/embed/Y5pkp5?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1&hideFooter=1"
          loading="lazy"
          width="100%"
          height="689"
          title="Milan Cocktail Days — Waitlist"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- S09 · FAQ -->
  <section class="s-faq" aria-labelledby="faq-h2">
    <div class="wrap faq-wrap">

      <div class="faq-header reveal">
        <p class="section-kicker">FAQ</p>
        <h2 id="faq-h2" class="faq-h2">Questions.<br />Two lines each.</h2>
      </div>

      <div class="faq-list reveal reveal-d1" id="faq-list">
        {faqs.map(({ q, a }) => (
          <details class="faq-item">
            <summary class="faq-q">
              {q}
              <span class="faq-icon" aria-hidden="true">✶</span>
            </summary>
            <p class="faq-a">{a}</p>
          </details>
        ))}
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ── SECTION KICKER ───────────────────────────────────────── */
  .section-kicker {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-basilico);
    margin: 0 0 var(--space-sm);
    display: block;
  }
  .section-kicker--light {
    color: var(--color-pesco-300);
    opacity: 0.8;
  }

  /* ── HERO ─────────────────────────────────────────────────── */
  .s-hero {
    position: relative;
    min-height: 885px;
    display: flex;
    align-items: center;
    padding: clamp(2rem, 5vw, 4rem) 0;
    overflow: hidden;
    background-color: var(--color-mora);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 80% center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-inchiostro) 55%, transparent) 0%,
      color-mix(in srgb, var(--color-inchiostro) 15%, transparent) 30%,
      transparent 60%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    max-width: 720px;
    padding: 32px 40px;
    background: color-mix(in srgb, var(--color-inchiostro) 30%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid color-mix(in srgb, var(--color-panna) 14%, transparent);
    border-radius: var(--radius-md);
  }

  .hero-logo {
    height: auto;
    max-width: 500px;
    width: 100%;
    display: block;
    object-fit: contain;
    margin-bottom: var(--space-md);
  }

  .hero-overline {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-panna);
    opacity: 0.65;
    margin: 0;
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.25rem, 5.5vw, 5rem);
