</style>

<script>
  document.querySelectorAll('.faq-item').forEach(detail => {
    detail.addEventListener('toggle', () => {
      if ((detail as HTMLDetailsElement).open) {
        document.querySelectorAll('.faq-item').forEach(other => {
          if (other !== detail) (other as HTMLDetailsElement).open = false;
        });
      }
    });
  });

  function makeVisible(el: Element) {
    el.classList.add('is-visible');
  }

  requestAnimationFrame(() => {
    const stepSection = document.querySelector('.s-how');
    if (stepSection) {
      const steps = stepSection.querySelectorAll('.step');
      const stepObs = new IntersectionObserver(
        entries => {
          if (entries[0].isIntersecting) {
            steps.forEach(makeVisible);
            stepObs.disconnect();
          }
        },
        { threshold: 0.1 }
      );
      stepObs.observe(stepSection);
    }

    const reqGrid = document.querySelector('.req-grid');
    if (reqGrid) {
      const reqItems = reqGrid.querySelectorAll('.req-item');
      const reqObs = new IntersectionObserver(
        entries => {
          if (entries[0].isIntersecting) {
            reqItems.forEach(makeVisible);
            reqObs.disconnect();
          }
        },
        { threshold: 0.08 }
      );
      reqObs.observe(reqGrid);
    }

    const revealEls = document.querySelectorAll('.reveal');
    if (revealEls.length) {
      const revealObs = new IntersectionObserver(
        entries => entries.forEach(e => { if (e.isIntersecting) { makeVisible(e.target); revealObs.unobserve(e.target); } }),
        { threshold: 0.05 }
      );
      revealEls.forEach(el => revealObs.observe(el));
      setTimeout(() => {
        document.querySelectorAll('.reveal:not(.is-visible), .step:not(.is-visible), .req-item:not(.is-visible)').forEach(makeVisible);
      }, 2500);
    }
  });

  const heroBgImg = document.querySelector<HTMLImageElement>('.s-hero .hero-bg img');
  if (heroBgImg && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    window.addEventListener('scroll', () => {
      heroBgImg.style.transform = `translateY(${window.scrollY * 0.2}px)`;
    }, { passive: true });
  }
</script>
