---
import BaseLayout from '../../layouts/BaseLayout.astro';

const ospiteSteps = [
  { n: '01', title: 'THE GUEST BUYS A PASS',       desc: 'Attendees buy their pass before the festival. Nothing for you to manage.' },
  { n: '02', title: 'THEY CHOOSE YOUR BAR',         desc: 'Via the MCD app they browse available bars and decide where to go.' },
  { n: '03', title: 'THEY ORDER AND TASTE',         desc: 'They arrive, show their pass, and order your signature cocktail. €6 flat — you keep it.' },
];

const benefits = [
  { title: 'New faces at the bancone',   desc: 'We bring a stream of new guests to your venue — cocktail enthusiasts and curious Milanese who want to explore the city one drink at a time. People who walk in through the door and who you can turn into regulars.' },
  { title: 'Your bar on the map',        desc: "You land right at the centre of the official festival map and all MCD communications. It's the most direct way to be found by thousands of people deciding which bar to visit." },
  { title: 'Market insights',           desc: "No guesswork. At the end of the festival you'll have a clear picture of cocktail consumption habits in Milan: what people choose to drink, their preferences, and how much they drink across the week." },
];

const requirements = [
  { label: 'Entry fee',        val: '€0',  sub: 'Joining costs nothing.',                  img: '/images/Biyunfei Yang Unsplash.jpg' },
  { label: 'Cocktail price',   val: '€6',  sub: 'Fixed price for every MCD signature cocktail.', img: '/images/Person Holding Glass Photo.jpg' },
  { label: 'MCD cocktail',     val: '×1',  sub: 'One recipe — yours, exclusive to the event.',   img: '/images/Mediha Ekici Photo.jpg' },
];

const criteria = [
  'A drinks list that is curated, seasonal, and never predictable.',
  'Behind the bancone, real professionals driven by passion.',
  'An atmosphere that turns an evening into an experience.',
];

const appFeatures = [
  { step: '01', icon: '📈', title: 'Visit analytics',        desc: 'Real data on how many users view your profile and order your drink.', wide: false },
  { step: '02', icon: '⭐', title: 'Verified reviews',       desc: 'Only pass-holders can leave reviews. Genuine feedback, not spam.', wide: false },
  { step: '03', icon: '📍', title: 'Map placement',          desc: 'Your bar featured on the festival map with photos and description.', wide: false },
  { step: '04', icon: '💬', title: 'Community',              desc: 'Access the community section: engage with attendees and draw them to your venue.', wide: false },
];

const faqs = [
  { q: 'How much does it cost to join?',        a: 'Zero. Participation in the festival is free for bars. The only financial element is the fixed price of the MCD signature cocktail: €6 to the guest.' },
  { q: 'How many evenings do I need to cover?', a: 'The minimum is 3 evenings out of 10. The more evenings you cover, the greater your visibility. Many bars choose to participate in all ten.' },
  { q: 'Do I need to create a new cocktail?',   a: "Yes. Every bar creates an exclusive signature cocktail for MCD. It doesn't need to be groundbreaking — but it needs to be yours and made well." },
  { q: 'How do bookings work?',                 a: 'Attendees book a slot at your bar via the MCD app. You receive bookings 24 hours in advance. You decide how many slots to make available each evening.' },
  { q: 'Who selects the bars?',                 a: "The MCD team makes a qualitative selection. There's no fixed number of bars. We look for quality and geographic diversity across Milan's quartieri." },
];
---

<BaseLayout
  title="Bar Partners"
  description="Apply your bar to Milan Cocktail Days 2027. €0 entry fee, €6 flat, qualified cocktail enthusiast footfall. Applications open."
>

  <!-- HERO -------------------------------------------------- -->
  <section class="s-hero" aria-labelledby="bar-h1">
    <picture class="hero-bg" aria-hidden="true">
      <img
        src="/images/Andrea De Santis Photo.jpg"
        alt=""
        width="1920" height="1080"
        fetchpriority="high" loading="eager"
      />
    </picture>
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="hero-overline">Bar Partners · Applications Open</p>
      <h1 id="bar-h1" class="hero-h1">
        Thirty bars in Milan.<br /><em>For ten days.</em>One pass.
      </h1>
      <p class="hero-sub">
        Put your venue at the centre of Milan's cocktail scene and get in front of over 1,000 new guests. Participation is completely free.
      </p>
      <a href="#form" class="btn btn--primary">Apply your bar →</a>
    </div>
  </section>

  <!-- HOW IT WORKS FOR YOUR GUESTS -------------------------- -->
  <section class="s-how" aria-labelledby="how-h2">
    <div class="how-bg-img" aria-hidden="true">
      <img src="/images/Louis Hansel Photo.jpg" alt="" width="900" height="1200" loading="lazy" />
    </div>
    <div class="how-bg-overlay" aria-hidden="true"></div>
    <div class="wrap how-inner">
      <div class="how-content">
        <div class="section-header reveal">
          <p class="overline">How it works for your guests</p>
          <h2 id="how-h2" class="section-h2">Three steps.<br />Zero operational complexity.</h2>
        </div>
        <ol class="step-list" role="list">
          {ospiteSteps.map(({ n, title, desc }) => (
            <li class="step">
              <span class="step-n" aria-hidden="true">{n}</span>
              <div class="step-body">
                <h3 class="step-title">{title}</h3>
                <p class="step-desc">{desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET ------------------------------------------ -->
  <section class="s-benefits" aria-labelledby="benefits-h2">
    <div class="wrap benefits-inner">
      <div class="benefits-lead reveal">
        <p class="overline--dark">What you get</p>
        <h2 id="benefits-h2" class="section-h2--dark">
          Real value.<br />No risk.
        </h2>
      </div>
      <div class="benefits-grid">
        {benefits.map(({ title, desc }, i) => (
          <div class="benefit-card reveal" style={`--stagger: ${i * 0.12}s`}>
            <span class="benefit-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="benefit-title">{title}</h3>
            <p class="benefit-desc">{desc}</p>
            <div class="benefit-glow" aria-hidden="true"></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT WE ASK ------------------------------------------- -->
  <section class="s-req" aria-labelledby="req-h2">
    <div class="wrap req-inner">
      <div class="req-lead reveal">
        <p class="overline">What we ask</p>
        <h2 id="req-h2" class="section-h2">
          Simple.<br />Sustainable.
        </h2>
      </div>
      <div class="req-grid">
        {requirements.map(({ label, val, sub, img }, i) => (
          <div class="req-item" style={`--req-bg: url('${img}'); --stagger: ${i * 0.12}s`}>
            <div class="req-img-overlay" aria-hidden="true"></div>
            <div class="req-content">
              <p class="req-label">{label}</p>
              <p class="req-val">{val}</p>
              <p class="req-sub">{sub}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHO WE'RE SELECTING ----------------------------------- -->
  <section class="s-criteria" aria-labelledby="criteria-h2">
    <div class="wrap criteria-inner">
      <div class="criteria-text reveal">
        <p class="overline--dark">Who we're selecting</p>
        <h2 id="criteria-h2" class="section-h2--dark">
          Quality first.<br />Everything else follows.
        </h2>
        <p class="body-text">
          We're not looking for the most famous bars in Milan.
          We're looking for the ones that do things well: considered drinks, passionate bartenders, an atmosphere worth discovering.
        </p>
      </div>
      <ul class="criteria-list reveal reveal-d1" role="list">
        {criteria.map((c) => (
          <li class="criteria-item">
            <span class="c-star" aria-hidden="true">✶</span>
            <span>{c}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- THE APP FOR YOUR BAR ---------------------------------- -->
  <section class="s-app" aria-labelledby="app-h2">
    <div class="wrap app-inner">
      <div class="app-content">
        <p class="overline--dark reveal">The app for your bar</p>
        <h2 id="app-h2" class="app-h2 reveal">Real data.<br />Active community.</h2>
        <p class="app-sub reveal reveal-d1">Analytics, reviews, map, community. All in one dashboard.</p>
        <div class="app-cards reveal reveal-d2">
          {appFeatures.map(({ step, icon, title, desc, wide }) => (
            <div class:list={['app-card', { 'app-card--wide': wide }]}>
              <div class="app-card-header">
                <span class="app-card-icon" aria-hidden="true">{icon}</span>
                <span class="app-card-step" aria-hidden="true">{step}</span>
              </div>
              <h3 class="app-card-title">{title}</h3>
              <p class="app-card-desc">{desc}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="app-mock" aria-hidden="true">
        <img
          src="/images/Google Pixel 4 Mockup/app_bar-portrait.png"
          alt=""
          class="mockup-img"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- CTA BANNER -------------------------------------------- -->
  <section class="s-cta-video" aria-labelledby="cta-video-h2">
    <video
      class="cta-video-bg"
      aria-hidden="true"
      autoplay
      muted
      loop
      playsinline
    >
      <source src="/images/Video 1920x1080 from Luca Ferrara.mp4" type="video/mp4" />
    </video>
    <div class="cta-video-overlay" aria-hidden="true"></div>
    <div class="wrap cta-video-inner">
      <span class="cta-star" aria-hidden="true">✶</span>
      <h2 id="cta-video-h2" class="cta-video-title">Apply <br />your bar</h2>
      <p class="cta-video-sub">Participation is completely free.</p>
      <a href="#form" class="cta-video-btn cta-partner">Apply your bar →</a>
    </div>
  </section>

  <!-- APPLICATION FORM -------------------------------------- -->
  <section class="s-form" id="form" aria-labelledby="form-h2">
    <div class="wrap">
      <h2 id="form-h2" class="form-heading">
        Apply your bar <span aria-hidden="true">✶</span>
      </h2>
      <p class="form-intro">
        Fill in the form. We'll reply within 5 working days,
        then set up a 30-minute call to assess the fit together.
      </p>
      <div class="tally-wrap">
        <iframe
          data-tally-src="https://tally.so/embed/vGEKJQ?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1&hideFooter=1"
          loading="lazy"
          width="100%"
          height="564"
          title="Milan Cocktail Days — Bar partner application"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- FAQ --------------------------------------------------- -->
  <section class="s-faq" aria-labelledby="faq-h2">
    <div class="wrap faq-wrap">

      <div class="faq-header reveal">
        <p class="section-kicker">FAQ</p>
        <h2 id="faq-h2" class="faq-h2">Common<br />questions.</h2>
      </div>

      <div class="faq-list reveal reveal-d1" id="faq-list">
        {faqs.map(({ q, a }) => (
          <details class="faq-item">
            <summary class="faq-q">
              {q}
              <span class="faq-icon" aria-hidden="true">✶</span>
            </summary>
            <p class="faq-a">{a}</p>
          </details>
        ))}
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ---- Reveal animations -------------------------------- */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1);
  }
  .reveal.is-visible { opacity: 1; transform: none; }
  .reveal-d1 { transition-delay: 0.12s; }
  .reveal-d2 { transition-delay: 0.24s; }
  .reveal-d3 { transition-delay: 0.38s; }

  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .step,
    .req-item { opacity: 1 !important; transform: none !important; transition: none !important; }
  }

  /* ---- All sections: local stacking context -------------- */
  section { position: relative; z-index: 0; }

  /* ---- Cinematic vignette — top shadow on non-hero sections */
  .s-how::before,
  .s-req::before,
  .s-criteria::before,
  .s-app::before,
  .s-cta-video::before,
  .s-form::before,
  .s-faq::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 80px;
    background: linear-gradient(to bottom, rgba(0,0,0,0.18), transparent);
    pointer-events: none;
    z-index: 10;
  }

  /* Hero bottom darkening toward next section */
  .s-hero::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 120px;
    background: linear-gradient(to top, rgba(0,0,0,0.5), transparent);
    pointer-events: none;
    z-index: 1;
  }

  /* ---- HERO (dark) --------------------------------------- */
  .s-hero {
    position: relative;
    min-height: 885px;
    display: flex;
    align-items: center;
    padding: var(--section-py) 0;
    overflow: hidden;
    background-color: var(--color-fumo);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-inchiostro) 45%, transparent) 0%,
      color-mix(in srgb, var(--color-inchiostro) 62%, transparent) 100%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    max-width: 720px;
    padding: 32px 40px;
    background: color-mix(in srgb, var(--color-inchiostro) 30%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid color-mix(in srgb, var(--color-panna) 14%, transparent);
    border-radius: var(--radius-md);
  }

  .hero-overline {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-panna);
    opacity: 0.65;
    margin: 0;
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-hero);
    color: var(--color-panna);
    line-height: 0.92;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .hero-h1 em {
    font-style: italic;
    color: var(--color-bitter);
  }

  .hero-sub {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    color: var(--color-pesco-300);
    line-height: 1.55;
    margin: 0;
    max-width: 480px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.875rem 2rem;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    margin-top: var(--space-sm);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.18s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--color-bitter) 28%, transparent);
  }

  .btn:active { transform: translateY(0); }

  .btn--primary {
    background-color: var(--color-bitter);
    color: var(--color-panna);
    border: 1px solid var(--color-bitter);
  }

  .btn--primary:hover {
    background-color: var(--color-bitter-500);
    border-color: var(--color-bitter-500);
  }

  .section-header { margin-bottom: var(--space-lg); }

  /* ---- HOW IT WORKS (fumo) ------------------------------ */
  .s-how {
    background-color: var(--color-fumo);
    padding: var(--section-py) 0;
    position: relative;
    overflow: hidden;
  }

  .s-how::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(ellipse 55% 45% at 85% 15%, color-mix(in srgb, var(--color-bitter) 8%, transparent), transparent),
      radial-gradient(ellipse 40% 55% at 5% 85%, color-mix(in srgb, var(--color-basilico) 12%, transparent), transparent);
  }

  .how-bg-img {
    position: absolute;
    inset: 0 0 0 20%;
    z-index: 0;
  }

  .how-bg-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .how-bg-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      108deg,
      var(--color-fumo) 35%,
      color-mix(in srgb, var(--color-fumo) 95%, transparent) 42%,
      color-mix(in srgb, var(--color-fumo) 80%, transparent) 52%,
      color-mix(in srgb, var(--color-fumo) 48%, transparent) 64%,
      color-mix(in srgb, var(--color-fumo) 12%, transparent) 80%,
      transparent 100%
    );
  }

  .how-inner {
    position: relative;
    z-index: 2;
  }

  .how-content {
    max-width: 52%;
  }

  .overline {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-panna);
    opacity: 0.65;
    margin: 0 0 var(--space-xs);
  }

  .section-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-panna);
    line-height: 1.05;
  }

  .step-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 560px;
  }

  .step {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    position: relative;
    padding-bottom: 5px;
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .step.is-visible { opacity: 1; transform: none; }
  .step:nth-child(2) { transition-delay: 0.12s; }
  .step:nth-child(3) { transition-delay: 0.24s; }

  .step:last-child { padding-bottom: 0; }

  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 31px;
    top: 64px;
    bottom: 0;
    width: 0;
    border-left: 2px dashed color-mix(in srgb, var(--color-bitter) 38%, transparent);
  }

  .step-n {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-bitter);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.15rem;
    color: var(--color-panna);
    letter-spacing: -0.02em;
    position: relative;
    z-index: 1;
    box-shadow:
      0 0 0 5px color-mix(in srgb, var(--color-bitter) 18%, transparent),
      0 4px 20px color-mix(in srgb, var(--color-bitter) 40%, transparent);
  }

  .step-body { padding-top: 18px; }

  .step-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-body);
    color: var(--color-panna);
    letter-spacing: 0.04em;
    margin-bottom: 4px;
  }

  .step-desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-pesco-300);
    line-height: 1.65;
    margin: 0;
  }

  /* ---- BENEFITS (avorio) --------------------------------- */
  .s-benefits {
    background-color: var(--color-avorio);
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-mora) 7%, transparent) 1px,
      transparent 1px
    );
    background-size: 28px 28px;
    padding: 70px 0;
    position: relative;
    overflow: hidden;
  }

  .s-benefits::before {
    content: '';
    position: absolute;
    top: -30%;
    right: -15%;
    width: 65vw;
    height: 65vw;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-bitter) 10%, transparent) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .s-benefits .wrap { position: relative; z-index: 1; }

  .benefits-inner {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .benefits-lead {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .overline--dark {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-basilico);
    margin: 0 0 var(--space-xs);
  }

  .section-h2--dark {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-mora);
    line-height: 1.05;
    margin-bottom: var(--space-sm);
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }

  .benefit-card {
    position: relative;
    background-color: var(--color-panna);
    border: 0.5px solid var(--color-panna-300);
    border-radius: var(--radius-md);
    padding: var(--space-sm) calc(var(--space-sm) * 1.25);
    overflow: hidden;
    transition:
      transform 0.38s cubic-bezier(0.16,1,0.3,1),
      box-shadow 0.38s cubic-bezier(0.16,1,0.3,1),
      border-color 0.38s ease,
      opacity 0.7s cubic-bezier(0.16,1,0.3,1);
  }

  .benefit-card:not(.is-visible) {
    transition-delay: var(--stagger, 0s);
  }

  .benefit-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 48px -10px color-mix(in srgb, var(--color-mora) 14%, transparent);
    border-color: color-mix(in srgb, var(--color-basilico) 30%, transparent);
  }

  .benefit-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-bitter), var(--color-basilico));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s cubic-bezier(0.16,1,0.3,1);
  }

