---
/**
 * Contatti / Iscrizione — pagina principale conversioni MCW
 * Struttura: Hero · Opzioni Pass · Form Tally placeholder · Info contatti
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const passFeatures = [
  'Accesso a tutti i bar partner',
  '10 serate consecutive',
  'Cocktail signature MCW in ogni bar',
  'Accesso prioritario agli eventi speciali',
];

const vipFeatures = [
  'Tutto il Pass Festival, più:',
  'Opening Gala esclusivo',
  'Masterclass con i bartender',
  'Kit benvenuto MCW',
  'Accesso lounge riservata',
];

const contatti = [
  { label: 'Generale', email: 'info@milancocktailweek.it' },
  { label: 'Press', email: 'press@milancocktailweek.it' },
  { label: 'Partnership', email: 'partner@milancocktailweek.it' },
];

const social = [
  { label: 'Instagram', href: '#', handle: '@milancocktailweek' },
  { label: 'LinkedIn', href: '#', handle: 'Milan Cocktail Week' },
];
---

<BaseLayout
  title="Iscriviti"
  description="Iscriviti a Milan Cocktail Week 2027. Pass Festival e Pass VIP disponibili. 10 serate nei migliori cocktail bar di Milano."
>

  <!-- ======================================================
       HERO — dark, compatta
       ====================================================== -->
  <section class="s-hero mcw-dot-grid" aria-label="Iscriviti a Milan Cocktail Week">
    <div class="wrap">
      <p class="overline">Prima Edizione · 2027</p>
      <div class="h1-wrap mcw-bracket">
        <h1 class="page-h1">Iscriviti</h1>
      </div>
      <p class="hero-sub">
        Accedi alle 10 serate MCW nei migliori bar di Milano
        <span aria-hidden="true">✶</span>
      </p>
    </div>
  </section>

  <!-- ======================================================
       OPZIONI PASS — chiara, 2 card affiancate
       ====================================================== -->
  <section class="s-pass" aria-labelledby="pass-heading">
    <div class="wrap">
      <div class="pass-header">
        <div class="filetto-wrap mcw-filetto-doppio"></div>
        <h2 id="pass-heading" class="section-h2">Scegli il tuo pass</h2>
        <p class="pass-intro">
          Posti limitati. Lista d'attesa aperta — il prezzo definitivo sarà comunicato
          all'apertura ufficiale delle vendite.
        </p>
      </div>

      <div class="pass-grid">
        <!-- Card 1: Pass Festival -->
        <article class="pass-card mcw-bracket" aria-labelledby="pass-festival-title">
          <div class="pass-top">
            <p class="pass-badge">Pass Festival</p>
            <div class="pass-price-wrap">
              <span class="pass-price">TBA</span>
              <span class="pass-price-sub">Prezzo da confermare</span>
            </div>
          </div>

          <ul class="pass-features" role="list">
            {passFeatures.map((f) => (
              <li class="feature">
                <span class="feature-star" aria-hidden="true">✶</span>
                <span>{f}</span>
              </li>
            ))}
          </ul>

          <a href="#form" class="btn btn--dark pass-cta">
            Iscriviti alla lista d'attesa
          </a>
          <p class="pass-note" id="pass-festival-title">
            Prenotazione non vincolante. Nessun addebito ora.
          </p>
        </article>

        <!-- Card 2: Pass VIP (borgogna) -->
        <article class="pass-card pass-card--vip mcw-bracket" aria-labelledby="pass-vip-title">
          <div class="pass-top">
            <div class="vip-header-row">
              <p class="pass-badge pass-badge--vip">Pass VIP</p>
              <span class="badge-limited">Posti Limitatissimi</span>
            </div>
            <div class="pass-price-wrap">
              <span class="pass-price">TBA</span>
              <span class="pass-price-sub">Prezzo da confermare</span>
            </div>
          </div>

          <ul class="pass-features" role="list">
            {vipFeatures.map((f, i) => (
              <li class:list={['feature', { 'feature--intro': i === 0 }]}>
                {i > 0 && <span class="feature-star" aria-hidden="true">✶</span>}
                <span>{f}</span>
              </li>
            ))}
          </ul>

          <a href="#form" class="btn btn--avorio pass-cta">
            Iscriviti alla lista VIP
          </a>
          <p class="pass-note pass-note--vip" id="pass-vip-title">
            Prenotazione non vincolante. Nessun addebito ora.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ======================================================
       FORM — dark, placeholder Tally.so
       ====================================================== -->
  <section class="s-form" id="form" aria-labelledby="form-heading">
    <div class="wrap">
      <h2 id="form-heading" class="section-h2--light">
        Lascia i tuoi dati <span aria-hidden="true">✶</span>
      </h2>
      <p class="form-intro">
        Compila il form per iscriverti alla lista d'attesa.
        Ti contatteremo appena le vendite saranno aperte.
      </p>

      <!-- Sostituire con embed Tally.so quando pronto -->
      <div class="tally-placeholder" role="region" aria-label="Form iscrizione">
        <p class="tally-label">Form iscrizione</p>
        <div class="tally-fields" aria-hidden="true">
          <div class="tally-field">
            <span class="tally-field-label">Nome</span>
            <div class="tally-field-input"></div>
          </div>
          <div class="tally-field">
            <span class="tally-field-label">Email</span>
            <div class="tally-field-input"></div>
          </div>
          <div class="tally-field">
            <span class="tally-field-label">Tipo di pass</span>
            <div class="tally-field-input"></div>
          </div>
          <div class="tally-field tally-field--full">
            <span class="tally-field-label">Messaggio (opzionale)</span>
            <div class="tally-field-input tally-field-input--textarea"></div>
          </div>
        </div>
        <p class="tally-note">
          ⬆ Configurare su
          <a href="https://tally.so" target="_blank" rel="noopener noreferrer" class="tally-link">
            tally.so
          </a>
          e sostituire questo div con lo snippet embed.
        </p>
      </div>
    </div>
  </section>

  <!-- ======================================================
       INFO CONTATTI — chiara, 3 colonne
       ====================================================== -->
  <section class="s-info" aria-labelledby="info-heading">
    <div class="wrap">
      <div class="info-header mcw-filetto-doppio"></div>
      <h2 id="info-heading" class="section-h2">Contatti diretti</h2>

      <div class="info-grid">
        {contatti.map(({ label, email }) => (
          <div class="info-col">
            <p class="info-label">{label}</p>
            <a href={`mailto:${email}`} class="info-email">{email}</a>
          </div>
        ))}
      </div>

      <!-- Social -->
      <div class="social-row">
        {social.map(({ label, href, handle }) => (
          <a href={href} class="social-link" target="_blank" rel="noopener noreferrer">
            <span class="social-platform">{label}</span>
            <span class="social-handle">{handle}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ---- Tipografia --------------------------------------- */
  .overline {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-oro);
    opacity: 0.8;
    margin: 0 0 var(--space-xs);
  }

  .section-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-fumo);
    line-height: 1.05;
  }

  .section-h2--light {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-avorio);
    line-height: 1.05;
    margin-bottom: var(--space-sm);
  }

  .section-h2--light span {
    color: var(--color-oro);
    font-size: 0.5em;
    vertical-align: middle;
  }

  /* ---- Bottoni ------------------------------------------ */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 2rem;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    width: 100%;
  }

  .btn--dark {
    background-color: var(--color-fumo);
    color: var(--color-avorio);
    border: 1px solid var(--color-fumo);
  }

  .btn--dark:hover {
    background-color: transparent;
    color: var(--color-fumo);
  }

  .btn--avorio {
    background-color: var(--color-avorio);
    color: var(--color-borgogna);
    border: 1px solid var(--color-avorio);
  }

  .btn--avorio:hover {
    background-color: transparent;
    color: var(--color-avorio);
  }

  /* ---- HERO -------------------------------------------- */
  .s-hero {
    background-color: var(--color-fumo);
    padding: var(--section-py) 0;
    min-height: 50svh;
    display: flex;
    align-items: center;
  }

  .page-h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-avorio);
    line-height: 1.05;
    margin: 0;
  }

  .h1-wrap {
    padding: var(--space-sm) var(--space-md);
    margin: var(--space-xs) 0;
  }

  .hero-sub {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-pietra);
    letter-spacing: 0.06em;
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .hero-sub span {
    color: var(--color-oro);
    font-size: 0.45rem;
    line-height: 1.8;
  }

  /* ---- PASS -------------------------------------------- */
  .s-pass {
    background-color: var(--color-avorio);
    padding: var(--section-py) 0;
  }

  .pass-header {
    margin-bottom: var(--space-lg);
  }

  .filetto-wrap {
    width: 60px;
    margin-bottom: var(--space-md);
  }

  .pass-intro {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-grafite);
    line-height: 1.65;
    max-width: 580px;
    margin: var(--space-sm) 0 0;
  }

  .pass-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    align-items: start;
  }

  /* Card base: sfondo lino */
  .pass-card {
    background-color: var(--color-lino);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* Card VIP: sfondo borgogna */
  .pass-card--vip {
    background-color: var(--color-borgogna);
  }

  .pass-top {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .pass-badge {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-grafite);
    margin: 0;
  }

  .pass-badge--vip {
    color: var(--color-avorio);
    opacity: 0.7;
  }

  .vip-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
  }

  .badge-limited {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    background-color: var(--color-oro);
    color: var(--color-fumo);
    white-space: nowrap;
  }

  .pass-price-wrap {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
  }

  .pass-price {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3rem, 5vw, 4.5rem);
    color: var(--color-oro);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .pass-card--vip .pass-price {
    color: var(--color-avorio);
  }

  .pass-price-sub {
    font-family: var(--font-body);
    font-size: var(--text-label);
    color: var(--color-grafite);
    opacity: 0.7;
  }

  .pass-card--vip .pass-price-sub {
    color: var(--color-avorio);
    opacity: 0.6;
  }

  /* Feature list */
  .pass-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    border-top: 0.5px solid color-mix(in srgb, var(--color-grafite) 30%, transparent);
    padding-top: var(--space-sm);
  }

  .pass-card--vip .pass-features {
    border-top-color: color-mix(in srgb, var(--color-avorio) 20%, transparent);
  }

  .feature {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-grafite);
    line-height: 1.5;
  }

  .pass-card--vip .feature {
    color: var(--color-avorio);
    opacity: 0.9;
  }

  .feature--intro {
    font-weight: 700;
    opacity: 0.7;
    font-style: italic;
  }

  .feature-star {
    color: var(--color-oro);
    font-size: 0.5rem;
    line-height: 1.8;
    flex-shrink: 0;
  }

  .pass-cta {
    margin-top: auto;
  }

  .pass-note {
    font-family: var(--font-body);
    font-size: var(--text-label);
    color: var(--color-grafite);
    opacity: 0.6;
    text-align: center;
    margin: 0;
  }

  .pass-note--vip {
    color: var(--color-avorio);
  }

  /* ---- FORM -------------------------------------------- */
  .s-form {
    background-color: var(--color-fumo);
    padding: var(--section-py) 0;
    scroll-margin-top: 64px; /* compensa l'header sticky */
  }

  .form-intro {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-pietra);
    line-height: 1.65;
    max-width: 560px;
    margin: 0 0 var(--space-lg);
    opacity: 0.85;
  }

  /* Placeholder Tally.so — sostituire con snippet embed */
  .tally-placeholder {
    border: var(--border-hairline);
    border-radius: var(--radius-md);
    padding: 48px;
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .tally-label {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-oro);
    opacity: 0.6;
    margin: 0;
  }

  .tally-fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
  }

  .tally-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .tally-field--full {
    grid-column: 1 / -1;
  }

  .tally-field-label {
    font-family: var(--font-body);
    font-size: var(--text-label);
    color: var(--color-pietra);
    opacity: 0.5;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .tally-field-input {
    height: 40px;
    background-color: var(--color-marmo);
    border: var(--border-hairline);
    border-color: color-mix(in srgb, var(--color-pietra) 20%, transparent);
    border-radius: var(--radius-sm);
  }

  .tally-field-input--textarea {
    height: 100px;
  }

  .tally-note {
    font-family: var(--font-body);
    font-size: var(--text-label);
    color: var(--color-pietra);
    opacity: 0.4;
    margin: 0;
  }

  .tally-link {
    color: var(--color-oro);
    opacity: 0.6;
    text-decoration: none;
  }

  .tally-link:hover { opacity: 1; }

  /* ---- INFO CONTATTI ----------------------------------- */
  .s-info {
    background-color: var(--color-avorio);
    padding: var(--section-py) 0;
  }

  .info-header {
    width: 60px;
    margin-bottom: var(--space-lg);
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    margin: var(--space-md) 0 var(--space-lg);
    padding-top: var(--space-md);
    border-top: 0.5px solid color-mix(in srgb, var(--color-grafite) 25%, transparent);
  }

  .info-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .info-label {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-grafite);
    margin: 0;
    opacity: 0.6;
  }

  .info-email {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-fumo);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .info-email:hover {
    color: var(--color-borgogna);
  }

  .social-row {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    padding-top: var(--space-md);
    border-top: 0.5px solid color-mix(in srgb, var(--color-grafite) 20%, transparent);
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .social-link:hover { opacity: 0.6; }

  .social-platform {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-grafite);
    opacity: 0.6;
  }

  .social-handle {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-fumo);
  }

  /* ---- RESPONSIVE -------------------------------------- */
  @media (max-width: 768px) {
    .pass-grid {
      grid-template-columns: 1fr;
    }

    .info-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .tally-fields {
      grid-template-columns: 1fr;
    }

    .tally-field--full {
      grid-column: 1;
    }

    .tally-placeholder {
      padding: var(--space-md);
    }
  }
</style>
