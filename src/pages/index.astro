</style>

<script>
  // FAQ accordion: close others on open
  document.querySelectorAll('.faq-item').forEach(detail => {
    detail.addEventListener('toggle', () => {
      if ((detail as HTMLDetailsElement).open) {
        document.querySelectorAll('.faq-item').forEach(other => {
          if (other !== detail) (other as HTMLDetailsElement).open = false;
        });
      }
    });
  });

  function makeVisible(el: Element) {
    el.classList.add('is-visible');
  }

  // Wait for first paint — prevents observer firing before layout is stable
  requestAnimationFrame(() => {
    // Per chi è: stagger on section entry
    const perchiSection = document.querySelector('.s-perchi');
    if (perchiSection) {
      const perchiRevealEls = perchiSection.querySelectorAll('.perchi-reveal, .perchi-img-reveal');
      const perchiObs = new IntersectionObserver(
        entries => {
          if (entries[0].isIntersecting) {
            perchiRevealEls.forEach(makeVisible);
            perchiObs.disconnect();
          }
        },
        { threshold: 0.1 }
      );
      perchiObs.observe(perchiSection);
    }

    // How-section cards
    const howCards = document.querySelectorAll('.how-card');
    if (howCards.length) {
      const io = new IntersectionObserver(
        entries => entries.forEach(e => { if (e.isIntersecting) { makeVisible(e.target); io.unobserve(e.target); } }),
        { threshold: 0.05 }
      );
      howCards.forEach(c => io.observe(c));
    }

    // Universal .reveal
    const revealEls = document.querySelectorAll('.reveal');
    if (revealEls.length) {
      const revealObs = new IntersectionObserver(
        entries => entries.forEach(e => { if (e.isIntersecting) { makeVisible(e.target); revealObs.unobserve(e.target); } }),
        { threshold: 0.05 }
      );
      revealEls.forEach(el => revealObs.observe(el));

      // Safety fallback: show any still-hidden elements after 2.5s
      setTimeout(() => {
        document.querySelectorAll('.reveal:not(.is-visible), .how-card:not(.is-visible), .perchi-reveal:not(.is-visible), .perchi-img-reveal:not(.is-visible)').forEach(makeVisible);
      }, 2500);
    }
  });

  // Hero parallax — reduced-motion safe, passive scroll
  const heroBgImg = document.querySelector<HTMLImageElement>('.hero-bg img');
  if (heroBgImg && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    window.addEventListener('scroll', () => {
      heroBgImg.style.transform = `translateY(${window.scrollY * 0.22}px)`;
    }, { passive: true });
  }
</script>
