  }

  /* Hero: bottom darkens toward the how section below */
  .s-hero::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 120px;
    background: linear-gradient(to top, rgba(0,0,0,0.55), transparent);
    pointer-events: none;
    z-index: 1;
  }
  .hero-inner { z-index: 3; }

  /* Ensure content wrappers are above vignette layers */
  .s-how .wrap    { position: relative; z-index: 3; }
  .why-wrap       { position: relative; z-index: 3; }
  .perchi-layout  { position: relative; z-index: 3; }
  .s-bars .wrap   { position: relative; z-index: 3; }
  .app-inner      { position: relative; z-index: 3; }
  .quotes-header,
  .quotes-outer   { position: relative; z-index: 3; }
  .s-lista .wrap  { position: relative; z-index: 3; }
  .faq-wrap       { position: relative; z-index: 3; }

  /* ── QUOTES: ambient mesh tint ────────────────────────────── */
  .s-quotes {
