---
import BaseLayout from '../layouts/BaseLayout.astro';

const steps = [
  {
    n: '01',
    title: 'Prendi il pass',
    desc: "Un pass, valido per tutti i dieci giorni. Early bird da €15 — si compra una volta sola.",
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="9" width="28" height="14" rx="2"/><line x1="10" y1="9" x2="10" y2="23" stroke-dasharray="3 3" opacity="0.6"/><circle cx="2" cy="16" r="2.5" fill="currentColor" stroke="none" opacity="0.25"/><circle cx="30" cy="16" r="2.5" fill="currentColor" stroke="none" opacity="0.25"/></svg>`,
  },
  {
    n: '02',
    title: 'Scegli i bar',
    desc: "Trenta locali da Brera a NoLo. Nessuna prenotazione, nessun itinerario fisso.",
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M16 3C11.6 3 8 6.6 8 11c0 6 8 18 8 18s8-12 8-18c0-4.4-3.6-8-8-8z"/><circle cx="16" cy="11" r="2.5"/></svg>`,
  },
  {
    n: '03',
    title: 'Bevi il Cocktail Days',
    desc: "Il cocktail esclusivo del bar, servito solo in questi dieci giorni. €6, ovunque.",
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M5 4h22L16 17 5 4z"/><line x1="16" y1="17" x2="16" y2="25"/><line x1="10" y1="28" x2="22" y2="28"/></svg>`,
  },
];

const criteria = [
  {
    title: 'Cocktail come mestiere.',
    desc: 'La miscelazione prima del concept, della musica, dei selfie.',
  },
  {
    title: 'Quartieri vivi.',
    desc: 'Da Brera a Lambrate, dai Navigli a NoLo. Milano non è solo il centro.',
  },
  {
    title: 'Voci della scena.',
    desc: "Non nomi su un'insegna: persone con cui si parla.",
  },
];

const appFeatures = [
  {
    title: 'Acquista il biglietto.',
    desc: "Acquista il tuo biglietto e ottieni l'accesso all'app con tutti gli oltre 60 bar partecipanti e i loro cocktail del festival. Il tuo biglietto ti accompagnerà per 18 giorni durante tutto il festival.",
  },
  {
    title: 'Scopri i bar e i cocktail.',
    desc: "Nell'app puoi vedere quali bar partecipano e quale signature cocktail puoi sbloccare lì. Ogni bar crea un cocktail unico, disponibile solo durante il festival.",
  },
  {
    title: 'Scansiona e ordina.',
    desc: "Scansiona il codice QR al bar con l'app, sblocca il signature cocktail e ordinalo direttamente sul posto a 6 €.",
  },
];

const quotes = [
  { text: 'Finalmente un evento come la London Cocktail Week a Milano!', name: 'Giulia', age: 25 },
  { text: 'Cocktail a €6 è già abbastanza per comprare il biglietto', name: 'Marco', age: 24 },
  { text: 'Una scusa per uscire durante la settimana a Milano', name: 'Elena', age: 30 },
  { text: 'Sembra un modo carino per scoprire nuovi bar', name: 'Luca', age: 34 },
];

const faqs = [
  {
    q: 'Iscrivermi alla lista significa che ho già comprato il pass?',
    a: "No. La lista d'attesa è solo un'email-promemoria. Quando aprono i pass, ti scriviamo per primi.",
  },
  {
    q: 'Quanto costa il pass?',
    a: 'I primi (super early bird) partono da €15. Quando finiscono, il prezzo standard è €30.',
  },
  {
    q: "Quando esattamente si svolge l'evento?",
    a: 'Dieci giorni di maggio 2027. Le date precise le annunciamo a chi è in lista, prima di tutti.',
  },
  {
    q: "Cos'è il Cocktail Days? È un cocktail scontato?",
    a: "No. È un cocktail che il bar inventa apposta per la settimana — una ricetta nuova, servita solo nei dieci giorni dell'evento, allo stesso prezzo in tutti i trenta bar: €6.",
  },
  {
    q: 'Cosa è incluso nel pass?',
    a: "L'accesso ai trenta bar partner per l'intera durata dell'evento, e il diritto a ordinare il Cocktail Days a €6 — in ogni bar, quante volte vuoi.",
  },
  {
    q: 'Devo prenotare nei bar?',
    a: 'No. Entri quando vuoi, mostri il pass, ordini.',
  },
  {
    q: "Serve l'app?",
    a: "No. Il pass basta. L'app è un compagno di strada, non un requisito.",
  },
  {
    q: 'Posso regalare o trasferire il pass?',
    a: "Stiamo lavorando alla regalistica. I dettagli arrivano all'apertura delle vendite — anche su questo, chi è in lista lo sa per primo.",
  },
];

const milanDots = [
  { x: 175, y: 130 }, { x: 185, y: 142 }, { x: 170, y: 150 },
  { x: 196, y: 112 }, { x: 212, y: 120 },
  { x: 242, y: 118 }, { x: 256, y: 128 }, { x: 250, y: 108 },
  { x: 158, y: 232 }, { x: 170, y: 246 }, { x: 162, y: 220 },
  { x: 215, y: 258 }, { x: 226, y: 268 }, { x: 234, y: 250 },
  { x: 290, y: 180 }, { x: 302, y: 194 }, { x: 285, y: 167 },
  { x: 188, y: 158 }, { x: 200, y: 162 },
  { x: 136, y: 176 }, { x: 128, y: 166 }, { x: 142, y: 190 },
  { x: 252, y: 162 }, { x: 264, y: 172 },
  { x: 154, y: 92  }, { x: 168, y: 102 },
  { x: 205, y: 198 }, { x: 216, y: 186 },
  { x: 266, y: 146 }, { x: 200, y: 215 },
];
---

<BaseLayout
  title="Milano Cocktail Days — Trenta bar, dieci giorni, un pass."
  description="Maggio 2027: trenta bar di Milano, dieci giorni, un cocktail inventato apposta in ogni bancone a €6. Mettiti in lista per i primi pass a €15."
  pageType="event"
>

  <!-- S01 · HERO ─────────────────────────────────────────────── -->
  <section class="s-hero" aria-labelledby="home-h1">
    <picture class="hero-bg" aria-hidden="true">
      <img
        src="/images/bar_photo1.jpg"
        alt=""
        width="1920" height="1080"
        fetchpriority="high" loading="eager"
      />
    </picture>
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="wrap hero-inner">
      <img src="/logos/logo_3_v.FINAL/Panna.svg" alt="Milan Cocktail Days" class="hero-logo" />

      <p class="hero-overline">
        Milano <span aria-hidden="true">✶</span> Maggio 2027 <span aria-hidden="true">✶</span> Prima Edizione
      </p>

      <div class="hero-h1-wrap mcw-bracket">
        <h1 id="home-h1" class="hero-h1">
          Trenta bar di Milano.<br />Per dieci giorni.<br />Un pass.
        </h1>
      </div>

      <p class="hero-sub">
        Ogni bar inventa un cocktail solo per te. €6 l'uno, solo nei dieci giorni di maggio.
        Mettiti in lista - i primi pass partono da €15.
      </p>

      <a href="#lista" class="btn btn--primary">
        Entra in lista d'attesa <span aria-hidden="true">✶</span>
      </a>
    </div>
  </section>

  <!-- S02 · COME FUNZIONA ────────────────────────────────────── -->
  <section class="s-how" aria-labelledby="how-h2">
    <div class="wrap">

      <div class="how-header">
        <p class="section-kicker section-kicker--light">Come funziona</p>
        <h2 id="how-h2" class="how-h2">Tre cose,<br />niente di più.</h2>
      </div>

      <div class="how-steps">
        {steps.map(({ n, icon, title, desc }) => (
          <article class="how-card js-reveal">
            <div class="how-card-num" aria-hidden="true">{n}</div>
            <div class="how-card-divider" aria-hidden="true"></div>
            <div class="how-card-icon" aria-hidden="true" set:html={icon} />
            <h3 class="how-card-title">{title}</h3>
            <p class="how-card-desc">{desc}</p>
          </article>
        ))}
      </div>

      <div class="how-footer">
        <p class="how-strap">
          Trenta bar. Trenta cocktail unici. Solo dentro MCD.
          <span aria-hidden="true">✶</span>
        </p>
        <a href="#lista" class="btn btn--primary how-cta">
          Prendi il pass <span aria-hidden="true">✶</span>
        </a>
      </div>

    </div>
  </section>

  <!-- S03 · PERCHÉ ISCRIVERSI ────────────────────────────────── -->
  <section class="s-why" aria-labelledby="why-h2">
    <div class="why-texture" aria-hidden="true"></div>
    <div class="wrap why-wrap">

      <div class="why-editorial">
        <p class="section-kicker why-kicker">Lista d'attesa <span aria-hidden="true">✶</span> Accesso anticipato</p>
        <h2 id="why-h2" class="why-h2">
          I primi<br />
          <em class="why-em">entrano prima</em><span class="why-dot">.</span>
        </h2>
        <p class="why-sub">E pagano meno.</p>
        <p class="why-body">Accesso anticipato + prezzo launch riservato ai primi iscritti.</p>

        <div class="why-proof">
          <div class="proof-avatars" aria-hidden="true">
            <span class="avatar av-1"></span>
            <span class="avatar av-2"></span>
            <span class="avatar av-3"></span>
          </div>
          <p class="proof-copy"><strong class="proof-n">347</strong> già in lista</p>
        </div>

        <a href="#lista" class="btn btn--dark">
          Entra nella lista <span aria-hidden="true">✶</span>
        </a>
      </div>

      <div class="why-panel-outer">
        <div class="why-panel">
          <div class="panel-badge">
            <span class="panel-dot" aria-hidden="true"></span>
            Accesso anticipato
          </div>

          <div class="panel-price">
            <span class="price-from">Da</span>
            <span class="price-main">€15</span>
            <span class="price-was">€30</span>
          </div>

          <div class="panel-alloc">
            <div class="alloc-row">
              <span class="alloc-lbl">Allocazione</span>
              <span class="alloc-pct">67% assegnata</span>
            </div>
            <div class="alloc-track" aria-hidden="true">
              <div class="alloc-fill"></div>
            </div>
            <p class="alloc-rest">53 accessi rimasti <span aria-hidden="true">✶</span></p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- CINEMATIC BANNER ───────────────────────────────────────── -->
  <div class="cinematic-banner" aria-hidden="true">
    <img
      src="/images/Cocktail Landing Page Image May 15 2026.png"
      alt=""
      class="cinematic-img"
      loading="lazy"
      width="1920" height="1080"
    />
    <div class="cinematic-overlay"></div>
    <div class="cinematic-caption">
      <span class="cinematic-text">Milano, Maggio 2027</span>
      <span class="cinematic-rule" aria-hidden="true"></span>
    </div>
  </div>

  <!-- S05 · PER CHI È ────────────────────────────────────────── -->
  <section class="s-perchi" aria-labelledby="perchi-h2">
    <div class="perchi-layout">

      <div class="perchi-content">
        <p class="section-kicker section-kicker--light">Per chi è</p>
        <h2 id="perchi-h2" class="perchi-h2">
          Per chi ama<br />Milano.<br />E per chi vuole<br />conoscerla meglio.
        </h2>
        <p class="perchi-lead">
          MCD non è per gli addetti ai lavori. È per chi al bancone ci sta bene,
          sa o non sa quello che ordina, e ha voglia di fare un giro che valga la pena.
        </p>

        <ul class="perchi-occasions" role="list">
          <li class="perchi-occasion">Per il sabato pomeriggio con chi ti piace.</li>
          <li class="perchi-occasion">Per una serata diversa con gli amici di sempre.</li>
          <li class="perchi-occasion">Per chi è curioso e non sa da dove iniziare.</li>
        </ul>

        <p class="perchi-close">
          Nessun dress code. Nessun esame. Solo bicchieri e bar che vale la pena conoscere.
          <span aria-hidden="true">✶</span>
        </p>
      </div>

      <div class="perchi-image-col" aria-hidden="true">
        <div class="perchi-image-wrap">
          <img
            src="/images/Person Holding Glass Photo.jpg"
            alt=""
            class="perchi-img"
            loading="lazy"
            width="800" height="1000"
          />
          <div class="perchi-image-overlay"></div>
        </div>
      </div>

    </div>
  </section>

  <!-- S06a · I BAR PARTNER ───────────────────────────────────── -->
  <section class="s-bars" aria-labelledby="bars-h2">
    <div class="wrap">

      <div class="bars-header">
        <p class="section-kicker">I bar partner</p>
        <h2 id="bars-h2" class="bars-h2">Non tutti i bar<br />di Milano.<br />I trenta che contano.</h2>
      </div>

      <div class="bars-layout">

        <div class="bars-left">
          <p class="bars-lead">
            Stiamo costruendo la mappa. Bar indipendenti, bartender con un'idea, cocktail che
            parlano. Quando i primi nomi saranno sul tavolo, chi è in lista li legge per primo.
          </p>

          <div class="criteria-list">
            {criteria.map(({ title, desc }) => (
              <div class="criterion">
                <h3 class="criterion-title">{title}</h3>
                <p class="criterion-desc">{desc}</p>
              </div>
            ))}
          </div>

          <a href="#lista" class="btn btn--outline">
            Iscriviti per saperlo prima <span aria-hidden="true">✶</span>
          </a>
        </div>

        <div class="bars-right">
          <div class="bars-visual">
            <div class="bars-photo-wrap">
              <img
                src="/images/Timothe Durand Photo from Unsplash.jpg"
                alt="Bartender al lavoro a Milano"
                class="bars-photo"
                loading="lazy"
                width="600" height="750"
              />
            </div>
            <figure class="map-figure">
              <svg
                viewBox="0 0 400 360"
                class="milan-map"
                aria-hidden="true"
                role="presentation"
              >
                <path
                  d="M 80 120 Q 110 65 170 55 Q 225 46 285 68 Q 345 88 362 145 Q 378 185 360 245 Q 340 295 278 315 Q 218 335 158 315 Q 98 294 80 248 Q 62 195 80 120 Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  opacity="0.2"
                />
                {milanDots.map(({ x, y }) => (
                  <circle
                    cx={x}
                    cy={y}
                    r="5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    opacity="0.6"
                  />
                ))}
              </svg>
              <figcaption class="map-caption">
                In aggiornamento — i primi nomi a giorni. <span aria-hidden="true">✶</span>
              </figcaption>
            </figure>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- S06b · L'APP ───────────────────────────────────────────── -->
  <section class="s-app" aria-labelledby="app-h2">
    <div class="app-layout">

      <div class="app-image-col" aria-hidden="true">
        <img
          src="/images/Carson Masterson Photo.jpg"
          alt=""
          class="app-img"
          loading="lazy"
          width="800" height="1000"
        />
        <div class="app-image-overlay"></div>
      </div>

      <div class="app-content-col">
        <div class="app-content-inner">
          <p class="section-kicker section-kicker--light">L'app</p>
          <h2 id="app-h2" class="app-h2">Un'app che ti accompagna in giro.</h2>
          <p class="app-sub">
            Accedi ai drink dell'evento, raccogli i tuoi punti e riscatta i premi dei partner.
          </p>

          <div class="app-features">
            {appFeatures.map(({ title, desc }) => (
              <div class="app-feature">
                <h3 class="app-feature-title">{title}</h3>
                <p class="app-feature-desc">{desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- S07 · VOCI DALLA LISTA ─────────────────────────────────── -->
  <section class="s-quotes" aria-labelledby="quotes-h2">
    <div class="wrap quotes-header">
      <div class="quotes-heading-group">
        <p class="section-kicker">Voci dalla lista</p>
        <h2 id="quotes-h2" class="quotes-h2">Cosa dice chi si è già registrato</h2>
      </div>
      <p class="quotes-counter" aria-live="polite">
        <strong class="counter-num" id="counter-quotes">347</strong> già in lista
      </p>
    </div>

    <div class="quotes-outer">
      <div class="quotes-track" id="quotes-track" role="list">
        {quotes.map(({ text, name, age }) => (
          <article class="quote-card" role="listitem">
            <span class="quote-mark" aria-hidden="true">"</span>
            <blockquote class="quote-text">"{text}"</blockquote>
            <footer class="quote-author">— {name}, {age}</footer>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- S08 · CTA FINALE ───────────────────────────────────────── -->
  <section class="s-cta-final" aria-labelledby="cta-final-h2">
    <picture class="cta-bg" aria-hidden="true">
      <img
        src="/images/Photo by Mahyaddin Jabbarli.jpg"
        alt=""
        class="cta-bg-img"
        loading="lazy"
        width="1920" height="1080"
      />
    </picture>
    <div class="cta-overlay" aria-hidden="true"></div>
    <div class="wrap cta-final-inner">
      <p class="section-kicker section-kicker--light">Milano, Maggio 2027</p>
      <h2 id="cta-final-h2" class="cta-final-h2">
        Sii il primo<br />a sapere.
      </h2>
      <a href="#lista" class="btn btn--final">
        Entra in lista d'attesa <span aria-hidden="true">✶</span>
      </a>
      <p class="cta-trust">Ti scriviamo solo quando aprono i pass. Niente spam, parola.</p>
    </div>
  </section>

  <!-- S09 · FAQ ──────────────────────────────────────────────── -->
  <section class="s-faq" aria-labelledby="faq-h2">
    <div class="wrap faq-wrap">

      <div class="faq-header">
        <p class="section-kicker">FAQ</p>
        <h2 id="faq-h2" class="faq-h2">Domande,<br />in due righe.</h2>
      </div>

      <div class="faq-list" id="faq-list">
        {faqs.map(({ q, a }) => (
          <details class="faq-item">
            <summary class="faq-q">
              {q}
              <span class="faq-icon" aria-hidden="true">✶</span>
            </summary>
            <p class="faq-a">{a}</p>
          </details>
        ))}
      </div>

    </div>
  </section>

  <!-- FORM ───────────────────────────────────────────────────── -->
  <section class="s-lista" id="lista" aria-labelledby="lista-h2">
    <div class="wrap lista-wrap">

      <div class="lista-header">
        <p class="section-kicker section-kicker--light">Accesso anticipato</p>
        <h2 id="lista-h2" class="lista-h2">
          Lista d'attesa <span aria-hidden="true">✶</span>
        </h2>
        <p class="lista-intro">
          Iscriviti gratuitamente. Ti contatteremo per primo all'apertura ufficiale dei pass.
        </p>
      </div>

      <div class="tally-wrap">
        <iframe
          data-tally-src="https://tally.so/embed/Y5pkp5?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1&hideFooter=1"
          loading="lazy"
          width="100%"
          height="689"
          title="Milan Cocktail Days — Lista d'attesa partecipanti"
        ></iframe>
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  /* ─── WRAP ────────────────────────────────────────────────── */
  .wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ─── SECTION KICKER ──────────────────────────────────────── */
  .section-kicker {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-basilico);
    margin: 0 0 var(--space-sm);
    display: block;
  }
  .section-kicker--light {
    color: var(--color-pesco-300);
    opacity: 0.8;
  }

  /* ─── SHARED BTN ──────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.9rem 2.25rem;
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease, transform 0.2s ease;
    margin-top: var(--space-sm);
  }

  .btn:hover { transform: translateY(-1px); }

  .btn--primary {
    background-color: var(--color-bitter);
    color: var(--color-panna);
    border: 1px solid var(--color-bitter);
  }
  .btn--primary:hover {
    background-color: var(--color-bitter-500);
    border-color: var(--color-bitter-500);
  }

  .btn--dark {
    background-color: var(--color-mora);
    color: var(--color-panna);
    border: 1px solid var(--color-mora);
  }
  .btn--dark:hover {
    background-color: var(--color-inchiostro);
    border-color: var(--color-inchiostro);
  }

  .btn--outline {
    background-color: transparent;
    color: var(--color-mora);
    border: 1px solid color-mix(in srgb, var(--color-mora) 35%, transparent);
  }
  .btn--outline:hover {
    background-color: var(--color-mora);
    color: var(--color-panna);
    border-color: var(--color-mora);
  }

  .btn--final {
    background-color: var(--color-bitter);
    color: var(--color-panna);
    border: 1px solid var(--color-bitter);
    font-size: var(--text-small);
    padding: 1.1rem 3rem;
    margin-top: 0;
  }
  .btn--final:hover {
    background-color: var(--color-bitter-500);
    border-color: var(--color-bitter-500);
  }

  /* ─── HERO ────────────────────────────────────────────────── */
  .s-hero {
    position: relative;
    min-height: 80svh;
    display: flex;
    align-items: center;
    padding: clamp(2rem, 5vw, 4rem) 0;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 80% center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-inchiostro) 55%, transparent) 0%,
      color-mix(in srgb, var(--color-inchiostro) 15%, transparent) 30%,
      transparent 60%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    max-width: 100%;
    margin: 0 auto;
    padding: 24px 40px;
    background: color-mix(in srgb, var(--color-panna) 8%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid color-mix(in srgb, var(--color-panna) 20%, transparent);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .hero-logo {
    height: auto;
    width: 500px;
    display: block;
    object-fit: contain;
    margin-bottom: var(--space-md);
  }

  .hero-overline {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-panna);
    margin: 0;
  }

  .hero-h1-wrap {
    padding: var(--space-sm) var(--space-md);
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 4.5vw, 4rem);
    color: var(--color-panna);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .hero-sub {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    color: var(--color-pesco-300);
    line-height: 1.6;
    margin: 0;
    max-width: 480px;
  }

  /* ─── COME FUNZIONA ───────────────────────────────────────── */
  .s-how {
    background-color: var(--color-mora);
    padding: clamp(5rem, 10vw, 9rem) 0;
    position: relative;
    overflow: hidden;
  }

  .s-how::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-panna) 6%, transparent) 1px,
      transparent 1px
    );
    background-size: 24px 24px;
    pointer-events: none;
    z-index: 0;
  }

  .s-how .wrap { position: relative; z-index: 1; }

  .how-header {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .how-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3.5rem, 9vw, 7rem);
    color: var(--color-panna);
    line-height: 0.92;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .how-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background-color: color-mix(in srgb, var(--color-panna) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-panna) 10%, transparent);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .how-card {
    background-color: var(--color-mora);
    padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease, background-color 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .how-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(to right, var(--color-bitter), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .how-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .how-card:nth-child(2) { transition-delay: 0.1s; }
  .how-card:nth-child(3) { transition-delay: 0.2s; }

  .how-card:hover {
    background-color: color-mix(in srgb, var(--color-panna) 4%, var(--color-mora));
  }
  .how-card:hover::before { opacity: 1; }

  .how-card-num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3rem, 6vw, 5rem);
    color: var(--color-bitter);
    line-height: 1;
    letter-spacing: -0.04em;
    opacity: 0.35;
  }

  .how-card-divider {
    width: 2rem;
    height: 1px;
    background-color: color-mix(in srgb, var(--color-bitter) 40%, transparent);
  }

  .how-card-icon {
    color: var(--color-panna);
    opacity: 0.3;
    width: 1.75rem;
    height: 1.75rem;
  }
  .how-card-icon :global(svg) { width: 100%; height: 100%; }

  .how-card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    color: var(--color-panna);
    letter-spacing: 0;
    margin: 0;
    line-height: 1.2;
  }

  .how-card-desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-pesco-300);
    line-height: 1.7;
    margin: 0;
    opacity: 0.8;
  }

  .how-footer {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 0.5px solid color-mix(in srgb, var(--color-panna) 15%, transparent);
  }

  .how-strap {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1rem, 2vw, 1.4rem);
    color: var(--color-panna);
    line-height: 1.3;
    margin: 0;
    flex: 1;
    opacity: 0.75;
  }

  .how-cta { margin-top: 0; flex-shrink: 0; }

  /* ─── PERCHÉ ISCRIVERSI ───────────────────────────────────── */
  @keyframes fadeUpWhy {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes floatPanel {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-8px); }
  }

  @keyframes allocIn {
    from { width: 0; }
    to   { width: 67%; }
  }

  @keyframes dotPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.4; transform: scale(0.75); }
  }

  .s-why {
    background: var(--color-panna);
    padding: clamp(5rem, 10vw, 9rem) 0;
    position: relative;
    overflow: hidden;
  }

  .why-texture {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-basilico) 6%, transparent) 1px,
      transparent 1px
    );
    background-size: 20px 20px;
    z-index: 0;
  }

  .why-wrap {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 0.75fr;
    gap: clamp(3rem, 8vw, 8rem);
    align-items: center;
  }

  .why-editorial {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    animation: fadeUpWhy 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .why-kicker { color: var(--color-basilico); opacity: 0.55; }

  .why-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.8rem, 5.5vw, 5rem);
    color: var(--color-mora);
    line-height: 0.97;
    margin: 0;
    letter-spacing: -0.03em;
  }

  .why-em {
    font-style: italic;
    font-weight: 700;
    color: var(--color-bitter);
    display: block;
  }

  .why-dot { color: var(--color-basilico); }

  .why-sub {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    color: var(--color-basilico);
    opacity: 0.7;
    margin: 0;
  }

  .why-body {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-inchiostro-700);
    line-height: 1.7;
    margin: 0;
    max-width: 380px;
  }

  .why-proof {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .proof-avatars { display: flex; }

  .avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1.5px solid var(--color-panna);
    margin-left: -9px;
  }

  .av-1 { background: var(--color-bitter-500); margin-left: 0; }
  .av-2 { background: var(--color-basilico); }
  .av-3 { background: var(--color-mora-300); }

  .proof-copy {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro-500);
    margin: 0;
  }

  .proof-n {
    color: var(--color-mora);
    font-weight: 700;
  }

  .why-panel-outer {
    animation: fadeUpWhy 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.12s both;
  }

  .why-panel {
    background: var(--color-panna-100);
    border: 0.5px solid color-mix(in srgb, var(--color-mora) 10%, transparent);
    border-radius: 20px;
    padding: clamp(2rem, 4vw, 3rem);
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--color-mora) 4%, transparent),
      0 8px 24px color-mix(in srgb, var(--color-mora) 6%, transparent),
      0 32px 80px color-mix(in srgb, var(--color-mora) 7%, transparent);
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
    animation: floatPanel 9s ease-in-out 1s infinite;
  }

  .panel-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-basilico);
  }

  .panel-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-basilico);
    flex-shrink: 0;
    animation: dotPulse 2.4s ease-in-out infinite;
  }

  .panel-price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .price-from {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-inchiostro-500);
  }

  .price-main {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3rem, 5.5vw, 4.5rem);
    color: var(--color-bitter);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .price-was {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-inchiostro-300);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
    opacity: 0.5;
    align-self: center;
  }

  .panel-alloc {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: clamp(0.75rem, 1.5vw, 1rem);
    border-top: 0.5px solid color-mix(in srgb, var(--color-basilico) 10%, transparent);
  }

  .alloc-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .alloc-lbl {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--color-inchiostro-700);
  }

  .alloc-pct {
    font-family: var(--font-body);
    font-size: var(--text-label);
    color: var(--color-inchiostro-500);
  }

  .alloc-track {
    height: 2px;
    background: color-mix(in srgb, var(--color-basilico) 10%, transparent);
    border-radius: 2px;
    position: relative;
  }

  .alloc-fill {
    height: 100%;
    width: 67%;
    background: linear-gradient(to right, var(--color-basilico), var(--color-bitter));
    border-radius: 2px;
    position: relative;
    animation: allocIn 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.7s both;
  }

  .alloc-fill::after {
    content: '';
    position: absolute;
    right: -1px;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-bitter);
    box-shadow: 0 0 8px color-mix(in srgb, var(--color-bitter) 50%, transparent);
  }

  .alloc-rest {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-bitter);
    margin: 0;
  }

  /* ─── CINEMATIC BANNER ────────────────────────────────────── */
  .cinematic-banner {
    position: relative;
    height: clamp(300px, 55vh, 600px);
    overflow: hidden;
  }

  .cinematic-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }

  .cinematic-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-inchiostro) 30%, transparent) 0%,
      color-mix(in srgb, var(--color-inchiostro) 55%, transparent) 100%
    );
  }

  .cinematic-caption {
    position: absolute;
    bottom: clamp(1.5rem, 4vw, 3rem);
    left: clamp(1.5rem, 4vw, 4rem);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .cinematic-text {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1rem, 2vw, 1.5rem);
    color: var(--color-panna);
    opacity: 0.85;
    letter-spacing: 0.04em;
  }

  .cinematic-rule {
    display: block;
    width: clamp(40px, 8vw, 120px);
    height: 1px;
    background: color-mix(in srgb, var(--color-panna) 40%, transparent);
  }

  /* ─── PER CHI È ───────────────────────────────────────────── */
  .s-perchi {
    background-color: var(--color-basilico);
    overflow: hidden;
  }

  .perchi-layout {
    display: grid;
    grid-template-columns: 1fr 0.65fr;
    min-height: clamp(500px, 70vh, 800px);
  }

  .perchi-content {
    padding: clamp(4rem, 8vw, 8rem) clamp(2rem, 5vw, 5rem) clamp(4rem, 8vw, 8rem) clamp(2rem, 5vw, 5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-md);
    max-width: 700px;
  }

  .perchi-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    color: var(--color-panna);
    line-height: 0.97;
    margin: 0;
    letter-spacing: -0.025em;
  }

  .perchi-lead {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    color: var(--color-pesco-300);
    line-height: 1.7;
    margin: 0;
    max-width: 520px;
    opacity: 0.85;
  }

  .perchi-occasions {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 0.5px solid color-mix(in srgb, var(--color-panna) 15%, transparent);
  }

  .perchi-occasion {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-panna);
    font-style: italic;
    line-height: 1.5;
    padding: 1rem 0;
    border-bottom: 0.5px solid color-mix(in srgb, var(--color-panna) 12%, transparent);
    opacity: 0.85;
  }

  .perchi-close {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-panna);
    opacity: 0.5;
    margin: 0;
    font-style: italic;
    letter-spacing: 0.02em;
  }

  .perchi-image-col {
    position: relative;
    overflow: hidden;
  }

  .perchi-image-wrap {
    position: absolute;
    inset: 0;
  }

  .perchi-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .s-perchi:hover .perchi-img {
    transform: scale(1.03);
  }

  .perchi-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-basilico) 50%, transparent) 0%,
      transparent 40%
    );
  }

  /* ─── BAR PARTNER ─────────────────────────────────────────── */
  .s-bars {
    background-color: var(--color-panna-100);
    padding: clamp(5rem, 10vw, 9rem) 0;
  }

  .bars-header {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .bars-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.8rem, 6vw, 5.5rem);
    color: var(--color-mora);
    line-height: 0.95;
    margin: 0;
    letter-spacing: -0.03em;
  }

  .bars-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: start;
  }

  .bars-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding-top: var(--space-sm);
  }

  .bars-lead {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    color: var(--color-inchiostro-700);
    line-height: 1.75;
    margin: 0;
    opacity: 0.85;
  }

  .criteria-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 0.5px solid var(--color-panna-300);
  }

  .criterion {
    padding: 1.25rem 0;
    border-bottom: 0.5px solid var(--color-panna-300);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 1.5rem;
    align-items: start;
    position: relative;
    padding-left: 1rem;
  }

  .criterion::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.25rem;
    bottom: 1.25rem;
    width: 2px;
    background: var(--color-bitter);
    border-radius: 2px;
    opacity: 0.4;
    transition: opacity 0.25s ease;
  }

  .criterion:hover::before { opacity: 1; }

  .criterion-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-body);
    color: var(--color-mora);
    margin: 0 0 0.25rem;
    grid-column: 1 / -1;
  }

  .criterion-desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro-500);
    line-height: 1.65;
    margin: 0;
    grid-column: 1 / -1;
  }

  .bars-right { position: relative; }

  .bars-visual {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .bars-photo-wrap {
    aspect-ratio: 3/4;
    overflow: hidden;
    border-radius: var(--radius-md);
    position: relative;
  }

  .bars-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    display: block;
  }

  .bars-photo-wrap:hover .bars-photo { transform: scale(1.04); }

  .map-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    margin: 0;
  }

  .milan-map {
    width: 100%;
    max-width: 320px;
    color: var(--color-basilico);
  }

  .map-caption {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-inchiostro-300);
    text-align: center;
  }

  /* ─── APP ─────────────────────────────────────────────────── */
  .s-app {
    background-color: var(--color-mora);
    overflow: hidden;
  }

  .app-layout {
    display: grid;
    grid-template-columns: 0.65fr 1fr;
    min-height: clamp(500px, 65vh, 760px);
  }

  .app-image-col {
    position: relative;
    overflow: hidden;
  }

  .app-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .s-app:hover .app-img { transform: scale(1.03); }

  .app-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to left,
      color-mix(in srgb, var(--color-mora) 60%, transparent) 0%,
      transparent 50%
    );
  }

  .app-content-col {
    display: flex;
    align-items: center;
    padding: clamp(3rem, 6vw, 6rem) clamp(2rem, 5vw, 5rem);
  }

  .app-content-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 520px;
  }

  .app-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 4vw, 3.5rem);
    color: var(--color-panna);
    line-height: 1.05;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .app-sub {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    color: var(--color-pesco-300);
    line-height: 1.65;
    margin: 0;
    opacity: 0.8;
  }

  .app-features {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 0.5px solid color-mix(in srgb, var(--color-panna) 12%, transparent);
    margin-top: var(--space-sm);
  }

  .app-feature {
    padding: 1.25rem 0;
