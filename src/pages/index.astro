<script>
  // FAQ accordion: close others on open
  document.querySelectorAll('.faq-item').forEach(detail => {
    detail.addEventListener('toggle', () => {
      if ((detail as HTMLDetailsElement).open) {
        document.querySelectorAll('.faq-item').forEach(other => {
          if (other !== detail) (other as HTMLDetailsElement).open = false;
        });
      }
    });
  });

  // Per chi è: scroll reveal
  const perchiSection = document.querySelector('.s-perchi');
  if (perchiSection) {
    const reveals = perchiSection.querySelectorAll('.perchi-reveal, .perchi-img-reveal');
    const perchiObs = new IntersectionObserver(
      entries => {
        if (entries[0].isIntersecting) {
          reveals.forEach(el => el.classList.add('is-visible'));
          perchiObs.disconnect();
        }
      },
      { threshold: 0.15 }
    );
    perchiObs.observe(perchiSection);
  }

  // How-section cards: scroll reveal
  const howCards = document.querySelectorAll('.how-card');
  if (howCards.length) {
    const io = new IntersectionObserver(
      entries => entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      }),
      { threshold: 0.12 }
    );
    howCards.forEach(c => io.observe(c));
  }

</script>
