  .tally-wrap { max-width: 760px; }

  /* ══════════════════════════════════════════════════════════
     PREMIUM TRANSITIONS — reveals, vignette, ambient
     ══════════════════════════════════════════════════════════ */

  /* All sections: local stacking context */
  section { position: relative; z-index: 0; }

  /* ── UNIVERSAL SCROLL REVEAL ──────────────────────────────── */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal.is-visible { opacity: 1; transform: none; }
  .reveal-d1 { transition-delay: 0.12s; }
  .reveal-d2 { transition-delay: 0.24s; }
  .reveal-d3 { transition-delay: 0.38s; }

  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .how-card,
    .perchi-reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
  }

  /* ── CINEMATIC VIGNETTE — top shadow on all non-hero sections  */
  /* Only rgba black — works regardless of adjacent section color */
  .s-how::before,
  .s-why::before,
  .s-perchi::before,
  .s-bars::before,
  .s-cta-final::before,
  .s-lista::before,
  .s-faq::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 80px;
    background: linear-gradient(to bottom, rgba(0,0,0,0.22), transparent);
