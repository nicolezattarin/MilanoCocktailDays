---
import BaseLayout from '../layouts/BaseLayout.astro';

const steps = [
  {
    n: '01',
    title: 'Prendi il pass',
    desc: "Un pass, valido per tutti i dieci giorni. Early bird da €15 — si compra una volta sola.",
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="9" width="28" height="14" rx="2"/><line x1="10" y1="9" x2="10" y2="23" stroke-dasharray="3 3" opacity="0.6"/><circle cx="2" cy="16" r="2.5" fill="currentColor" stroke="none" opacity="0.25"/><circle cx="30" cy="16" r="2.5" fill="currentColor" stroke="none" opacity="0.25"/></svg>`,
  },
  {
    n: '02',
    title: 'Scegli i bar',
    desc: "Trenta locali da Brera a NoLo. Nessuna prenotazione, nessun itinerario fisso.",
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M16 3C11.6 3 8 6.6 8 11c0 6 8 18 8 18s8-12 8-18c0-4.4-3.6-8-8-8z"/><circle cx="16" cy="11" r="2.5"/></svg>`,
  },
  {
    n: '03',
    title: 'Bevi il Cocktail Days',
    desc: "Il cocktail esclusivo del bar, servito solo in questi dieci giorni. €6, ovunque.",
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M5 4h22L16 17 5 4z"/><line x1="16" y1="17" x2="16" y2="25"/><line x1="10" y1="28" x2="22" y2="28"/></svg>`,
  },
];

const criteria = [
  {
    title: 'Cocktail come mestiere.',
    desc: 'La miscelazione prima del concept, della musica, dei selfie.',
    img: '/images/Clear Wine Glass Photo.jpg',
  },
  {
    title: 'Quartieri vivi.',
    desc: 'Da Brera a Lambrate, dai Navigli a NoLo. Milano non è solo il centro.',
    img: '/images/Szymon Fischer.jpg',
  },
  {
    title: 'Voci della scena.',
    desc: "Non nomi su un'insegna: persone con cui si parla.",
    img: '/images/Louis Hansel Photo.jpg',
  },
];

const appFeatures = [
  {
    title: 'Acquista il biglietto.',
    desc: "Acquista il tuo biglietto e ottieni l'accesso all'app con tutti gli oltre 60 bar partecipanti e i loro cocktail del festival. Il tuo biglietto ti accompagnerà per 18 giorni durante tutto il festival.",
    wide: false,
  },
  {
    title: 'Scopri i bar e i cocktail.',
    desc: "Nell'app puoi vedere quali bar partecipano e quale signature cocktail puoi sbloccare lì. Ogni bar crea un cocktail unico, disponibile solo durante il festival.",
    wide: false,
  },
  {
    title: 'Scansiona e ordina.',
    desc: "Scansiona il codice QR al bar con l'app, sblocca il signature cocktail e ordinalo direttamente sul posto a 6 €.",
    wide: true,
  },
];

const quotes = [
  { text: 'Finalmente un evento come la London Cocktail Week a Milano!', name: 'Giulia', age: 25 },
  { text: 'Cocktail a €6 è già abbastanza per comprare il biglietto', name: 'Marco', age: 24 },
  { text: 'Una scusa per uscire durante la settimana a Milano', name: 'Elena', age: 30 },
  { text: 'Sembra un modo carino per scoprire nuovi bar', name: 'Luca', age: 34 },
  { text: 'Non vedo l\'ora di esplorare quartieri che non conoscevo', name: 'Sara', age: 28 },
  { text: 'Perfetto per chi ama i cocktail ma odia i prezzi da centro', name: 'Davide', age: 31 },
  { text: 'Ho già convinto tutti i miei amici a iscriversi', name: 'Martina', age: 26 },
  { text: '€15 per dieci giorni di giro per Milano? Affare fatto', name: 'Valentina', age: 32 },
  { text: 'L\'idea del cocktail unico per ogni bar è geniale', name: 'Chiara', age: 29 },
  { text: 'Questo è esattamente il tipo di evento che mancava in città', name: 'Riccardo', age: 35 },
  { text: 'Finalmente qualcosa che vale la pena fare a Milano a maggio', name: 'Andrea', age: 33 },
  { text: 'Sono curioso di vedere quali bar sceglieranno', name: 'Filippo', age: 27 },
];

const faqs = [
  {
    q: 'Iscrivermi alla lista significa che ho già comprato il pass?',
    a: "No. La lista d'attesa è solo un'email-promemoria. Quando aprono i pass, ti scriviamo per primi.",
  },
  {
    q: 'Quanto costa il pass?',
    a: 'I primi (super early bird) partono da €15. Quando finiscono, il prezzo standard è €30.',
  },
  {
    q: "Quando esattamente si svolge l'evento?",
    a: 'Dieci giorni di maggio 2027. Le date precise le annunciamo a chi è in lista, prima di tutti.',
  },
  {
    q: "Cos'è il Cocktail Days? È un cocktail scontato?",
    a: "No. È un cocktail che il bar inventa apposta per la settimana — una ricetta nuova, servita solo nei dieci giorni dell'evento, allo stesso prezzo in tutti i trenta bar: €6.",
  },
  {
    q: 'Cosa è incluso nel pass?',
    a: "L'accesso ai trenta bar partner per l'intera durata dell'evento, e il diritto a ordinare il Cocktail Days a €6 — in ogni bar, quante volte vuoi.",
  },
  {
    q: 'Devo prenotare nei bar?',
    a: 'No. Entri quando vuoi, mostri il pass, ordini.',
  },
  {
    q: "Serve l'app?",
    a: "No. Il pass basta. L'app è un compagno di strada, non un requisito.",
  },
  {
    q: 'Posso regalare o trasferire il pass?',
    a: "Stiamo lavorando alla regalistica. I dettagli arrivano all'apertura delle vendite — anche su questo, chi è in lista lo sa per primo.",
  },
];

---

<BaseLayout
  title="Milano Cocktail Days — Trenta bar, dieci giorni, un pass."
  description="Maggio 2027: trenta bar di Milano, dieci giorni, un cocktail inventato apposta in ogni bancone a €6. Mettiti in lista per i primi pass a €15."
  pageType="event"
>

  <!-- S01 · HERO ─────────────────────────────────────────────── -->
  <section class="s-hero" aria-labelledby="home-h1">
    <picture class="hero-bg" aria-hidden="true">
      <img
        src="/images/bar_photo1.jpg"
        alt=""
        width="1920" height="1080"
        fetchpriority="high" loading="eager"
      />
    </picture>
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="wrap hero-inner">
      <img src="/logos/logo_3_v.FINAL/Panna.svg" alt="Milan Cocktail Days" class="hero-logo" />

      <p class="hero-overline">
        Milano <span aria-hidden="true">✶</span> Maggio 2027 <span aria-hidden="true">✶</span> Prima Edizione
      </p>

      <div class="hero-h1-wrap mcw-bracket">
        <h1 id="home-h1" class="hero-h1">
          Trenta bar di Milano.<br />Per dieci giorni.<br />Un pass.
        </h1>
      </div>

      <p class="hero-sub">
        Ogni bar inventa un cocktail solo per te. €6 l'uno, solo nei dieci giorni di maggio.
        Mettiti in lista - i primi pass partono da €15.
      </p>

      <a href="#lista" class="btn btn--primary">
        Entra in lista d'attesa <span aria-hidden="true">✶</span>
      </a>
    </div>
  </section>

  <!-- S02 · COME FUNZIONA ────────────────────────────────────── -->
  <section class="s-how" aria-labelledby="how-h2">
    <div class="how-bg-glow" aria-hidden="true"></div>
    <div class="wrap">

      <h2 id="how-h2" class="how-h2">Tre cose,<br />niente di più.</h2>

      <div class="how-steps-wrap">
        <div class="how-connector" aria-hidden="true"></div>
        <div class="how-steps">
          {steps.map(({ n, icon, title, desc }) => (
            <article class="how-card">
              <div class="how-card-top">
                <div class="how-card-num" aria-hidden="true">{n}</div>
                <div class="how-card-icon" aria-hidden="true" set:html={icon} />
              </div>
              <h3 class="how-card-title">{title}</h3>
              <div class="how-card-desc-box">
                <p class="how-card-desc">{desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>

      <div class="how-footer">
        <p class="how-strap">
          Trenta bar. Trenta cocktail unici. Solo dentro MCD.
          <span aria-hidden="true">✶</span>
        </p>
        <a href="#lista" class="btn btn--primary how-cta">
          Prendi il pass <span aria-hidden="true">✶</span>
        </a>
      </div>

    </div>
  </section>

  <!-- S03 · PERCHÉ ISCRIVERSI ────────────────────────────────── -->
  <section class="s-why" aria-labelledby="why-h2">
    <div class="why-texture" aria-hidden="true"></div>
    <div class="wrap why-wrap">

      <div class="why-editorial">
        <p class="why-kicker">Early bird <span aria-hidden="true">✶</span> Prezzi lancio</p>
        <h2 id="why-h2" class="why-h2">
          Per i primi iscritti,<br />
          <em class="why-em">un prezzo stracciato.</em>
        </h2>
        <p class="why-body">Il pass sale a €30 non appena finiscono i posti early bird.</p>
      </div>

      <div class="why-price-block">
        <div class="panel-price">
          <span class="price-from">Da</span>
          <span class="price-main">€15</span>
          <span class="price-was">€30</span>
        </div>
      </div>

      <div class="why-action">
        <div class="why-proof">
          <div class="proof-avatars" aria-hidden="true">
            <span class="avatar av-1"></span>
            <span class="avatar av-2"></span>
            <span class="avatar av-3"></span>
          </div>
          <p class="proof-copy"><strong class="proof-n">347</strong> già in lista</p>
        </div>
        <a href="#lista" class="btn btn--primary">
          Entra nella lista <span aria-hidden="true">✶</span>
        </a>
      </div>

    </div>
  </section>

  <!-- S05 · PER CHI È ────────────────────────────────────────── -->
  <section class="s-perchi" aria-labelledby="perchi-h2">
    <div class="perchi-layout">

      <div class="perchi-content">
        <p class="section-kicker section-kicker--light perchi-reveal">Per chi è</p>
        <h2 id="perchi-h2" class="perchi-h2 perchi-reveal">
          Per chi ama<br />Milano.<br />E per chi vuole<br />conoscerla meglio.
        </h2>
        <p class="perchi-lead perchi-reveal">
          MCD non è per gli addetti ai lavori. È per chi al bancone ci sta bene,
          sa o non sa quello che ordina, e ha voglia di fare un giro che valga la pena.
        </p>

        <ul class="perchi-occasions perchi-reveal" role="list">
          <li class="perchi-occasion">Per il sabato pomeriggio con chi ti piace.</li>
          <li class="perchi-occasion">Per una serata diversa con gli amici di sempre.</li>
          <li class="perchi-occasion">Per chi è curioso e non sa da dove iniziare.</li>
        </ul>
      </div>

      <div class="perchi-image-col" aria-hidden="true">
        <div class="perchi-image-wrap perchi-img-reveal">
          <img
            src="/images/Photo by Mediha Ekici copy.jpg"
            alt=""
            class="perchi-img"
            loading="lazy"
            width="800" height="1000"
          />
          <div class="perchi-image-overlay"></div>
        </div>
      </div>

    </div>
  </section>

  <!-- S06a · I BAR PARTNER ───────────────────────────────────── -->
  <section class="s-bars" aria-labelledby="bars-h2">
    <div class="wrap">
      <div class="bars-header">
        <h2 id="bars-h2" class="bars-h2">Non tutti i bar di Milano. I trenta che contano.</h2>
        <p class="bars-lead">
          Bar indipendenti, bartender con un'idea, cocktail che parlano.
          Chi è in lista li vede per primo.
        </p>
      </div>

      <div class="criteria-grid">
        {criteria.map(({ title, desc, img }) => (
          <div class="criterion-card">
            <div class="criterion-img-wrap">
              <img src={img} alt="" class="criterion-img" loading="lazy" />
            </div>
            <div class="criterion-body">
              <h3 class="criterion-title">{title}</h3>
              <p class="criterion-desc">{desc}</p>
            </div>
          </div>
        ))}
      </div>

      <a href="#lista" class="btn btn--primary bars-cta">
        Iscriviti per saperlo prima di tutti <span aria-hidden="true">✶</span>
      </a>
    </div>
  </section>

  <!-- S06b · L'APP ───────────────────────────────────────────── -->
  <section class="s-app" aria-labelledby="app-h2">
    <div class="wrap app-inner">
      <div class="app-mock" aria-hidden="true">
        <div class="phone-frame">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            <div class="phone-header-bar"></div>
            <div class="phone-card-lg"></div>
            <div class="phone-card-row">
              <div class="phone-card-sm"></div>
              <div class="phone-card-sm"></div>
            </div>
            <div class="phone-card-lg phone-card-lg--xs"></div>
          </div>
        </div>
      </div>

      <div class="app-content">
        <h2 id="app-h2" class="app-h2">Un'app che ti accompagna in giro.</h2>
        <p class="app-sub">
          Accedi ai drink dell'evento, raccogli i tuoi punti e riscatta i premi dei partner.
        </p>

        <div class="app-cards">
          {appFeatures.map(({ title, desc, wide }) => (
            <div class:list={['app-card', { 'app-card--wide': wide }]}>
              <h3 class="app-card-title">{title}</h3>
              <p class="app-card-desc">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- S07 · VOCI DALLA LISTA ─────────────────────────────────── -->
  <section class="s-quotes" aria-labelledby="quotes-h2">
    <div class="wrap quotes-header">
      <h2 id="quotes-h2" class="quotes-h2">Cosa dice chi si è già registrato</h2>
      <p class="quotes-counter" aria-live="polite">
        <strong class="counter-num" id="counter-quotes">347</strong> persone già in lista
      </p>
    </div>

    <div class="quotes-outer">
      <div class="quotes-track" id="quotes-track" aria-label="Testimonianze">
        {[...quotes, ...quotes].map(({ text, name, age }, i) => (
          <article class="quote-card" aria-hidden={i >= quotes.length ? 'true' : 'false'}>
            <blockquote class="quote-text">"{text}"</blockquote>
            <footer class="quote-author">— {name}, {age}</footer>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- S08 · CTA FINALE ───────────────────────────────────────── -->
  <section class="s-cta-final" aria-labelledby="cta-final-h2">
    <picture class="cta-bg" aria-hidden="true">
      <img
        src="/images/Photo by Mahyaddin Jabbarli.jpg"
        alt=""
        class="cta-bg-img"
        loading="lazy"
        width="1920" height="1080"
      />
    </picture>
    <div class="cta-overlay" aria-hidden="true"></div>
    <div class="wrap cta-final-inner">
      <p class="section-kicker section-kicker--light">Milano, Maggio 2027</p>
      <h2 id="cta-final-h2" class="cta-final-h2">
        Sii il primo<br />a sapere.
      </h2>
      <a href="#lista" class="btn btn--final">
        Entra in lista d'attesa <span aria-hidden="true">✶</span>
      </a>
      <p class="cta-trust">Ti scriviamo solo quando aprono i pass. Niente spam, parola.</p>
    </div>
  </section>

  <!-- FORM ───────────────────────────────────────────────────── -->
  <section class="s-lista" id="lista" aria-labelledby="lista-h2">
    <div class="wrap">
      <h2 id="lista-h2" class="lista-h2">
        Lista d'attesa <span aria-hidden="true">✶</span>
      </h2>
      <p class="lista-intro">
        Iscriviti gratuitamente. Ti contatteremo per primo all'apertura ufficiale dei pass.
      </p>
      <div class="tally-wrap">
        <iframe
          data-tally-src="https://tally.so/embed/Y5pkp5?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1&hideFooter=1"
          loading="lazy"
          width="100%"
          height="689"
          title="Milan Cocktail Days — Lista d'attesa partecipanti"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- S09 · FAQ ──────────────────────────────────────────────── -->
  <section class="s-faq" aria-labelledby="faq-h2">
    <div class="wrap faq-wrap">

      <div class="faq-header">
        <p class="section-kicker">FAQ</p>
        <h2 id="faq-h2" class="faq-h2">Domande,<br />in due righe.</h2>
      </div>

      <div class="faq-list" id="faq-list">
        {faqs.map(({ q, a }) => (
          <details class="faq-item">
            <summary class="faq-q">
              {q}
              <span class="faq-icon" aria-hidden="true">✶</span>
            </summary>
            <p class="faq-a">{a}</p>
          </details>
        ))}
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ── SECTION KICKER ───────────────────────────────────────── */
  .section-kicker {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-basilico);
    margin: 0 0 var(--space-sm);
    display: block;
  }
  .section-kicker--light {
    color: var(--color-pesco-300);
    opacity: 0.8;
  }

  /* ── HERO ─────────────────────────────────────────────────── */
  .s-hero {
    position: relative;
    min-height: 80svh;
    display: flex;
    align-items: center;
    padding: clamp(2rem, 5vw, 4rem) 0;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 80% center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-inchiostro) 55%, transparent) 0%,
      color-mix(in srgb, var(--color-inchiostro) 15%, transparent) 30%,
      transparent 60%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    max-width: 100%;
    margin: 0 auto;
    padding: 24px 40px;
    background: color-mix(in srgb, var(--color-panna) 8%, transparent);
    backdrop-filter: blur(4px);
    border: 1px solid color-mix(in srgb, var(--color-panna) 20%, transparent);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .hero-logo {
    height: auto;
    width: 500px;
    display: block;
    object-fit: contain;
    margin-bottom: var(--space-md);
  }

  .hero-overline {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-panna);
    margin: 0;
  }

  .hero-h1-wrap {
    padding: var(--space-sm) var(--space-md);
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 4.5vw, 4rem);
    color: var(--color-panna);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .hero-sub {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    color: var(--color-pesco-300);
    line-height: 1.6;
    margin: 0;
    max-width: 480px;
  }

  /* ── SHARED BTN ───────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.875rem 2rem;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease, border-color 0.2s ease;
    margin-top: var(--space-sm);
  }

  .btn--primary {
    background-color: var(--color-bitter);
    color: var(--color-panna);
    border: 1px solid var(--color-bitter);
  }

  .btn--primary:hover {
    background-color: var(--color-bitter-500);
    border-color: var(--color-bitter-500);
  }

  .btn--final {
    background-color: var(--color-bitter);
    color: var(--color-panna);
    border: 1px solid var(--color-bitter);
    font-size: var(--text-body);
    padding: 1rem 2.5rem;
    margin-top: 0;
  }

  .btn--final:hover {
    background-color: var(--color-bitter-500);
    border-color: var(--color-bitter-500);
  }

  /* ── COME FUNZIONA ────────────────────────────────────────── */
  .s-how {
    background-color: var(--color-fumo);
    padding: 50px 0 50px 0;
    position: relative;
    overflow: hidden;
    min-height: 200px;
    height: 580px;
  }

  .how-bg-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(ellipse 55% 45% at 85% 15%, color-mix(in srgb, var(--color-bitter) 9%, transparent), transparent),
      radial-gradient(ellipse 45% 55% at 5% 85%, color-mix(in srgb, var(--color-basilico) 18%, transparent), transparent);
  }

  .s-how .wrap {
    position: relative;
    z-index: 1;
  }

  .how-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 60px;
    color: var(--color-panna);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0 0 30px;
  }

  .how-steps-wrap {
    position: relative;
    margin-bottom: 30px;
  }

  .how-connector {
    position: absolute;
    top: 0.9rem;
    left: calc(100% / 6);
    right: calc(100% / 6);
    height: 0.5px;
    background: linear-gradient(to right,
      transparent,
      color-mix(in srgb, var(--color-bitter) 55%, transparent) 20%,
      color-mix(in srgb, var(--color-bitter) 55%, transparent) 80%,
      transparent
    );
    z-index: 0;
    pointer-events: none;
  }

  .how-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    position: relative;
    z-index: 1;
  }

  .how-card {
    background-color: color-mix(in srgb, var(--color-panna) 5%, var(--color-mora));
    border: 0.5px solid color-mix(in srgb, var(--color-panna) 10%, transparent);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md) var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease,
      box-shadow 0.35s ease;
  }

  .how-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .how-card:nth-child(2) { transition-delay: 0.1s; }
  .how-card:nth-child(3) { transition-delay: 0.2s; }

  .how-card:hover {
    box-shadow:
      0 24px 64px color-mix(in srgb, var(--color-mora) 70%, transparent),
      0 0 48px color-mix(in srgb, var(--color-bitter) 12%, transparent);
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--color-bitter) 25%, transparent);
  }

  .how-card.is-visible:hover {
    transform: translateY(-6px);
  }

  .how-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-xs);
  }

  .how-card-num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-bitter);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .how-card-icon {
    color: var(--color-panna);
    opacity: 0.45;
    flex-shrink: 0;
    width: clamp(1.5rem, 3vw, 2rem);
    height: clamp(1.5rem, 3vw, 2rem);
  }

  .how-card-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .how-card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-body-lg);
    color: var(--color-panna);
    letter-spacing: 0.01em;
    margin: 0;
    line-height: 1.2;
  }

  .how-card-desc-box {
    margin-top: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
    background-color: color-mix(in srgb, var(--color-panna) 6%, transparent);
    border-left: 1.5px solid color-mix(in srgb, var(--color-bitter) 40%, transparent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .how-card-desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-pesco-300);
    line-height: 1.6;
    margin: 0;
    opacity: 0.85;
  }

  .how-footer {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
    padding-top: var(--space-md);
    border-top: var(--border-hairline-dark);
  }

  .how-strap {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
    color: var(--color-panna);
    line-height: 1.2;
    margin: 0;
    flex: 1;
  }

  .how-cta {
    margin-top: 0;
    flex-shrink: 0;
  }

  /* ── PERCHÉ ISCRIVERSI ────────────────────────────────────── */
  .s-why {
    background: var(--color-panna);
    padding: clamp(1.5rem, 3vw, 2.5rem) 0;
    position: relative;
    overflow: hidden;
    border-top: 0.5px solid var(--color-panna-300);
    border-bottom: 0.5px solid var(--color-panna-300);
  }

  .why-texture {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-basilico) 5%, transparent) 1px,
      transparent 1px
    );
    background-size: 20px 20px;
    z-index: 0;
  }

  .why-wrap {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    flex-wrap: wrap;
  }

  .why-editorial {
    flex: 1;
    min-width: 220px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .why-kicker {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-basilico);
    opacity: 0.55;
    margin: 0;
  }

  .why-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    color: var(--color-mora);
    line-height: 1.1;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .why-em {
    font-style: italic;
    font-weight: 700;
    color: var(--color-bitter);
  }

  .why-body {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro-500);
    line-height: 1.5;
    margin: 0.25rem 0 0;
  }

  .why-price-block {
    flex-shrink: 0;
    border-left: 0.5px solid var(--color-panna-300);
    border-right: 0.5px solid var(--color-panna-300);
    padding: 0 clamp(1.5rem, 3vw, 3rem);
  }

  .panel-price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .price-from {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-inchiostro-500);
  }

  .price-main {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--color-bitter);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .price-was {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-inchiostro-300);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
    opacity: 0.55;
    align-self: center;
  }

  .why-action {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .why-proof {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .proof-avatars {
    display: flex;
  }

  .avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1.5px solid var(--color-panna);
    margin-left: -8px;
  }

  .av-1 { background: var(--color-bitter-500); margin-left: 0; }
  .av-2 { background: var(--color-basilico); }
  .av-3 { background: var(--color-mora-300); }

  .proof-copy {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro-500);
    margin: 0;
  }

  .proof-n {
    color: var(--color-mora);
    font-weight: 700;
  }


  /* ── PER CHI È ────────────────────────────────────────────── */
  .s-perchi {
    background-color: var(--color-basilico);
    overflow: hidden;
  }

  .perchi-layout {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    min-height: clamp(500px, 65vh, 750px);
  }

  .perchi-content {
    padding: clamp(3rem, 5vw, 5rem) clamp(2rem, 5vw, 5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-sm);
    max-width: 700px;
  }

  .perchi-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(40px, 4vw, 56px);
    color: var(--color-panna);
    line-height: 0.97;
    margin: 0;
    letter-spacing: -0.025em;
  }

  .perchi-lead {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    color: var(--color-pesco-300);
    line-height: 1.7;
    margin: 0;
    max-width: 520px;
    opacity: 0.85;
  }

  .perchi-occasions {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 0.5px solid color-mix(in srgb, var(--color-panna) 15%, transparent);
  }

  .perchi-occasion {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-panna);
    font-style: italic;
    line-height: 1.5;
    padding: 0.65rem 0;
    border-bottom: 0.5px solid color-mix(in srgb, var(--color-panna) 12%, transparent);
    opacity: 0.85;
  }

  /* scroll-reveal states */
  .perchi-reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .perchi-reveal:nth-child(2) { transition-delay: 0.1s; }
  .perchi-reveal:nth-child(3) { transition-delay: 0.2s; }
  .perchi-reveal:nth-child(4) { transition-delay: 0.32s; }
  .perchi-reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  .perchi-img-reveal {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.06);
    transition: opacity 0.9s ease, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 0.15s;
  }
  .perchi-img-reveal.is-visible {
    opacity: 1;
    transform: scale(1);
  }

  .perchi-image-wrap {
    position: relative;
    margin-right: auto;
    padding-left: 0;
    padding-right: 0;
    width: 600px;
  }

  .perchi-image-col {
    position: relative;
    overflow: hidden;
  }

  .perchi-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left;
    display: block;
    transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .perchi-image-col:hover .perchi-img {
    transform: scale(1.04);
  }

  .perchi-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      var(--color-basilico) 0%,
      color-mix(in srgb, var(--color-basilico) 82%, transparent) 18%,
      color-mix(in srgb, var(--color-basilico) 48%, transparent) 35%,
      color-mix(in srgb, var(--color-basilico) 14%, transparent) 50%,
      transparent 65%
    );
    opacity: 1;
    padding-left: 0;
    padding-right: 0;
    box-shadow: -18px 1px 8px 2px #2e4a36;
  }

  /* ── BAR PARTNER ──────────────────────────────────────────── */
  .s-bars {
    background-color: var(--color-avorio);
    padding: clamp(1.75rem, 3.5vw, 2.5rem) 0;
  }

  .bars-header {
    display: flex;
    align-items: baseline;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-bottom: var(--space-md);
    flex-wrap: wrap;
  }

  .bars-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    color: var(--color-mora);
    line-height: 1.05;
    margin: 0;
    flex: 1;
    min-width: 220px;
  }

  .bars-lead {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro-500);
    line-height: 1.65;
    margin: 0;
    flex: 1;
    min-width: 220px;
  }

  .criteria-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .criterion-card {
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-panna);
    border: 0.5px solid var(--color-panna-300);
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }

  .criterion-card:hover {
    box-shadow: 0 12px 40px color-mix(in srgb, var(--color-mora) 12%, transparent);
    transform: translateY(-4px);
  }

  .criterion-img-wrap {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--color-panna-300);
  }

  .criterion-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .criterion-card:hover .criterion-img {
    transform: scale(1.05);
  }

  .criterion-body {
    padding: var(--space-sm) var(--space-sm) var(--space-md);
    border-top: 2px solid var(--color-basilico);
    flex: 1;
  }

  .criterion-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-body);
    color: var(--color-mora);
    margin: 0 0 var(--space-xs);
  }

  .criterion-desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro-500);
    line-height: 1.65;
    margin: 0;
  }

  .bars-cta {
    margin-top: 0;
  }

  /* ── APP ──────────────────────────────────────────────────── */
  .s-app {
    background-color: var(--color-fumo);
    padding: clamp(2rem, 5vw, 4rem) 0;
  }

  .app-inner {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-lg);
    align-items: center;
  }

  .app-mock {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .phone-frame {
    width: 240px;
    height: 480px;
    border: 1.5px solid color-mix(in srgb, var(--color-panna) 20%, transparent);
    border-radius: 28px;
    background-color: var(--color-marmo);
    padding: 16px 12px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .phone-notch {
    width: 60px;
    height: 8px;
    background-color: color-mix(in srgb, var(--color-panna) 15%, transparent);
    border-radius: 4px;
    margin: 0 auto 6px;
  }

  .phone-screen {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .phone-header-bar {
    height: 24px;
    background-color: color-mix(in srgb, var(--color-basilico) 40%, transparent);
    border-radius: var(--radius-sm);
  }

  .phone-card-lg {
    flex: 1;
    background-color: color-mix(in srgb, var(--color-bitter) 30%, transparent);
    border-radius: var(--radius-sm);
    border: 0.5px solid color-mix(in srgb, var(--color-panna) 15%, transparent);
  }

  .phone-card-lg--xs {
    flex: 0 0 40px;
    background-color: color-mix(in srgb, var(--color-basilico) 20%, transparent);
  }

  .phone-card-row { display: flex; gap: 8px; height: 60px; }

  .phone-card-sm {
    flex: 1;
    background-color: color-mix(in srgb, var(--color-panna) 10%, transparent);
    border-radius: var(--radius-sm);
  }

  .app-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .app-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-panna);
    line-height: 1.05;
    margin: 0;
  }

  .app-sub {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-pesco-300);
    line-height: 1.6;
    margin: 0;
    opacity: 0.85;
  }

  .app-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
  }

  .app-card {
    background-color: color-mix(in srgb, var(--color-panna) 6%, transparent);
    border: 0.5px solid color-mix(in srgb, var(--color-panna) 15%, transparent);
    border-radius: var(--radius-sm);
    padding: var(--space-md);
  }

  .app-card--wide {
    grid-column: 1 / -1;
  }

  .app-card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-small);
    color: var(--color-panna);
    margin: 0 0 var(--space-xs);
    letter-spacing: 0.02em;
  }

  .app-card-desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-pesco-300);
    line-height: 1.65;
    margin: 0;
    opacity: 0.85;
  }

  /* ── VOCI DALLA LISTA ─────────────────────────────────────── */
  .s-quotes {
    background-color: var(--color-panna-100);
    padding: clamp(2rem, 5vw, 4rem) 0;
    overflow: hidden;
  }

  .quotes-header {
    margin-bottom: var(--space-md);
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .quotes-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h2);
    color: var(--color-mora);
    margin: 0;
  }

  .quotes-counter {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro-500);
    margin: 0;
  }

  .quotes-counter .counter-num {
    font-size: var(--text-body);
    color: var(--color-basilico);
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .quotes-outer {
    overflow: hidden;
    padding: 0 0 var(--space-sm);
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .quotes-track {
    display: flex;
    gap: var(--space-md);
    width: max-content;
    animation: marquee 40s linear infinite;
  }

  .quotes-outer:hover .quotes-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .quotes-track { animation: none; }
    .quotes-outer { overflow-x: auto; }
  }

  .quote-card {
    flex: 0 0 min(320px, 80vw);
    background-color: var(--color-panna);
    border: 0.5px solid var(--color-panna-300);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .quote-text {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--text-body);
    color: var(--color-mora);
    line-height: 1.65;
    quotes: none;
    margin: 0;
  }

  .quote-author {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-inchiostro-700);
  }

  /* ── CTA FINALE ───────────────────────────────────────────── */
  .s-cta-final {
    position: relative;
    overflow: hidden;
    min-height: clamp(400px, 60vh, 700px);
    display: flex;
    align-items: center;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cta-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    display: block;
  }

  .cta-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    line-height: 25.6px;
    display: block;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-mora) 40%, transparent) 0%,
      color-mix(in srgb, var(--color-mora) 20%, transparent) 50%,
      transparent 100%
    );
  }

  .cta-final-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    padding-top: clamp(4rem, 8vw, 7rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
    margin-left: 10px;
    margin-right: 10px;
  }

  .cta-final-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3.5rem, 9vw, 8rem);
    color: var(--color-panna);
    line-height: 0.9;
    margin: 0;
    letter-spacing: -0.03em;
  }

  .cta-trust {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-pesco-300);
    opacity: 0.65;
    margin: 0;
    font-style: italic;
  }

  /* ── FAQ ──────────────────────────────────────────────────── */
  .s-faq {
    background-color: var(--color-panna);
    padding: clamp(3rem, 6vw, 5rem) 0;
  }

  .faq-wrap {
    display: grid;
    grid-template-columns: 0.6fr 1fr;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: start;
  }

  .faq-header {
    position: sticky;
    top: 5rem;
  }

  .faq-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    color: var(--color-mora);
    line-height: 0.97;
    margin: 0;
    letter-spacing: -0.03em;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
  }

  .faq-item {
    border-top: 0.5px solid var(--color-panna-300);
  }

  .faq-item:last-child {
    border-bottom: 0.5px solid var(--color-panna-300);
  }

  .faq-q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) 0;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-body);
