<script>
  // FAQ accordion: close others on open
  document.querySelectorAll('.faq-item').forEach(detail => {
    detail.addEventListener('toggle', () => {
      if ((detail as HTMLDetailsElement).open) {
        document.querySelectorAll('.faq-item').forEach(other => {
          if (other !== detail) (other as HTMLDetailsElement).open = false;
        });
      }
    });
  });

  // How-section cards: scroll reveal
  const howCards = document.querySelectorAll('.how-card');
  if (howCards.length) {
    const io = new IntersectionObserver(
      entries => entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      }),
      { threshold: 0.12 }
    );
    howCards.forEach(c => io.observe(c));
  }

  // Quote carousel: auto-advance every 4s
  const quotesOuter = document.querySelector('.quotes-outer');
  const quotesTrack = document.getElementById('quotes-track');
  if (quotesOuter && quotesTrack) {
    const cards = Array.from(quotesTrack.querySelectorAll('.quote-card')) as HTMLElement[];
    let idx = 0;
    setInterval(() => {
      idx = (idx + 1) % cards.length;
      (quotesOuter as HTMLElement).scrollTo({
        left: cards[idx].offsetLeft,
        behavior: 'smooth',
      });
    }, 4000);
  }
</script>
