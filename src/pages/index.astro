---
import BaseLayout from '../layouts/BaseLayout.astro';

const steps = [
  {
    n: '01',
    title: 'Acquista il biglietto',
    desc: "Un pass, valido per tutti i dieci giorni. Early bird da €15.",
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="9" width="28" height="14" rx="2"/><line x1="10" y1="9" x2="10" y2="23" stroke-dasharray="3 3" opacity="0.6"/><circle cx="2" cy="16" r="2.5" fill="currentColor" stroke="none" opacity="0.25"/><circle cx="30" cy="16" r="2.5" fill="currentColor" stroke="none" opacity="0.25"/></svg>`,
  },
  {
    n: '02',
    title: 'Scegli i bar',
    desc: "Scegli tra i 30 cocktail bar selezionati, ognuno ha preparato un cocktail su misura per l’evento. Dai Navigli a NoLo, nessun percorso obbligato.",
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M16 3C11.6 3 8 6.6 8 11c0 6 8 18 8 18s8-12 8-18c0-4.4-3.6-8-8-8z"/><circle cx="16" cy="11" r="2.5"/></svg>`,
  },
  {
    n: '03',
    title: 'Prova i cocktail esclusivi',
    desc: "Ordina il cocktail signature a un prezzo agevolato: solo 6€, in qualunque locale.",
    icon: `<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M5 4h22L16 17 5 4z"/><line x1="16" y1="17" x2="16" y2="25"/><line x1="10" y1="28" x2="22" y2="28"/></svg>`,
  },
];

const criteria = [
  {
    title: 'Il cocktail al centro.',
    desc: "I cocktail sono il cuore dell'offerta, non un'appendice del menù.",
    img: '/images/Clear Wine Glass Photo.jpg',
  },
  {
    title: 'Quartieri vivi.',
    desc: 'Da Brera a Lambrate, dai Navigli a NoLo. La Milano da bere quartiere per quartiere.',
    img: '/images/Szymon Fischer.jpg',
  },
  {
    title: 'Identitá forte.',
    desc: "Drink list curate e stagionali. Ogni cocktail è lì per un motivo.",
    img: '/images/bartender_1.jpg',
  },
];

const appFeatures = [
  {
    step: '01',
    icon: '🎫',
    title: 'Un biglietto. Tutta la città.',
    desc: "Acquista il biglietto e registrati: tutti i bar e i cocktail del festival a portata di mano.",
    wide: false,
  },
  {
    step: '02',
    icon: '🗺️',
    title: 'Scopri bar e cocktail.',
    desc:"Esplora la mappa: scopri i bar e i loro signature cocktail.",
    wide: false,
  },
  {
    step: '03',
    icon: '📱',
    title: 'Scansiona e ordina.',
    desc: "Al bar, scansiona il QR code con l'app e ordina il tuo signature cocktail. Nessuna prenotazione.",
    wide: false,
  },
  {
    step: '04',
    icon: '⭐',
    title: 'Colleziona i timbri e riscatta i premi.',
    desc: "Per ogni signature cocktail che acquisti, ricevi un timbro digitale. Più timbri collezioni, più premi e vantaggi sblocchi.",
    wide: false,
  },
];

const perchiCards = [
  {
    title: 'Gli amanti del cocktail',
    desc: 'Per chi ordina sempre qualcosa di nuovo e vuole scoprire cosa sanno fare i migliori bar di Milano.',
    img: '/images/Clear Wine Glass Photo.jpg',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h14l-7 9-7-9z"/><line x1="12" y1="13" x2="12" y2="20"/><line x1="8" y1="20" x2="16" y2="20"/></svg>`,
  },
  {
    title: 'Le serate con gli amici',
    desc: 'Per una serata diversa dal solito, con i cocktail giusti e la voglia di girovagare per quartieri.',
    img: '/images/Szymon Fischer.jpg',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    title: 'I curiosi',
    desc: 'Per chi vuole scoprire nuovi bar e quartieri di Milano, un bicchiere alla volta.',
    img: '/images/bartender_1.jpg',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>`,
  },
];

const quotes = [
  { text: 'Finalmente un evento come la London Cocktail Week a Milano!', name: 'Giulia', age: 25 },
  { text: 'Cocktail a €6 è già abbastanza per comprare il biglietto', name: 'Marco', age: 24 },
  { text: 'Una scusa per uscire durante la settimana a Milano', name: 'Elena', age: 30 },
  { text: 'Sembra un modo carino per scoprire nuovi bar', name: 'Luca', age: 34 },
  { text: 'Non vedo l\'ora di esplorare quartieri che non conoscevo', name: 'Sara', age: 28 },
  { text: 'Perfetto per chi ama i cocktail ma odia i prezzi da centro', name: 'Davide', age: 31 },
  { text: 'Ho già convinto tutti i miei amici a iscriversi', name: 'Martina', age: 26 },
  { text: '€15 per dieci giorni di giro per Milano? Affare fatto', name: 'Valentina', age: 32 },
  { text: 'L\'idea del cocktail unico per ogni bar è geniale', name: 'Chiara', age: 29 },
  { text: 'Questo è esattamente il tipo di evento che mancava in città', name: 'Riccardo', age: 35 },
  { text: 'Finalmente qualcosa che vale la pena fare a Milano a maggio', name: 'Andrea', age: 33 },
  { text: 'Sono curioso di vedere quali bar sceglieranno', name: 'Filippo', age: 27 },
];

const faqs = [
  {
    q: 'Cosa sono i Milano Cocktail Days?',
    a: "È l'evento diffuso che per 10 giorni trasforma Milano nella capitale della mixology. Una volta l'anno, 30 tra i migliori bar della città creano un cocktail speciale, inedito e disponibile solo per la durata del festival. Tu compri il pass e ti godi il tour.",
  },
  {
    q: 'Quando si svolge la prossima edizione?',
    a: "L'appuntamento è per maggio 2027. Le date ufficiali verranno svelate a breve: iscriviti alla lista d'attesa per scoprirle in anteprima e non rischiare di rimanere fuori.",
  },
  {
    q: "Dove si tiene l'evento?",
    a: "Non c'è un'unica location: è un festival diffuso. I 30 bar partner (che annunceremo prestissimo) sono sparsi per tutta Milano. Ogni locale ti aprirà le porte per servirti la sua creazione esclusiva.",
  },
  {
    q: 'Devo comprare un biglietto per ogni bar?',
    a: "Assolutamente no. Compri un solo pass online (a partire da 15€) che ti dà accesso a tutti i 30 locali partner. Mostrando il pass, potrai ordinare il cocktail speciale dell'evento a soli 6€, invece del normale prezzo di listino (che di solito oscilla tra i 10€ e i 15€).",
  },
  {
    q: 'Bisogna prenotare nei locali?',
    a: "Nessuno stress: nessuna prenotazione e nessun itinerario fisso. Ti basta controllare gli orari di apertura del bar che hai scelto, presentarti al bancone e ordinare il drink mostrando il tuo pass direttamente dalla nostra webapp.",
  },
  {
    q: 'Dove posso acquistare il pass?',
    a: "I pass saranno disponibili esclusivamente online su questo sito. Iscriviti alla lista d'attesa per sapere esattamente quando apriranno le vendite e assicurarti i biglietti al prezzo Early Bird più basso.",
  },
  {
    q: 'Non sono un esperto di mixology, fa per me?',
    a: "Ma certo! MCD non è una fiera tecnica per addetti ai lavori, ma un evento per chiunque ami bere bene e scoprire posti nuovi. Che tu sia un intenditore o semplicemente in cerca di una bella serata, sei nel posto giusto.",
  },
  {
    q: 'Ha senso partecipare anche solo per un giorno?',
    a: "Sì, decisamente. È l'occasione perfetta per scoprire il tuo prossimo bar preferito o fare un viaggio lampo nella miscelazione di qualità. In più, economicamente conviene: se prendi il pass in anticipo, ti basta ordinare 3 cocktail per aver già ammortizzato il costo del biglietto.",
  },
  {
    q: 'I miei amici non vogliono venire, che faccio?',
    a: "Vieni da solo: il bello della cocktail culture è proprio questo. Scegli un locale, siediti al bancone e lascia fare ai bartender. I bar sono gli spazi sociali per eccellenza e i professionisti dietro al bancone sapranno farti sentire a casa e, perché no, farti fare nuove conoscenze.",
  },
  {
    q: "C'è un limite di età per partecipare?",
    a: "L'evento è riservato ai maggiori di 18 anni, poiché il programma dell'evento prevede esclusivamente bevande alcoliche.",
  },
];

---

<BaseLayout
  title="Milano Cocktail Days — Trenta bar, dieci giorni, un pass."
  description="Maggio 2027: trenta bar di Milano, dieci giorni, un cocktail inventato apposta in ogni bancone a €6. Mettiti in lista per i primi pass a €15."
  pageType="event"
>

  <!-- S01 · HERO ─────────────────────────────────────────────── -->
  <section class="s-hero" aria-labelledby="home-h1">
    <picture class="hero-bg" aria-hidden="true">
      <img
        src="/images/bar_photo1.jpg"
        alt=""
        width="1920" height="1080"
        fetchpriority="high" loading="eager"
      />
    </picture>
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="wrap hero-inner">
      <img src="/logos/logo_3_v.FINAL/Panna.svg" alt="Milan Cocktail Days" class="hero-logo" />

      <p class="hero-overline">
        Milano <span aria-hidden="true">✶</span> Maggio 2027 <span aria-hidden="true">✶</span> Prima Edizione
      </p>

      <h1 id="home-h1" class="hero-h1">
        Trenta bar di Milano.<br />Per dieci giorni.<br />Un solo biglietto.
      </h1>

      <p class="hero-sub">
        Ogni bar partner crea un cocktail unico a €6 (invece di €12-15) solo per chi ha il biglietto. 
        Iscriviti in lista d'attesa per assicurarti l'accesso.
      </p>

      <a href="#lista" class="btn btn--primary">
        Entra in lista d'attesa <span aria-hidden="true">✶</span>
      </a>
    </div>
  </section>

  <!-- S02 · COME FUNZIONA ────────────────────────────────────── -->
  <section class="s-how" aria-labelledby="how-h2">
    <div class="how-bg-glow" aria-hidden="true"></div>
    <div class="wrap">

      <h2 id="how-h2" class="how-h2 reveal">Come funziona<br />Milano Cocktail Days?</h2>

      <div class="how-steps-wrap">
        <div class="how-connector" aria-hidden="true"></div>
        <div class="how-steps">
          {steps.map(({ n, icon, title, desc }) => (
            <article class="how-card">
              <div class="how-card-top">
                <div class="how-card-num" aria-hidden="true">{n}</div>
                <div class="how-card-icon" aria-hidden="true" set:html={icon} />
              </div>
              <h3 class="how-card-title">{title}</h3>
              <div class="how-card-desc-box">
                <p class="how-card-desc">{desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>

      <div class="how-footer reveal reveal-d1">
        <p class="how-strap">
          Trenta locali, trenta ricette mai viste prima. Un nuovo modo di vivere la Milano da bere.
          <span aria-hidden="true">✶</span>
        </p>
        <a href="#lista" class="btn btn--primary how-cta">
        Entra in lista d'attesa <span aria-hidden="true">✶</span>
        </a>
      </div>

    </div>
  </section>

  <!-- S03 · PERCHÉ ISCRIVERSI ────────────────────────────────── -->
  <section class="s-why" aria-labelledby="why-h2">
    <div class="why-texture" aria-hidden="true"></div>
    <div class="wrap why-wrap">

      <div class="why-editorial">
        <p class="why-kicker">Early bird <span aria-hidden="true">✶</span> Prezzi lancio</p>
        <h2 id="why-h2" class="why-h2">
          Il miglior prezzo,<br />
          <em class="why-em">Solo per gli iscritti in lista d'attesa.</em>
        </h2>
        <p class="why-body">Il prezzo sale a €30 non appena finiscono i posti early bird.</p>
      </div>

      <div class="why-price-block">
        <div class="panel-price">
          <span class="price-from">Da</span>
          <span class="price-main">€15</span>
          <span class="price-was">€30</span>
        </div>
      </div>

      <div class="why-action">
        <div class="why-proof">
          <div class="proof-avatars" aria-hidden="true">
            <span class="avatar av-1"></span>
            <span class="avatar av-2"></span>
            <span class="avatar av-3"></span>
          </div>
          <p class="proof-copy"><strong class="proof-n">347</strong> già in lista</p>
        </div>
        <a href="#lista" class="btn btn--primary">
          Entra in lista d'attesa <span aria-hidden="true">✶</span>
        </a>
      </div>

    </div>
  </section>

  <!-- S05 · PER CHI È ────────────────────────────────────────── -->
  <section class="s-perchi" aria-labelledby="perchi-h2">
    <div class="wrap">

      <div class="perchi-header perchi-reveal">
        <p class="section-kicker section-kicker--light">Per chi è</p>
        <h2 id="perchi-h2" class="perchi-h2">
          Per chi ama Milano.<br />E per chi vuole conoscerla un cocktail alla volta.
        </h2>
      </div>

      <div class="perchi-cards">
        {perchiCards.map(({ title, desc, img, icon }) => (
          <article class="perchi-card perchi-reveal">
            <img src={img} alt="" class="perchi-card-img" loading="lazy" />
            <div class="perchi-card-overlay"></div>
            <div class="perchi-card-body">
              <div class="perchi-card-icon" set:html={icon} />
              <h3 class="perchi-card-title">{title}</h3>
              <p class="perchi-card-desc">{desc}</p>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- S06a · I BAR PARTNER ─────────────────────────────────────
  <section class="s-bars" aria-labelledby="bars-h2">
    <div class="wrap">
      <div class="bars-header reveal">
        <h2 id="bars-h2" class="bars-h2">Non tutti i bar di Milano. I trenta che contano.</h2>
        <p class="bars-lead">
          Bar indipendenti, bartender con un'idea, cocktail che parlano.
        </p>
      </div>

      <div class="criteria-grid">
        {criteria.map(({ title, desc, img }, i) => (
          <div class:list={['criterion-card', 'reveal', i === 1 && 'reveal-d1', i === 2 && 'reveal-d2']}>
            <div class="criterion-img-wrap">
              <img src={img} alt="" class="criterion-img" loading="lazy" />
            </div>
            <div class="criterion-body">
              <h3 class="criterion-title">{title}</h3>
              <p class="criterion-desc">{desc}</p>
            </div>
          </div>
        ))}
      </div>

      <a href="#lista" class="btn btn--primary bars-cta reveal reveal-d1">
        Entra in lista d'attesa <span aria-hidden="true">✶</span>
      </a>
    </div>
  </section> -->

  <!-- S06b · L'APP ───────────────────────────────────────────── -->
  <section class="s-app" aria-labelledby="app-h2">
    <div class="wrap app-inner">
      <div class="app-mock" aria-hidden="true">
        <img
          src="/images/Google Pixel 4 Mockup/app_user-portrait.png"
          alt=""
          class="mockup-img"
          loading="lazy"
        />
      </div>

      <div class="app-content">
        <h2 id="app-h2" class="app-h2 reveal">Tutto in una sola App</h2>
        <p class="app-sub reveal reveal-d1">
          Biglietto → mappa → QR → cocktail. Tutto in tre tap.
        </p>

        <div class="app-cards reveal reveal-d2">
{appFeatures.map(({ step, icon, title, desc, wide }) => (
            <div class:list={['app-card', { 'app-card--wide': wide }]}>
              <div class="app-card-header">
                <span class="app-card-icon" aria-hidden="true">{icon}</span>
                <span class="app-card-step" aria-hidden="true">{step}</span>
              </div>
              <h3 class="app-card-title">{title}</h3>
              <p class="app-card-desc">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- S07 · VOCI DALLA LISTA ─────────────────────────────────── -->
  <section class="s-quotes" aria-labelledby="quotes-h2">
    <div class="wrap quotes-header reveal">
      <h2 id="quotes-h2" class="quotes-h2">Cosa dice chi si è già registrato</h2>
      <p class="quotes-counter" aria-live="polite">
        <strong class="counter-num" id="counter-quotes">347</strong> persone già in lista
      </p>
    </div>

    <div class="quotes-outer">
      <div class="quotes-track" id="quotes-track" aria-label="Testimonianze">
        {[...quotes, ...quotes].map(({ text, name, age }, i) => (
          <article class="quote-card" aria-hidden={i >= quotes.length ? 'true' : 'false'}>
            <blockquote class="quote-text">"{text}"</blockquote>
            <footer class="quote-author">— {name}, {age}</footer>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- S08 · CTA FINALE ───────────────────────────────────────── -->
  <section class="s-cta-final" aria-labelledby="cta-final-h2">
    <picture class="cta-bg" aria-hidden="true">
      <img
        src="/images/Photo by Mahyaddin Jabbarli.jpg"
        alt=""
        class="cta-bg-img"
        loading="lazy"
        width="1920" height="1080"
      />
    </picture>
    <div class="cta-overlay" aria-hidden="true"></div>
    <div class="wrap cta-final-inner">
      <p class="section-kicker section-kicker--light reveal">Milano, Maggio 2027</p>
      <h2 id="cta-final-h2" class="cta-final-h2 reveal reveal-d1">
        Partecipa alla prima edizione.<br /> Maggio 2027.
      </h2>
      <a href="#lista" class="btn btn--final reveal reveal-d2">
        Entra in lista d'attesa <span aria-hidden="true">✶</span>
      </a>
      <p class="cta-trust reveal reveal-d3">Iscriviti alla lista d'attesa per ricevere accesso prioritario ai biglietti early bird al miglior prezzo.</p>
    </div>
  </section>

  <!-- FORM ───────────────────────────────────────────────────── -->
  <section class="s-lista" id="lista" aria-labelledby="lista-h2">
    <div class="wrap">
      <h2 id="lista-h2" class="lista-h2 reveal">
        Lista d'attesa <span aria-hidden="true">✶</span>
      </h2>
      <p class="lista-intro reveal reveal-d1">
        Iscriviti gratuitamente. Ti contatteremo per primo all'apertura ufficiale dei biglietti.
      </p>
      <div class="tally-wrap">
        <iframe
          data-tally-src="https://tally.so/embed/Y5pkp5?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1&hideFooter=1"
          loading="lazy"
          width="100%"
          height="689"
          title="Milan Cocktail Days — Lista d'attesa partecipanti"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- S09 · FAQ ──────────────────────────────────────────────── -->
  <section class="s-faq" aria-labelledby="faq-h2">
    <div class="wrap faq-wrap">

      <div class="faq-header reveal">
        <p class="section-kicker">FAQ</p>
        <h2 id="faq-h2" class="faq-h2">Domande,<br />in due righe.</h2>
      </div>

      <div class="faq-list reveal reveal-d1" id="faq-list">
        {faqs.map(({ q, a }) => (
          <details class="faq-item">
            <summary class="faq-q">
              {q}
              <span class="faq-icon" aria-hidden="true">✶</span>
            </summary>
            <p class="faq-a">{a}</p>
          </details>
        ))}
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  .wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ── SECTION KICKER ───────────────────────────────────────── */
  .section-kicker {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-basilico);
    margin: 0 0 var(--space-sm);
    display: block;
  }
  .section-kicker--light {
    color: var(--color-pesco-300);
    opacity: 0.8;
  }

  /* ── HERO ─────────────────────────────────────────────────── */
  .s-hero {
    position: relative;
    min-height: 885px;
    display: flex;
    align-items: center;
    padding: clamp(2rem, 5vw, 4rem) 0;
    overflow: hidden;
    background-color: var(--color-mora);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 80% center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-inchiostro) 55%, transparent) 0%,
      color-mix(in srgb, var(--color-inchiostro) 15%, transparent) 30%,
      transparent 60%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    max-width: 720px;
    padding: 32px 40px;
    background: color-mix(in srgb, var(--color-inchiostro) 30%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid color-mix(in srgb, var(--color-panna) 14%, transparent);
    border-radius: var(--radius-md);
  }

  .hero-logo {
    height: auto;
    max-width: 500px;
    width: 100%;
    display: block;
    object-fit: contain;
    margin-bottom: var(--space-md);
  }

  .hero-overline {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-panna);
    opacity: 0.65;
    margin: 0;
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.25rem, 5.5vw, 5rem);
    color: var(--color-panna);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .hero-sub {
    font-family: var(--font-body);
    font-size: 30px;
    color: var(--color-pesco-300);
    line-height: 1.6;
    margin: 0;
    max-width: 480px;
  }

  /* ── SHARED BTN ───────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.875rem 2rem;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    margin-top: var(--space-sm);
  }

  .btn--primary {
    background-color: var(--color-bitter);
    color: var(--color-panna);
    border: 1px solid var(--color-bitter);
  }

  .btn--primary:hover {
    background-color: var(--color-bitter-500);
    border-color: var(--color-bitter-500);
  }

  .btn--final {
    background-color: var(--color-bitter);
    color: var(--color-panna);
    border: 1px solid var(--color-bitter);
    font-size: var(--text-body);
    padding: 1rem 2.5rem;
    margin-top: 0;
  }

  .btn--final:hover {
    background-color: var(--color-bitter-500);
    border-color: var(--color-bitter-500);
  }

  /* ── COME FUNZIONA ────────────────────────────────────────── */
  .s-how {
    background-color: var(--color-fumo);
    padding: clamp(3rem, 6vw, 5rem) 0;
    position: relative;
    overflow: hidden;
  }

  .how-bg-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(ellipse 55% 45% at 85% 15%, color-mix(in srgb, var(--color-bitter) 22%, transparent), transparent),
      radial-gradient(ellipse 45% 55% at 5% 85%, color-mix(in srgb, var(--color-basilico) 35%, transparent), transparent),
      radial-gradient(ellipse 40% 40% at 50% 50%, color-mix(in srgb, var(--color-mora) 25%, transparent), transparent);
  }

  .s-how .wrap {
    position: relative;
    z-index: 2;
  }

  .how-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 60px;
    color: var(--color-panna);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0 0 30px;
  }

  .how-steps-wrap {
    position: relative;
    margin-bottom: 30px;
  }

  .how-connector {
    position: absolute;
    top: 1.5rem;
    left: calc(100% / 6);
    right: calc(100% / 6);
    height: 1px;
    background: linear-gradient(to right,
      transparent,
      color-mix(in srgb, var(--color-bitter) 80%, transparent) 20%,
      color-mix(in srgb, var(--color-bitter) 80%, transparent) 80%,
      transparent
    );
    box-shadow: 0 0 8px color-mix(in srgb, var(--color-bitter) 40%, transparent);
    z-index: 0;
    pointer-events: none;
  }

  .how-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    position: relative;
    z-index: 1;
  }

  .how-card {
    background-color: color-mix(in srgb, var(--color-panna) 8%, var(--color-mora));
    border: 1.5px solid color-mix(in srgb, var(--color-bitter) 35%, transparent);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-md) var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease,
      box-shadow 0.35s ease,
      border-color 0.35s ease;
    box-shadow: 0 4px 24px color-mix(in srgb, var(--color-inchiostro) 40%, transparent);
  }

  .how-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .how-card:nth-child(2) { transition-delay: 0.1s; }
  .how-card:nth-child(3) { transition-delay: 0.2s; }

  .how-card:hover {
    box-shadow:
      0 24px 64px color-mix(in srgb, var(--color-mora) 70%, transparent),
      0 0 60px color-mix(in srgb, var(--color-bitter) 30%, transparent),
      0 0 0 1px color-mix(in srgb, var(--color-bitter) 60%, transparent);
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--color-bitter) 70%, transparent);
  }

  .how-card.is-visible:hover {
    transform: translateY(-6px);
  }

  .how-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-xs);
  }

  .how-card-num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--color-bitter);
    line-height: 1;
    letter-spacing: -0.03em;
    text-shadow: 0 0 20px color-mix(in srgb, var(--color-bitter) 50%, transparent);
  }

  .how-card-icon {
    color: var(--color-panna);
    opacity: 1;
    flex-shrink: 0;
    width: 2.4rem;
    height: 2.4rem;
    background: var(--color-bitter);
    border-radius: 50%;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 16px color-mix(in srgb, var(--color-bitter) 50%, transparent);
  }

  .how-card-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .how-card-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h3);
    color: var(--color-panna);
    letter-spacing: 0.01em;
    margin: 0;
    line-height: 1.2;
  }

  .how-card-desc-box {
    margin-top: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
    background-color: color-mix(in srgb, var(--color-panna) 10%, transparent);
    border-left: 2px solid color-mix(in srgb, var(--color-bitter) 75%, transparent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .how-card-desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-pesco-300);
    line-height: 1.6;
    margin: 0;
    opacity: 1;
  }

  .how-footer {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
    padding-top: var(--space-md);
    border-top: var(--border-hairline-dark);
  }

  .how-strap {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
    color: var(--color-panna);
    line-height: 1.2;
    margin: 0;
    flex: 1;
  }

  .how-cta {
    margin-top: 0;
    flex-shrink: 0;
  }

  /* ── PERCHÉ ISCRIVERSI ────────────────────────────────────── */
  .s-why {
    background: var(--color-panna);
    padding: clamp(1.5rem, 3vw, 2.5rem) 0; 
    position: relative;
    overflow: hidden;
    border-top: 0.5px solid var(--color-panna-300);
    border-bottom: 0.5px solid var(--color-panna-300);
  }

  .why-texture {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-basilico) 5%, transparent) 1px,
      transparent 1px
    );
    background-size: 20px 20px;
    z-index: 0;
  }

  .why-wrap {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    flex-wrap: wrap;
  }

  .why-editorial {
    flex: 1;
    min-width: 220px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .why-kicker {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-basilico);
    opacity: 0.55;
    margin: 0;
  }

  .why-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    color: var(--color-mora);
    line-height: 1.1;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .why-em {
    font-style: italic;
    font-weight: 700;
    color: var(--color-bitter);
  }

  .why-body {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro-500);
    line-height: 1.5;
    margin: 0.25rem 0 0;
  }

  .why-price-block {
    flex-shrink: 0;
    border-left: 0.5px solid var(--color-panna-300);
    border-right: 0.5px solid var(--color-panna-300);
    padding: 0 clamp(1.5rem, 3vw, 3rem);
  }

  .panel-price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .price-from {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-inchiostro-500);
  }

  .price-main {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--color-bitter);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .price-was {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-inchiostro-300);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
    opacity: 0.55;
    align-self: center;
  }

  .why-action {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .why-proof {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .proof-avatars {
    display: flex;
  }

  .avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1.5px solid var(--color-panna);
    margin-left: -8px;
  }

  .av-1 { background: var(--color-bitter-500); margin-left: 0; }
  .av-2 { background: var(--color-basilico); }
  .av-3 { background: var(--color-mora-300); }

  .proof-copy {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro-500);
    margin: 0;
  }

  .proof-n {
    color: var(--color-mora);
    font-weight: 700;
  }


  /* ── PER CHI È ────────────────────────────────────────────── */
  .s-perchi {
    background-color: var(--color-basilico);
    padding: clamp(3rem, 6vw, 5rem) 0;
    overflow: hidden;
    position: relative;
  }

  .perchi-header {
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .perchi-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 4vw, 3.5rem);
    color: var(--color-panna);
    line-height: 1.05;
    margin: 0.5rem 0 0;
    letter-spacing: -0.025em;
  }

  .perchi-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }

  .perchi-card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 3 / 4;
    border: 1px solid color-mix(in srgb, var(--color-panna) 15%, transparent);
    cursor: default;
  }

  .perchi-card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .perchi-card:hover .perchi-card-img {
    transform: scale(1.05);
  }

  .perchi-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-inchiostro) 90%, transparent) 0%,
      color-mix(in srgb, var(--color-inchiostro) 55%, transparent) 40%,
      color-mix(in srgb, var(--color-inchiostro) 15%, transparent) 70%,
      transparent 100%
    );
  }

  .perchi-card-body {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .perchi-card-icon {
    width: 2.5rem;
    height: 2.5rem;
    background: var(--color-bitter);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-panna);
    padding: 0.5rem;
    margin-bottom: var(--space-xs);
    box-shadow: 0 0 16px color-mix(in srgb, var(--color-bitter) 45%, transparent);
    flex-shrink: 0;
  }

  .perchi-card-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .perchi-card-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-h5);
    color: var(--color-panna);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0;
    line-height: 1.2;
  }

  .perchi-card-desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-pesco-300);
    line-height: 1.6;
    margin: 0;
  }

  /* scroll-reveal states */
  .perchi-reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .perchi-reveal:nth-child(2) { transition-delay: 0.1s; }
  .perchi-reveal:nth-child(3) { transition-delay: 0.2s; }
  .perchi-reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  /* ── BAR PARTNER ──────────────────────────────────────────── */
  .s-bars {
    background-color: var(--color-avorio);
    padding: clamp(1.75rem, 3.5vw, 2.5rem) 0;
  }

  .bars-header {
    display: flex;
    align-items: baseline;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-bottom: var(--space-md);
    flex-wrap: wrap;
  }

  .bars-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    color: var(--color-mora);
    line-height: 1.05;
    margin: 0;
    flex: 1;
    min-width: 220px;
  }

  .bars-lead {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro-500);
    line-height: 1.65;
    margin: 0;
    flex: 1;
    min-width: 220px;
  }

  .criteria-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .criterion-card {
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-panna);
    border: 0.5px solid var(--color-panna-300);
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }

  .criterion-card:hover {
    box-shadow: 0 12px 40px color-mix(in srgb, var(--color-mora) 12%, transparent);
    transform: translateY(-4px);
  }

  .criterion-img-wrap {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: var(--color-panna-300);
  }

  .criterion-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .criterion-card:hover .criterion-img {
    transform: scale(1.05);
  }

  .criterion-body {
    padding: var(--space-sm) var(--space-sm) var(--space-md);
    border-top: 2px solid var(--color-basilico);
    flex: 1;
  }

  .criterion-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-body);
    color: var(--color-mora);
    margin: 0 0 var(--space-xs);
  }

  .criterion-desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro-500);
    line-height: 1.65;
    margin: 0;
  }

  .bars-cta {
    margin-top: 0;
  }

  /* ── APP ──────────────────────────────────────────────────── */
  .s-app {
    background-color: var(--color-panna);
    padding: clamp(2rem, 5vw, 4rem) 0;
  }

  .app-inner {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--space-lg);
    align-items: center;
  }

  .app-mock {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .mockup-img {
    max-width: 260px;
    width: 100%;
    height: auto;
    display: block;
  }

  .app-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .app-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-inchiostro);
    line-height: 1.05;
    margin: 0;
  }

  .app-sub {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-inchiostro-500);
    line-height: 1.6;
    margin: 0;
    opacity: 0.85;
  }

  .app-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
    position: relative;
  }

.app-card {
    background-color: color-mix(in srgb, var(--color-inchiostro) 5%, var(--color-panna));
    border: 1.5px solid color-mix(in srgb, var(--color-bitter) 35%, transparent);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    position: relative;
    z-index: 1;
  }

  .app-card:hover {
    background-color: color-mix(in srgb, var(--color-inchiostro) 9%, var(--color-panna));
    border-color: var(--color-bitter);
    box-shadow: 0 0 24px color-mix(in srgb, var(--color-bitter) 15%, transparent);
  }

  .app-card--wide {
    grid-column: 1 / -1;
  }

  .app-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-xs);
  }

  .app-card-icon {
    font-size: 2.2rem;
    line-height: 1;
    display: block;
    margin-bottom: var(--space-xs);
  }

  .app-card-step {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.5rem;
    color: var(--color-bitter);
    opacity: 0.5;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .app-card:hover .app-card-step {
    opacity: 0.85;
  }

  .app-card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h5);
    color: var(--color-inchiostro);
    margin: 0 0 var(--space-xs);
    letter-spacing: 0.02em;
  }

  .app-card-desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro-500);
    line-height: 1.65;
    margin: 0;
    opacity: 0.85;
  }

  /* ── VOCI DALLA LISTA ─────────────────────────────────────── */
  .s-quotes {
    background-color: var(--color-panna-100);
    padding: clamp(2rem, 5vw, 4rem) 0;
    overflow: hidden;
    border-top: 0.5px solid var(--color-panna-300);
    border-bottom: 0.5px solid var(--color-panna-300);
  }

  .quotes-header {
    margin-bottom: var(--space-md);
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .quotes-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h2);
    color: var(--color-mora);
    margin: 0;
  }

  .quotes-counter {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro-500);
    margin: 0;
  }

  .quotes-counter .counter-num {
    font-size: var(--text-body);
    color: var(--color-basilico);
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .quotes-outer {
    overflow: hidden;
    padding: 0 0 var(--space-sm);
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .quotes-track {
    display: flex;
    gap: var(--space-md);
    width: max-content;
    animation: marquee 40s linear infinite;
  }

  .quotes-outer:hover .quotes-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .quotes-track { animation: none; }
    .quotes-outer { overflow-x: auto; }
  }

  .quote-card {
    flex: 0 0 min(320px, 80vw);
    background-color: var(--color-panna);
    border: 0.5px solid var(--color-panna-300);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .quote-text {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--text-body);
    color: var(--color-mora);
    line-height: 1.65;
