---
import BaseLayout from '../layouts/BaseLayout.astro';
import TickerBand from '../components/TickerBand.astro';

const brands = [
  'Tanqueray', 'Campari', 'Amaro Montenegro',
  'Fever-Tree', 'Martini', "Hendrick's",
  'Bulleit', 'Aperol', 'Cynar', 'Santa Teresa',
];

const proofRows = [
  { ed: '1ª edizione', bar: '18', part: '600', tag: '' },
  { ed: '3ª edizione', bar: '45', part: '2.400', tag: '+300%' },
  { ed: '5ª edizione', bar: '80', part: '6.000', tag: '+150%' },
];
---

<BaseLayout
  title="Milan Cocktail Days 2027"
  description="Un pass. La città intera. La prima Milano festival dedicata al cocktail. Aprile–Maggio 2027."
  pageType="event"
>

  <!-- HERO -------------------------------------------------- -->
  <section class="s-hero" aria-labelledby="home-h1">
    <picture class="hero-bg" aria-hidden="true">
      <img
        src="/images/Milano Cocktail Days Image May 15 2026.png"
        alt=""
        width="1920" height="1080"
        fetchpriority="high" loading="eager"
      />
    </picture>
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="wrap hero-inner">
      <p class="hero-overline">Milano · Aprile–Maggio 2027</p>

      <div class="hero-h1-wrap mcw-bracket">
        <h1 id="home-h1" class="hero-h1">
          Un pass.<br /><em>La città</em><br />intera.
        </h1>
      </div>

      <p class="hero-sub">La prima settimana dedicata al cocktail a Milano.</p>

      <div class="hero-cta">
        <a href="/partecipa" class="btn btn--primary">Voglio partecipare</a>
        <a href="/bar" class="btn btn--ghost">Sei un bar →</a>
        <a href="/sponsor" class="btn btn--ghost">Diventa sponsor →</a>
      </div>
    </div>
  </section>

  <!-- TICKER ------------------------------------------------ -->
  <TickerBand items={brands} />

  <!-- SOCIAL PROOF ------------------------------------------ -->
  <section class="s-proof" aria-labelledby="proof-h2">
    <div class="wrap proof-inner">
      <div class="proof-text">
        <p class="section-overline">Il modello funziona</p>
        <h2 id="proof-h2" class="section-h2">
          Già testato.<br />Ora a Milano.
        </h2>
        <p class="proof-body">
          CocktailX Munich ha dimostrato che il bar-hopping festival funziona.
          Stiamo portando lo stesso format nella città più vivace d'Italia
          per la sua cocktail culture.
        </p>
      </div>
      <div class="proof-table-wrap">
        <p class="table-label">CocktailX Munich · crescita per edizione</p>
        <table class="proof-table" aria-label="Crescita CocktailX Munich per edizione">
          <thead>
            <tr>
              <th scope="col">Edizione</th>
              <th scope="col">Bar</th>
              <th scope="col">Partecipanti</th>
              <th scope="col">Crescita</th>
            </tr>
          </thead>
          <tbody>
            {proofRows.map(({ ed, bar, part, tag }) => (
              <tr>
                <td>{ed}</td>
                <td class="num-cell">{bar}</td>
                <td class="num-cell">{part}</td>
                <td class="tag-cell">
                  {tag && <span class="growth-tag">{tag}</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 3 AUDIENCE CARDS -------------------------------------- -->
  <section class="s-cards" aria-label="A chi è rivolto Milan Cocktail Days">
    <div class="wrap">
      <p class="section-overline--center">Scegli il tuo percorso</p>

      <div class="cards-grid">

        <!-- CARD 1: Partecipanti (primary) -->
        <article class="aud-card aud-card--primary" aria-labelledby="card-part-h3">
          <div class="aud-card-top">
            <span class="aud-label">Partecipanti</span>
            <span class="aud-badge">Priorità</span>
          </div>
          <h3 id="card-part-h3" class="aud-title">
            Esplora Milano<br />cocktail per cocktail
          </h3>
          <p class="aud-desc">
            Un pass. Tutti i bar. Cocktail signature a €6 per serata.
            Scopri angoli di Milano che non sapevi di amare.
          </p>
          <ul class="aud-features" role="list">
            <li>Pass Festival · accesso a tutti i bar</li>
            <li>10 serate · 10 bar diversi</li>
            <li>Cocktail signature esclusivi MCD</li>
            <li>App con mappa e itinerari</li>
          </ul>
          <a href="/partecipa" class="aud-cta aud-cta--primary">
            Entra in lista d'attesa →
          </a>
        </article>

        <!-- CARD 2: Bar Partner -->
        <article class="aud-card aud-card--secondary" aria-labelledby="card-bar-h3">
          <div class="aud-card-top">
            <span class="aud-label">Bar Partner</span>
          </div>
          <h3 id="card-bar-h3" class="aud-title aud-title--light">
            Porta il tuo bar<br />nella selezione
          </h3>
          <p class="aud-desc aud-desc--light">
            €0 fee. €6 fisso sul cocktail. Traffico qualificato
            di appassionati direttamente nel tuo locale.
          </p>
          <a href="/bar" class="aud-cta aud-cta--ghost">
            Candida il tuo bar →
          </a>
        </article>

        <!-- CARD 3: Sponsor -->
        <article class="aud-card aud-card--tertiary" aria-labelledby="card-spo-h3">
          <div class="aud-card-top">
            <span class="aud-label aud-label--light">Sponsor</span>
          </div>
          <h3 id="card-spo-h3" class="aud-title aud-title--light">
            Raggiungi chi<br />conosce il settore
          </h3>
          <p class="aud-desc aud-desc--light">
            Brand beverage, tech e mobility. Un pubblico premium,
            un contesto curato, un evento in crescita.
          </p>
          <a href="/sponsor" class="aud-cta aud-cta--ghost">
            Parliamone →
          </a>
        </article>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ---- HERO --------------------------------------------- */
  .s-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: var(--section-py) 0;
    background-color: var(--color-panna);
    background-image: url('/images/Milano Cocktail Days Image May 15 2026.png');
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 80% center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      var(--color-panna) 0%,
      var(--color-panna) 30%,
      color-mix(in srgb, var(--color-panna) 85%, transparent) 50%,
      color-mix(in srgb, var(--color-panna) 20%, transparent) 70%,
      transparent 100%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    max-width: 40%;
    margin-left: 100px;
  }

  .hero-overline {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-basilico);
    margin: 0;
  }

  .hero-h1-wrap {
    padding: var(--space-sm) var(--space-md);
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-hero);
    color: var(--color-basilico);
    line-height: 0.92;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .hero-h1 em {
    font-style: italic;
    color: var(--color-mora);
  }

  .hero-sub {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--text-body-lg);
    color: var(--color-mora);
    line-height: 1.5;
    margin: 0;
  }

  .hero-cta {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-sm);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 2rem;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .btn--primary {
    background-color: var(--color-bitter);
    color: var(--color-panna);
    border: 1px solid var(--color-bitter);
  }

  .btn--primary:hover {
    background-color: var(--color-bitter-500);
    border-color: var(--color-bitter-500);
  }

  .btn--ghost {
    background-color: transparent;
    color: var(--color-mora);
    border: 1px solid var(--color-mora);
  }

  .btn--ghost:hover {
    color: var(--color-basilico);
    border-color: var(--color-basilico);
  }

  /* ---- SOCIAL PROOF ------------------------------------- */
  .s-proof {
    background-color: var(--color-avorio);
    padding: var(--section-py) 0;
  }

  .proof-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .section-overline {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-basilico);
    margin: 0 0 var(--space-xs);
  }

  .section-overline--center {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-panna);
    opacity: 0.65;
    text-align: center;
    margin: 0 0 var(--space-lg);
  }

  .section-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-mora);
    line-height: 1.05;
    margin-bottom: var(--space-sm);
  }

  .proof-body {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-inchiostro);
    line-height: 1.75;
    margin: 0;
  }

  .table-label {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-inchiostro-500);
    margin-bottom: var(--space-sm);
  }

  .proof-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
    font-size: var(--text-small);
  }

  .proof-table thead tr {
    border-bottom: 1px solid var(--color-basilico);
  }

  .proof-table th {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 11px;
    color: var(--color-basilico);
    padding: 8px 12px 8px 0;
    text-align: left;
  }

  .proof-table td {
    padding: 12px 12px 12px 0;
    color: var(--color-inchiostro);
    border-bottom: 0.5px solid var(--color-panna-300);
  }

  .num-cell {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-body);
    color: var(--color-mora);
  }

  .growth-tag {
    display: inline-block;
    background-color: var(--color-basilico);
    color: var(--color-panna);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }

  /* ---- 3 AUDIENCE CARDS --------------------------------- */
  .s-cards {
    background-color: var(--color-fumo);
    padding: var(--section-py) 0;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: var(--space-md);
    align-items: stretch;
  }

  .aud-card {
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .aud-card--primary {
    background-color: var(--color-avorio);
    border: 1px solid var(--color-panna-300);
  }

  .aud-card--secondary {
    background-color: var(--color-mora);
    border: 0.5px solid var(--color-mora-300);
  }

  .aud-card--tertiary {
    background-color: var(--color-marmo);
    border: 0.5px solid color-mix(in srgb, var(--color-panna) 15%, transparent);
  }

  .aud-card-top {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .aud-label {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-basilico);
  }

  .aud-label--light {
    color: var(--color-panna);
    opacity: 0.6;
  }

  .aud-badge {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    background-color: var(--color-bitter);
    color: var(--color-panna);
  }

  .aud-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h2);
    color: var(--color-mora);
    line-height: 1.05;
    margin: 0;
  }

  .aud-title--light {
    color: var(--color-panna);
  }

  .aud-desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro-500);
    line-height: 1.7;
    margin: 0;
  }

  .aud-desc--light {
    color: var(--color-pesco-300);
    opacity: 0.85;
  }

  .aud-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 0.5px solid var(--color-panna-300);
    padding-top: var(--space-sm);
  }

  .aud-features li {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro);
    padding-left: 16px;
    position: relative;
    line-height: 1.5;
  }

  .aud-features li::before {
    content: "✶";
    position: absolute;
    left: 0;
    color: var(--color-bitter);
    font-size: 8px;
    top: 5px;
  }

  .aud-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease, color 0.2s ease;
    margin-top: auto;
    align-self: flex-start;
  }

  .aud-cta--primary {
    background-color: var(--color-bitter);
    color: var(--color-panna);
    border: 1px solid var(--color-bitter);
  }

  .aud-cta--primary:hover {
    background-color: var(--color-bitter-500);
    border-color: var(--color-bitter-500);
  }

  .aud-cta--ghost {
    background-color: transparent;
    color: var(--color-panna);
    border: 1px solid color-mix(in srgb, var(--color-panna) 40%, transparent);
  }

  .aud-cta--ghost:hover {
    border-color: var(--color-panna);
  }

  /* ---- RESPONSIVE --------------------------------------- */
  @media (max-width: 900px) {
    .proof-inner { grid-template-columns: 1fr; }
    .cards-grid  { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .hero-inner {
      max-width: 100%;
      margin-left: 0;
    }
    .hero-overlay {
      background: var(--color-panna);
      opacity: 0.92;
    }
    .hero-cta {
      flex-direction: column;
      width: 100%;
    }
    .btn { width: 100%; justify-content: center; }
  }
</style>
