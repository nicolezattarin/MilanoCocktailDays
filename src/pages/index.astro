---
import BaseLayout from '../layouts/BaseLayout.astro';
import TickerBand from '../components/TickerBand.astro';

const brands = [
  'Tanqueray', 'Campari', 'Amaro Montenegro',
  'Fever-Tree', 'Martini', "Hendrick's",
  'Bulleit', 'Aperol', 'Cynar', 'Santa Teresa',
];

const proofRows = [
  { ed: '1ª edizione', bar: '18', part: '600', tag: '' },
  { ed: '3ª edizione', bar: '45', part: '2.400', tag: '+300%' },
  { ed: '5ª edizione', bar: '80', part: '6.000', tag: '+150%' },
];
---

<BaseLayout
  title="Milan Cocktail Days 2027"
  description="Un pass. La città intera. La prima Milano festival dedicata al cocktail. Aprile–Maggio 2027."
  pageType="event"
>

  <!-- HERO -------------------------------------------------- -->
  <section class="s-hero" aria-labelledby="home-h1">
    <picture class="hero-bg" aria-hidden="true">
      <img
        src="/images/bar_photo1.jpg"
        alt=""
        width="1920" height="1080"
        fetchpriority="high" loading="eager"
      />
    </picture>

    <div class="hero-card-wrapper">
      <div class="hero-card">
        <div class="wrap hero-inner">
          <p class="hero-overline">Milano · Aprile–Maggio 2027</p>

          <div class="hero-h1-wrap mcw-bracket">
            <h1 id="home-h1" class="hero-h1">
              Un pass.<br /><em>La città</em><br />intera.
            </h1>
          </div>

          <p class="hero-sub">La prima settimana dedicata al cocktail a Milano.</p>

          <div class="hero-cta">
            <a href="/partecipa" class="btn btn--primary">Voglio partecipare</a>
            <a href="/bar" class="btn btn--ghost">Sei un bar →</a>
            <a href="/sponsor" class="btn btn--ghost">Diventa sponsor →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TICKER ------------------------------------------------ -->
  <TickerBand items={brands} />

  <!-- SOCIAL PROOF ------------------------------------------ -->
  <section class="s-proof" aria-labelledby="proof-h2">
    <div class="wrap proof-inner">
      <div class="proof-visual">
        <img src="https://images.unsplash.com/photo-1514432324607-2e467f4af3fb?w=600&h=400&fit=crop" alt="CocktailX Munich event" class="proof-image" />
      </div>
      <div class="proof-text">
        <p class="section-overline">Il modello funziona</p>
        <h2 id="proof-h2" class="section-h2">
          Già testato.<br />Ora a Milano.
        </h2>
        <p class="proof-body">
          CocktailX Munich ha dimostrato che il bar-hopping festival funziona.
          Stiamo portando lo stesso format nella città più vivace d'Italia
          per la sua cocktail culture.
        </p>
        <div class="proof-stats">
          <div class="stat-item">
            <span class="stat-number">100k+</span>
            <span class="stat-label">Ospiti totali</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">45+</span>
            <span class="stat-label">Bar partner</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">5</span>
            <span class="stat-label">Edizioni</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 AUDIENCE CARDS -------------------------------------- -->
  <section class="s-cards" aria-label="A chi è rivolto Milan Cocktail Days">
    <div class="wrap">
      <p class="section-overline--center">Scegli il tuo percorso</p>

      <div class="cards-grid">

        <!-- CARD 1: Partecipanti (primary) -->
        <article class="aud-card aud-card--primary" aria-labelledby="card-part-h3">
          <div class="card-image-wrap">
            <img src="https://images.unsplash.com/photo-1514432324607-2e467f4af3fb?w=500&h=300&fit=crop" alt="Partecipanti al festival" class="card-image" />
          </div>
          <div class="card-content">
            <div class="aud-card-top">
              <span class="aud-label">Partecipanti</span>
              <span class="aud-badge">Priorità</span>
            </div>
            <h3 id="card-part-h3" class="aud-title">
              Esplora Milano<br />cocktail per cocktail
            </h3>
            <p class="aud-desc">
              Un pass. Tutti i bar. Cocktail signature a €6 per serata.
              Scopri angoli di Milano che non sapevi di amare.
            </p>
            <ul class="aud-features" role="list">
              <li>Pass Festival · accesso a tutti i bar</li>
              <li>10 serate · 10 bar diversi</li>
              <li>Cocktail signature esclusivi MCD</li>
              <li>App con mappa e itinerari</li>
            </ul>
            <a href="/partecipa" class="aud-cta aud-cta--primary">
              Entra in lista d'attesa →
            </a>
          </div>
        </article>

        <!-- CARD 2: Bar Partner -->
        <article class="aud-card aud-card--secondary" aria-labelledby="card-bar-h3">
          <div class="card-image-wrap">
            <img src="https://images.unsplash.com/photo-1521017143531-fbd100d7d604?w=500&h=300&fit=crop" alt="Bar partner event" class="card-image" />
          </div>
          <div class="card-content">
            <div class="aud-card-top">
              <span class="aud-label aud-label--dark">Bar Partner</span>
            </div>
            <h3 id="card-bar-h3" class="aud-title aud-title--light">
              Porta il tuo bar<br />nella selezione
            </h3>
            <p class="aud-desc aud-desc--light">
              €0 fee. €6 fisso sul cocktail. Traffico qualificato
              di appassionati direttamente nel tuo locale.
            </p>
            <a href="/bar" class="aud-cta aud-cta--ghost">
              Candida il tuo bar →
            </a>
          </div>
        </article>

        <!-- CARD 3: Sponsor -->
        <article class="aud-card aud-card--tertiary" aria-labelledby="card-spo-h3">
          <div class="card-image-wrap">
            <img src="https://images.unsplash.com/photo-1511632765486-a01980e01a18?w=500&h=300&fit=crop" alt="Sponsor partnership" class="card-image" />
          </div>
          <div class="card-content">
            <div class="aud-card-top">
              <span class="aud-label aud-label--light">Sponsor</span>
            </div>
            <h3 id="card-spo-h3" class="aud-title aud-title--light">
              Raggiungi chi<br />conosce il settore
            </h3>
            <p class="aud-desc aud-desc--light">
              Brand beverage, tech e mobility. Un pubblico premium,
              un contesto curato, un evento in crescita.
            </p>
            <a href="/sponsor" class="aud-cta aud-cta--ghost">
              Parliamone →
            </a>
          </div>
        </article>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ---- HERO --------------------------------------------- */
  .s-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: var(--section-py) 0;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-card-wrapper {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    padding-left: 2rem;
    background: linear-gradient(
      to right,
      rgba(0, 0, 0, 0.25) 0%,
      rgba(0, 0, 0, 0.15) 25%,
      transparent 60%
    );
  }

  .hero-card {
    backdrop-filter: blur(8px);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    opacity: 1;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    max-width: 500px;
  }

  .hero-overline {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-panna);
    margin: 0;
  }

  .hero-h1-wrap {
    padding: var(--space-sm) var(--space-md);
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-hero);
    color: var(--color-panna);
    line-height: 0.92;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .hero-h1 em {
    font-style: italic;
    color: var(--color-panna);
  }

  .hero-sub {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--text-body-lg);
    color: var(--color-panna);
    line-height: 1.5;
    margin: 0;
  }

  .hero-cta {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-sm);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 2rem;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .btn--primary {
    background-color: var(--color-bitter);
    color: var(--color-panna);
    border: 1px solid var(--color-bitter);
  }

  .btn--primary:hover {
    background-color: var(--color-bitter-500);
    border-color: var(--color-bitter-500);
  }

  .btn--ghost {
    background-color: rgba(255, 255, 255, 0.2);
    color: var(--color-panna);
    border: 1px solid rgba(255, 255, 255, 0.4);
  }

  .btn--ghost:hover {
    background-color: rgba(255, 255, 255, 0.3);
    border-color: var(--color-panna);
  }

  /* ---- SOCIAL PROOF ------------------------------------- */
  .s-proof {
    background-color: var(--color-avorio);
    padding: var(--section-py) 0;
  }

  .proof-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .proof-visual {
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  }

  .proof-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4/3;
    object-fit: cover;
  }

  .proof-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-panna-300);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 900;
    color: var(--color-bitter);
    line-height: 1;
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-basilico);
    opacity: 0.7;
  }

  .section-overline {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-basilico);
    margin: 0 0 var(--space-xs);
  }

  .section-overline--center {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-panna);
    opacity: 0.65;
    text-align: center;
    margin: 0 0 var(--space-lg);
  }

  .section-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-mora);
    line-height: 1.05;
    margin-bottom: var(--space-sm);
  }

  .proof-body {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-inchiostro);
    line-height: 1.75;
    margin: 0;
  }

  /* ---- 3 AUDIENCE CARDS --------------------------------- */
  .s-cards {
    background-color: var(--color-fumo);
    padding: var(--section-py) 0;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: var(--space-md);
    align-items: stretch;
  }

  .aud-card {
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: 0;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .aud-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
  }

  .card-image-wrap {
    overflow: hidden;
    height: 200px;
  }

  .card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .aud-card:hover .card-image {
    transform: scale(1.05);
  }

  .card-content {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    flex-grow: 1;
  }

  .aud-card--primary {
    background-color: var(--color-avorio);
    border: 1px solid var(--color-panna-300);
  }

  .aud-card--secondary {
    background-color: var(--color-mora);
    border: 0.5px solid var(--color-mora-300);
  }

  .aud-card--tertiary {
    background-color: var(--color-marmo);
    border: 0.5px solid color-mix(in srgb, var(--color-panna) 15%, transparent);
  }

  .aud-card-top {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .aud-label {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-basilico);
  }

  .aud-label--light {
    color: var(--color-panna);
    opacity: 0.6;
  }

  .aud-label--dark {
    color: var(--color-panna);
    opacity: 0.7;
  }

  .aud-badge {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    background-color: var(--color-bitter);
    color: var(--color-panna);
  }

  .aud-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h2);
    color: var(--color-mora);
    line-height: 1.05;
    margin: 0;
  }

  .aud-title--light {
    color: var(--color-panna);
  }

  .aud-desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro-500);
    line-height: 1.7;
    margin: 0;
  }

  .aud-desc--light {
    color: var(--color-pesco-300);
    opacity: 0.85;
  }

  .aud-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 0.5px solid var(--color-panna-300);
    padding-top: var(--space-sm);
  }

  .aud-features li {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro);
    padding-left: 16px;
    position: relative;
    line-height: 1.5;
  }

  .aud-features li::before {
    content: "✶";
    position: absolute;
    left: 0;
    color: var(--color-bitter);
    font-size: 8px;
    top: 5px;
  }

  .aud-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease, color 0.2s ease;
    margin-top: auto;
    align-self: flex-start;
  }

  .aud-cta--primary {
    background-color: var(--color-bitter);
    color: var(--color-panna);
    border: 1px solid var(--color-bitter);
  }

  .aud-cta--primary:hover {
    background-color: var(--color-bitter-500);
    border-color: var(--color-bitter-500);
  }

  .aud-cta--ghost {
    background-color: transparent;
    color: var(--color-panna);
    border: 1px solid color-mix(in srgb, var(--color-panna) 40%, transparent);
  }

  .aud-cta--ghost:hover {
    border-color: var(--color-panna);
  }

  /* ---- RESPONSIVE --------------------------------------- */
  @media (max-width: 900px) {
    .proof-inner {
      grid-template-columns: 1fr;
    }
    .proof-visual {
      order: -1;
    }
    .cards-grid {
      grid-template-columns: 1fr;
    }
    .proof-stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hero-card-wrapper {
      padding-left: 1rem;
      background: linear-gradient(
        to right,
        rgba(0, 0, 0, 0.35) 0%,
        rgba(0, 0, 0, 0.15) 40%,
        transparent 75%
      );
    }
    .hero-card {
      padding: var(--space-md);
    }
    .hero-inner {
      max-width: 100%;
    }
    .hero-cta {
      flex-direction: column;
      width: 100%;
    }
    .btn { width: 100%; justify-content: center; }
  }
</style>
