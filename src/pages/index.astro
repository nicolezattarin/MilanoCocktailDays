---
import BaseLayout from '../layouts/BaseLayout.astro';
import TickerBand from '../components/TickerBand.astro';
import StatGrid from '../components/StatGrid.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { builder } from '@builder.io/sdk';

let content = null;
if (import.meta.env.BUILDER_API_KEY) {
  try {
    builder.init(import.meta.env.BUILDER_API_KEY);
    content = await builder.get('page', { userAttributes: { urlPath: '/' } }).toPromise();
  } catch (e) {
    console.warn('Failed to fetch Builder.io content:', e);
  }
}

const partners = [
  'Tanqueray', 'Campari', 'Amaro Montenegro',
  'Fever-Tree', 'Martini', "Hendrick's",
  'Bulleit', 'Aperol', 'Cynar', 'Santa Teresa',
];



const stats = [
  { value: 'TBA',   label: 'Bar Partner' },
  { value: '10',    label: 'Serate' },
  { value: '30+',   label: 'Bartender' },
  { value: '1.000', label: 'Posti disponibili' },
];

const audience = [
  { tag: 'Appassionati', title: 'APPASSIONATI DI COCKTAIL', desc: 'Cocktail signature esclusivi creati appositamente per MCD, degustazioni guidate e accesso ai migliori bar della città.' },
  { tag: 'Amici',        title: 'SERATE TRA AMICI',         desc: 'Il pretesto perfetto per esplorare Milano by night: 10 serate, 10 bar diversi, un pass che apre tutte le porte.' },
  { tag: 'Date',         title: 'DATE NIGHT',               desc: "Locali selezionati con cura, atmosfera unica, cocktail d'autore. La serata perfetta per stupire." },
  { tag: 'Esploratori',  title: 'ESPLORATORI',              desc: 'Navigli · Brera · Isola · Porta Romana. Scopri angoli di Milano che non sapevi di amare.' },
];

const steps = [
  { n: '01', title: 'ISCRIVITI',                desc: 'Acquista il Pass Festival e accedi a tutte le serate.' },
  { n: '02', title: 'SCOPRI BAR E COCKTAIL',   desc: 'Ogni bar crea un cocktail signature esclusivo per MCD.' },
  { n: '03', title: 'PRENOTA E DEGUSTA',       desc: 'Prenota il tuo slot nel bar scelto al prezzo speciale MCD.' },
  { n: '04', title: 'COLLEZIONA ESPERIENZE',   desc: '10 serate, 10 bar diversi: costruisci il tuo percorso tra i quartieri di Milano.' },
];

const testimonials = [
  { quote: "Un'esperienza unica nel suo genere. Ho scoperto cocktail bar di Milano che non conoscevo affatto.", name: 'Giulia M.', age: 28, initials: 'GM' },
  { quote: "Finalmente un evento che unisce qualità, socialità e la scoperta autentica della città.", name: 'Marco T.', age: 34, initials: 'MT' },
  { quote: "I cocktail signature erano tutti eccezionali. Il format bar-hopping è perfetto.", name: 'Sofia R.', age: 26, initials: 'SR' },
  { quote: "La qualità dei bartender e dei drink era da vera capitale europea del cocktail.", name: 'Chiara V.', age: 29, initials: 'CV' },
  { quote: "Un'idea brillante per valorizzare la scena cocktail milanese. Assolutamente consigliato.", name: 'Luca F.', age: 35, initials: 'LF' },
  { quote: "Dieci serate, dieci bar diversi: ogni sera era una sorpresa. Non vedo l'ora della prossima edizione.", name: 'Andrea B.', age: 31, initials: 'AB' },
];
---

<BaseLayout
  title="Milan Cocktail Days 2027"
  description="La prima Milan Cocktail Days. 10 serate nei migliori bar di Milano, cocktail signature esclusivi. Aprile–Maggio 2027. Iscriviti ora."
  pageType="event"
>

  <!-- S1 · HERO ------------------------------------------- -->
  <section class="s-hero" aria-labelledby="home-h1">
    <!-- Background photo: sostituire src con immagine reale 1920×1080 -->
    <picture class="hero-bg" aria-hidden="true">
      <source srcset="/images/hero.webp" type="image/webp" />
      <img
        src="/images/hero.jpg"
        alt=""
        width="1920"
        height="1080"
        fetchpriority="high"
        loading="eager"
      />
    </picture>
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="wrap hero-inner">
      <p class="hero-overline" aria-hidden="true">Milano · maggio 2027</p>

      <div class="hero-h1-wrap mcw-bracket">
        <h1 id="home-h1" class="hero-h1">
          La Prima<br /><em>Milan Cocktail</em><br />Days.
        </h1>
      </div>

      <p class="hero-sub">Prima edizione · Iscrizioni aperte</p>

      <div class="hero-cta">
        <a href="#form" class="btn btn--primary cta-iscrizione">Iscriviti ora</a>
        <a href="/festival" class="btn btn--ghost">Scopri il festival →</a>
      </div>
    </div>
  </section>

  <!-- S2 · TICKER ----------------------------------------- -->
  <TickerBand items={partners} />

  <!-- S3 · STATISTICHE ------------------------------------ -->
  <section class="s-stats" aria-label="I numeri di Milan Cocktail Days">
    <div class="wrap">
      <StatGrid stats={stats} />
    </div>
  </section>

  <!-- S4 · PER CHI È MCD ---------------------------------- -->
  <section class="s-audience" aria-labelledby="audience-h2">
    <div class="wrap">
      <div class="section-header">
        <p class="section-overline">Per chi è MCD</p>
        <h2 id="audience-h2" class="section-h2">Un festival<br />per tutti</h2>
      </div>
      <div class="audience-grid">
        {audience.map(({ tag, title: cardTitle, desc }, idx) => (
          <article class="audience-card">
            <div class="card-img">
              <!-- Photo slot: sostituire src con immagine reale -->
              <img
                class="card-photo"
                src={`/images/audience-${idx + 1}.jpg`}
                alt={cardTitle}
                loading="lazy"
                width="400"
                height="300"
              />
              <span class="card-tag" aria-hidden="true">{tag}</span>
            </div>
            <div class="card-body">
              <h3 class="card-title">{cardTitle}</h3>
              <p class="card-desc">{desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- S5 · COME FUNZIONA ---------------------------------- -->
  <section class="s-how" aria-labelledby="how-h2">
    <div class="wrap how-inner">
      <!-- Mockup stilizzato: aria-hidden perché decorativo -->
      <div class="app-mock" aria-hidden="true">
        <div class="phone-frame">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            <div class="phone-header-bar"></div>
            <div class="phone-card-lg"></div>
            <div class="phone-card-row">
              <div class="phone-card-sm"></div>
              <div class="phone-card-sm"></div>
            </div>
            <div class="phone-card-lg phone-card-lg--xs"></div>
          </div>
        </div>
      </div>

      <div class="how-steps">
        <p class="section-overline--light">Come funziona</p>
        <h2 id="how-h2" class="section-h2--light">
          Il tuo percorso<br />tra i bar di Milano
        </h2>
        <ol class="step-list" role="list">
          {steps.map(({ n, title: stepTitle, desc }) => (
            <li class="step">
              <span class="step-n" aria-hidden="true">{n}</span>
              <div class="step-body">
                <h3 class="step-title">{stepTitle}</h3>
                <p class="step-desc">{desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- S6 · BAR PREVIEW ------------------------------------ -->
  <section class="s-bars" aria-labelledby="bars-h2">
    <div class="wrap">
      <div class="section-header">
        <p class="section-overline">I bar partecipanti</p>
        <h2 id="bars-h2" class="section-h2">I Bar<br />Partecipanti</h2>
        <p class="section-tba">TBA · I bar partner saranno annunciati presto</p>
      </div>
      <div class="bars-grid">
        {[1, 2, 3, 4].map((i) => (
          <article class="bar-card">
            <div class="bar-img">
              <!-- Photo slot: sostituire src con foto bar reale -->
              <img
                class="bar-photo"
                src={`/images/bar-${i}.jpg`}
                alt={`Bar partner MCD ${i} — coming soon`}
                loading="lazy"
                width="600"
                height="400"
              />
              <span class="bar-star" aria-hidden="true">✶</span>
            </div>
            <div class="bar-info">
              <p class="bar-name">Bar Partner MCD</p>
              <p class="bar-city">Milano</p>
            </div>
          </article>
        ))}
      </div>
      <div class="bars-cta">
        <a href="/bars" class="link-more">Vedi tutti →</a>
      </div>
    </div>
  </section>

  <!-- S7 · TESTIMONIAL ------------------------------------ -->
  <section class="s-test" aria-labelledby="test-h2">
    <div class="wrap">
      <p class="section-overline--light">Cosa dicono</p>
      <h2 id="test-h2" class="section-h2--light">
        Voci dalla prima edizione <span aria-hidden="true">✶</span>
      </h2>
    </div>
    <div class="test-outer">
      <div class="test-track" role="list">
        {testimonials.map(({ quote, name, age, initials }) => (
          <article class="test-card" role="listitem">
            <blockquote class="test-quote">"{quote}"</blockquote>
            <div class="test-author">
              <div class="test-avatar" aria-hidden="true">{initials}</div>
              <div>
                <p class="test-name">{name}</p>
                <p class="test-age">{age} anni</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- S8 · CTA FINALE ------------------------------------- -->
  <CtaBanner
    title="Posti limitati. Iscriviti ora."
    ctaText="Iscriviti →"
    ctaHref="#form"
    variant="borgogna"
    ctaClass="cta-iscrizione"
  />

  <!-- S8.5 · BUILDER CONTENT ----------------------------- -->
  {content && <div set:html={content.data?.html} />}

  <!-- S9 · FORM ISCRIZIONE --------------------------------- -->
  <section class="s-form" id="form" aria-labelledby="form-h2">
    <div class="wrap">
      <h2 id="form-h2" class="form-heading">
        Lascia i tuoi dati <span aria-hidden="true">✶</span>
      </h2>
      <p class="form-intro">
        Iscriviti alla lista d'attesa. Ti contatteremo appena le vendite saranno aperte.
      </p>
      <div class="tally-wrap">
        <iframe
          data-tally-src="https://tally.so/embed/Y5pkp5?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1&hideFooter=1"
          loading="lazy"
          width="100%"
          height="689"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          title="Milano Cocktail Days — Iscrizione"
        ></iframe>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ---- HERO --------------------------------------------- */
  .s-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: var(--section-py) 0;
    background-color: var(--color-panna); /* fallback quando foto mancante */
    overflow: hidden;
  }

  /* Foto hero: occupa tutta la sezione, oggetto centrato a destra */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
  }

  /* Overlay: panna pieno su sinistra (testo leggibile), sfuma verso destra */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      var(--color-panna) 0%,
      var(--color-panna) 30%,
      color-mix(in srgb, var(--color-panna) 85%, transparent) 50%,
      color-mix(in srgb, var(--color-panna) 20%, transparent) 70%,
      transparent 100%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    max-width: 55%; /* testo occupa metà sinistra, foto visibile a destra */
  }

  .hero-overline {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-basilico);
    margin: 0;
  }

  .hero-h1-wrap {
    padding: var(--space-sm) var(--space-md);
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-hero);
    color: var(--color-basilico);
    line-height: 0.92;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .hero-h1 em {
    font-style: italic;
    color: var(--color-mora);
  }

  .hero-sub {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--text-body-lg);
    font-weight: 400;
    color: var(--color-mora);
    line-height: 1.5;
    margin: 0;
  }

  .hero-cta {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-sm);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 2rem;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .btn--primary {
    background-color: var(--color-bitter);
    color: var(--color-panna);
    border: 1px solid var(--color-bitter);
  }

  .btn--primary:hover {
    background-color: var(--color-bitter-500);
    border-color: var(--color-bitter-500);
    color: var(--color-panna);
  }

  .btn--ghost {
    background-color: transparent;
    color: var(--color-mora);
    border: 1px solid var(--color-mora);
  }

  .btn--ghost:hover {
    color: var(--color-basilico);
    border-color: var(--color-basilico);
  }

  /* ---- STATISTICHE -------------------------------------- */
  .s-stats {
    background-color: var(--color-fumo);
    padding: var(--section-py) 0;
  }

  /* ---- AUDIENCE (avorio) -------------------------------- */
  .s-audience {
    background-color: var(--color-avorio);
    padding: var(--section-py) 0;
  }

  .section-overline {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-basilico);
    margin: 0 0 var(--space-xs);
  }

  .section-overline--light {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-panna);
    opacity: 0.7;
    margin: 0 0 var(--space-xs);
  }

  .section-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-mora);
    line-height: 1.05;
  }

  .section-h2--light {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-panna);
    line-height: 1.05;
  }

  .section-h2--light span {
    color: var(--color-panna);
    font-size: 0.5em;
    vertical-align: middle;
    opacity: 0.5;
  }

  .section-header { margin-bottom: var(--space-lg); }

  .section-tba {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro-500);
    margin-top: var(--space-xs);
  }

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    align-items: start;
  }

  .audience-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .card-img {
    position: relative;
    aspect-ratio: 4 / 3;
    width: 100%;
    background-color: var(--color-lino); /* fallback colore quando img assente */
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .card-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .audience-card:hover .card-photo {
    transform: scale(1.05);
  }

  .card-tag {
    position: absolute;
    bottom: var(--space-xs);
    left: var(--space-xs);
    z-index: 1;
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-basilico);
    background-color: var(--color-panna);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
  }

  .card-body { display: flex; flex-direction: column; gap: 6px; }

  .card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-small);
    color: var(--color-mora);
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .card-desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro-500);
    line-height: 1.65;
    margin: 0;
  }

  /* ---- COME FUNZIONA (dark) ------------------------------ */
  .s-how {
    background-color: var(--color-fumo);
    padding: var(--section-py) 0;
  }

  .how-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .app-mock {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .phone-frame {
    width: 240px;
    height: 480px;
    border: 1.5px solid color-mix(in srgb, var(--color-panna) 20%, transparent);
    border-radius: 28px;
    background-color: var(--color-marmo);
    padding: 16px 12px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .phone-notch {
    width: 60px;
    height: 8px;
    background-color: color-mix(in srgb, var(--color-panna) 15%, transparent);
    border-radius: 4px;
    margin: 0 auto 6px;
  }

  .phone-screen {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .phone-header-bar {
    height: 24px;
    background-color: color-mix(in srgb, var(--color-basilico) 40%, transparent);
    border-radius: var(--radius-sm);
  }

  .phone-card-lg {
    flex: 1;
    background-color: color-mix(in srgb, var(--color-bitter) 30%, transparent);
    border-radius: var(--radius-sm);
    border: 0.5px solid color-mix(in srgb, var(--color-panna) 15%, transparent);
  }

  .phone-card-lg--xs { flex: 0 0 40px; background-color: color-mix(in srgb, var(--color-basilico) 20%, transparent); }

  .phone-card-row { display: flex; gap: 8px; height: 60px; }

  .phone-card-sm {
    flex: 1;
    background-color: color-mix(in srgb, var(--color-panna) 10%, transparent);
    border-radius: var(--radius-sm);
  }

  .how-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .how-steps .section-h2--light { margin-bottom: var(--space-md); }

  .step-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .step {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    padding-top: var(--space-sm);
    border-top: var(--border-hairline-dark);
  }

  .step-n {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.5rem, 4vw, 3.75rem);
    color: var(--color-bitter);
    line-height: 1;
    flex-shrink: 0;
    width: 80px;
    letter-spacing: -0.03em;
    display: block;
  }

  .step-body { padding-top: 6px; }

  .step-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-body);
    color: var(--color-panna);
    letter-spacing: 0.04em;
    margin-bottom: 4px;
  }

  .step-desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-pesco-300);
    line-height: 1.65;
    margin: 0;
  }

  /* ---- BAR PREVIEW (avorio) ------------------------------ */
  .s-bars {
    background-color: var(--color-avorio);
    padding: var(--section-py) 0;
  }

  .bars-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .bar-card { display: flex; flex-direction: column; gap: var(--space-xs); }

  .bar-img {
    position: relative;
    aspect-ratio: 3 / 2;
    width: 100%;
    background-color: var(--color-lino); /* fallback colore quando img assente */
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .bar-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .bar-card:hover .bar-photo {
    transform: scale(1.05);
  }

  .bar-star {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-basilico);
    font-size: 2rem;
    opacity: 0.2;
    pointer-events: none;
  }

  .bar-info { padding: var(--space-xs) 0 0; }

  .bar-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-body);
    color: var(--color-mora);
    margin: 0 0 2px;
  }

  .bar-city {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-basilico);
    margin: 0;
  }

  .bars-cta { margin-top: var(--space-lg); text-align: center; }

  .link-more {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-basilico);
    text-decoration: none;
    border-bottom: 0.5px solid var(--color-basilico);
    padding-bottom: 2px;
    transition: opacity 0.2s ease;
  }

