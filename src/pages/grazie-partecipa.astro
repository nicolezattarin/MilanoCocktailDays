---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Sei in lista!"
  description="Iscrizione confermata a Milan Cocktail Days 2027. Ti avviseremo per primo all'apertura dei pass."
  noindex={true}
>
  <section class="s-grazie" aria-labelledby="grazie-h1">
    <div class="wrap">
      <div class="grazie-card">
        <span class="grazie-star" aria-hidden="true">✶</span>
        <p class="grazie-label">Partecipanti</p>
        <h1 id="grazie-h1" class="grazie-h1">
          Sei in lista<br /><em>d'attesa.</em>
        </h1>
        <p class="grazie-body">
          Ti scriviamo per primo all'apertura ufficiale dei pass.
          Tieniti pronto: i posti sono limitati.
        </p>
        <div class="grazie-next">
          <p class="next-label">Nel frattempo</p>
          <div class="next-actions">
            <a
              href="https://www.instagram.com/milancocktailweek"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--primary"
            >
              Seguici su Instagram →
            </a>
            <button
              class="btn btn--ghost"
              onclick="navigator.share ? navigator.share({ title: 'Milan Cocktail Days 2027', url: 'https://milancocktaildays.it/partecipa' }) : null"
              aria-label="Condividi il link a Milan Cocktail Days"
            >
              Condividi il link
            </button>
          </div>
        </div>
        <div class="grazie-footer">
          <a href="/" class="back-link">← Torna alla home</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
  }

  .s-grazie {
    min-height: 100svh;
    background-color: var(--color-fumo);
    display: flex;
    align-items: center;
    padding: var(--section-py) 0;
  }

  .grazie-card {
    max-width: 580px;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .grazie-star {
    display: block;
    color: var(--color-bitter);
    font-size: 2.5rem;
    line-height: 1;
  }

  .grazie-label {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-panna);
    opacity: 0.6;
    margin: 0;
  }

  .grazie-h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-hero);
    color: var(--color-panna);
    line-height: 0.92;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .grazie-h1 em {
    font-style: italic;
    color: var(--color-bitter);
  }

  .grazie-body {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    color: var(--color-pesco-300);
    line-height: 1.65;
    margin: 0;
  }

  .grazie-next {
    padding-top: var(--space-md);
    border-top: var(--border-hairline-dark);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .next-label {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-panna);
    opacity: 0.5;
    margin: 0;
  }

  .next-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 1.75rem;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .btn--primary {
    background-color: var(--color-bitter);
    color: var(--color-panna);
    border: 1px solid var(--color-bitter);
  }

  .btn--primary:hover {
    background-color: var(--color-bitter-500);
    border-color: var(--color-bitter-500);
  }

  .btn--ghost {
    background-color: transparent;
    color: var(--color-panna);
    border: 1px solid color-mix(in srgb, var(--color-panna) 40%, transparent);
  }

  .btn--ghost:hover { border-color: var(--color-panna); }

  .grazie-footer {
    padding-top: var(--space-sm);
  }

  .back-link {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-panna);
    opacity: 0.5;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .back-link:hover { opacity: 1; }

  @media (max-width: 480px) {
    .next-actions { flex-direction: column; }
    .btn { justify-content: center; }
  }
</style>
