---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Candidatura ricevuta"
  description="Abbiamo ricevuto la candidatura del tuo bar a Milan Cocktail Days 2027. Ti rispondiamo entro 5 giorni."
  noindex={true}
>
  <section class="s-grazie" aria-labelledby="grazie-h1">
    <div class="wrap">
      <div class="grazie-card">
        <span class="grazie-star" aria-hidden="true">✶</span>
        <p class="grazie-label">Bar Partner</p>
        <h1 id="grazie-h1" class="grazie-h1">
          Candidatura<br /><em>ricevuta.</em>
        </h1>
        <p class="grazie-body">
          Ti rispondiamo entro 5 giorni lavorativi. Se la candidatura
          è in linea con la selezione, organizziamo una call di 30 minuti
          per valutare insieme i dettagli.
        </p>
        <div class="grazie-steps">
          <div class="step-row">
            <span class="step-dot" aria-hidden="true">01</span>
            <p class="step-text">Revisione candidatura · entro 5 giorni</p>
          </div>
          <div class="step-row">
            <span class="step-dot" aria-hidden="true">02</span>
            <p class="step-text">Call di allineamento · 30 minuti</p>
          </div>
          <div class="step-row">
            <span class="step-dot" aria-hidden="true">03</span>
            <p class="step-text">Conferma partnership · onboarding app</p>
          </div>
        </div>
        <div class="grazie-next">
          <p class="next-label">Seguici</p>
          <div class="next-actions">
            <a
              href="https://www.instagram.com/milancocktailweek"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--primary"
            >
              Seguici su Instagram →
            </a>
            <a href="/bar" class="btn btn--ghost">Torna alla pagina bar</a>
          </div>
        </div>
        <div class="grazie-footer">
          <a href="/" class="back-link">← Torna alla home</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
  }

  .s-grazie {
    min-height: 100svh;
    background-color: var(--color-basilico);
    display: flex;
    align-items: center;
    padding: var(--section-py) 0;
  }

  .grazie-card {
    max-width: 580px;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .grazie-star {
    display: block;
    color: var(--color-bitter);
    font-size: 2.5rem;
    line-height: 1;
  }

  .grazie-label {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-panna);
    opacity: 0.6;
    margin: 0;
  }

  .grazie-h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-hero);
    color: var(--color-panna);
    line-height: 0.92;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .grazie-h1 em {
    font-style: italic;
    color: var(--color-bitter);
  }

  .grazie-body {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    color: var(--color-pesco-300);
    line-height: 1.65;
    margin: 0;
  }

  .grazie-steps {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: var(--space-sm) 0;
    border-top: var(--border-hairline-dark);
  }

  .step-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    padding: var(--space-sm) 0;
    border-bottom: var(--border-hairline-dark);
  }

  .step-dot {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.5rem;
    color: var(--color-bitter);
    letter-spacing: -0.02em;
    flex-shrink: 0;
    width: 40px;
  }

  .step-text {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-pesco-300);
    line-height: 1.5;
    margin: 0;
  }

  .grazie-next {
    padding-top: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .next-label {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-panna);
    opacity: 0.5;
    margin: 0;
  }

  .next-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 1.75rem;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .btn--primary {
    background-color: var(--color-bitter);
    color: var(--color-panna);
    border: 1px solid var(--color-bitter);
  }

  .btn--primary:hover { background-color: var(--color-bitter-500); border-color: var(--color-bitter-500); }

  .btn--ghost {
    background-color: transparent;
    color: var(--color-panna);
    border: 1px solid color-mix(in srgb, var(--color-panna) 35%, transparent);
  }

  .btn--ghost:hover { border-color: var(--color-panna); }

  .grazie-footer { padding-top: var(--space-sm); }

  .back-link {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-panna);
    opacity: 0.5;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .back-link:hover { opacity: 1; }

  @media (max-width: 480px) {
    .next-actions { flex-direction: column; }
    .btn { justify-content: center; }
  }
</style>
