---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import StatGrid from '../components/StatGrid.astro';
import CtaBanner from '../components/CtaBanner.astro';

const stats = [
  { value: 'TBA',   label: 'Bar' },
  { value: '10',    label: 'Serate' },
  { value: '30+',   label: 'Bartender' },
  { value: 'TBA',   label: 'Cocktail Signature' },
  { value: '1.000', label: 'Posti' },
  { value: '1ª',    label: 'Edizione' },
];

const steps = [
  { n: '01', title: 'ISCRIVITI',              desc: 'Acquista il Pass Festival o il Pass VIP. Il pass ti dà accesso a tutte e 10 le serate.' },
  { n: '02', title: 'SCOPRI BAR E COCKTAIL', desc: 'Ogni bar partner crea un cocktail signature esclusivo per MCD. Sfoglia il catalogo.' },
  { n: '03', title: 'PRENOTA E DEGUSTA',     desc: 'Prenota il tuo slot nel bar preferito e degusta il cocktail signature al prezzo speciale MCD.' },
  { n: '04', title: 'COLLEZIONA ESPERIENZE', desc: 'Esplora quartieri diversi, conosci i bartender, colleziona 10 esperienze in 10 serate consecutive.' },
];

const quartieri = [
  { nome: 'Navigli',       desc: "L'anima notturna di Milano. Canali, bar storici e l'aperitivo più autentico della città." },
  { nome: 'Brera',         desc: "Eleganza e cultura nel cuore di Milano. Vie lastricate, gallerie d'arte e cocktail bar raffinati." },
  { nome: 'Isola',         desc: 'Il quartiere creativo in evoluzione. Design, musica e una scena cocktail in continua crescita.' },
  { nome: 'Porta Romana',  desc: 'La nuova frontiera del cocktail milanese. Locali ricercati, carte dei drink di alto livello.' },
];
---

<BaseLayout
  title="Il Festival"
  description="Scopri Milan Cocktail Days: 10 serate, i migliori bar di Milano, cocktail signature creati apposta per l'evento. Prima edizione 2027."
  pageType="event"
>

  <SectionHero
    title="Il Festival"
    subtitle="Milano ✶ Aprile–Maggio 2027"
    overline="Milano · Aprile–Maggio 2027"
  />

  <!-- COS'È MCD (chiara, 2 colonne) ----------------------- -->
  <section class="s-what" aria-labelledby="what-h2">
    <div class="wrap what-inner">
      <div class="what-text">
        <div class="filetto mcw-filetto-doppio"></div>
        <h2 id="what-h2" class="section-h2">
          Cos'è Milan<br />Cocktail Days
        </h2>
        <p class="body-text">
          Milan Cocktail Days è la prima settimana dedicata alla cultura del cocktail a Milano.
          Per 10 serate, i migliori bar della città aprono le porte con cocktail signature
          creati appositamente per l'evento: ricette esclusive, ingredienti selezionati,
          bartender d'eccezione.
        </p>
        <p class="body-text">
          Non è una semplice degustazione. È un percorso tra i quartieri di Milano,
          un'esplorazione della scena cocktail italiana attraverso i suoi protagonisti.
          Ogni serata è un'esperienza autonoma. Insieme, sono qualcosa di unico.
        </p>
        <a href="/contatti" class="btn">Iscriviti ora →</a>
      </div>
      <!-- Placeholder immagine 4/3 -->
      <div
        class="what-img"
        role="img"
        aria-label="Immagine descrittiva del festival Milan Cocktail Days — prossimamente"
      >
        <span class="img-star" aria-hidden="true">✶</span>
      </div>
    </div>
  </section>

  <!-- NUMERI (dark) ---------------------------------------- -->
  <section class="s-numbers" aria-label="I numeri del festival">
    <div class="wrap">
      <StatGrid stats={stats} />
    </div>
  </section>

  <!-- COME FUNZIONA (chiara, 4 step 2×2) ------------------- -->
  <section class="s-how" aria-labelledby="how-h2">
    <div class="wrap">
      <div class="section-header">
        <p class="overline--dark">Come funziona</p>
        <h2 id="how-h2" class="section-h2">
          Il tuo percorso<br />tra i bar di Milano
        </h2>
      </div>
      <ol class="step-list" role="list">
        {steps.map(({ n, title, desc }) => (
          <li class="step">
            <span class="step-n" aria-hidden="true">{n}</span>
            <div class="step-body">
              <h3 class="step-title">{title}</h3>
              <p class="step-desc">{desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- QUARTIERI (dark) ------------------------------------- -->
  <section class="s-quartieri" aria-labelledby="quartieri-h2">
    <div class="wrap">
      <div class="section-header">
        <p class="overline--light">Il festival si svolge in tutta Milano</p>
        <h2 id="quartieri-h2" class="section-h2--light">I Quartieri</h2>
      </div>
      <div class="quartieri-grid">
        {quartieri.map(({ nome, desc }) => (
          <article class="quartiere-card">
            <div class="quartiere-top mcw-filetto--dark">
              <h3 class="quartiere-nome">{nome}</h3>
            </div>
            <p class="quartiere-desc">{desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner
    title="Posti limitati. Iscriviti ora."
    ctaText="Iscriviti →"
    ctaHref="/contatti"
    variant="borgogna"
    ctaClass="cta-iscrizione"
  />

</BaseLayout>

<style>
  .wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ---- Tipografia --------------------------------------- */
  .section-h2 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-mora);
    line-height: 1.05;
  }

  .section-h2--light {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-panna);
    line-height: 1.05;
  }

  .overline--dark {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-basilico);
    margin: 0 0 var(--space-xs);
  }

  .overline--light {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-panna);
    opacity: 0.65;
    margin: 0 0 var(--space-xs);
  }

  .section-header { margin-bottom: var(--space-lg); }

  .body-text {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-inchiostro);
    line-height: 1.8;
    margin: 0 0 var(--space-sm);
  }

  /* ---- COS'È MCD (avorio) ------------------------------- */
  .s-what {
    background-color: var(--color-avorio);
    padding: var(--section-py) 0;
  }

  .what-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .what-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .filetto {
    width: 60px;
    margin-bottom: var(--space-sm);
  }

  /* Placeholder immagine 4/3: dimensioni esplicite anti-CLS */
  .what-img {
    aspect-ratio: 4 / 3;
    width: 100%;
    background-color: var(--color-lino);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .img-star {
    color: var(--color-basilico);
    font-size: 3rem;
    opacity: 0.25;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 2rem;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: var(--color-panna);
    background-color: var(--color-bitter);
    border: 1px solid var(--color-bitter);
    border-radius: var(--radius-sm);
    margin-top: var(--space-sm);
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    align-self: flex-start;
  }

  .btn:hover {
    background-color: var(--color-bitter-500);
    border-color: var(--color-bitter-500);
    color: var(--color-panna);
  }

  /* ---- NUMERI (dark) ------------------------------------- */
  .s-numbers {
    background-color: var(--color-fumo);
    padding: var(--section-py) 0;
  }

  /* ---- COME FUNZIONA (avorio, 2×2) ----------------------- */
  .s-how {
    background-color: var(--color-avorio);
    padding: var(--section-py) 0;
  }

  .step-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md) var(--space-xl);
  }

  .step {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 0.5px solid var(--color-panna-300);
  }

  .step-n {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    color: var(--color-bitter);
    line-height: 1;
    letter-spacing: -0.03em;
    display: block;
    width: 70px;
    flex-shrink: 0;
  }

  .step-body { padding-top: 4px; }

  .step-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-body);
    color: var(--color-mora);
    letter-spacing: 0.04em;
    margin-bottom: var(--space-xs);
  }

  .step-desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-inchiostro-500);
    line-height: 1.65;
    margin: 0;
  }

  /* ---- QUARTIERI (dark) --------------------------------- */
  .s-quartieri {
    background-color: var(--color-fumo);
    padding: var(--section-py) 0;
  }

  .quartieri-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .quartiere-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .quartiere-top { padding-top: var(--space-sm); }

  .quartiere-nome {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h2);
    color: var(--color-avorio);
    line-height: 1.05;
    margin: var(--space-xs) 0 0;
  }

  .quartiere-desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-pietra);
    line-height: 1.65;
    margin: 0;
    opacity: 0.85;
  }

  /* ---- RESPONSIVE --------------------------------------- */
  @media (max-width: 768px) {
    .what-inner { grid-template-columns: 1fr; }
    .step-list  { grid-template-columns: 1fr; }
    .quartieri-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 480px) {
    .quartieri-grid { grid-template-columns: 1fr; }
  }
</style>
