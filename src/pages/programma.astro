---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import TbaBox from '../components/TbaBox.astro';
import CtaBanner from '../components/CtaBanner.astro';

const serate = Array.from({ length: 10 }, (_, i) => ({
  num: String(i + 1).padStart(2, '0'),
}));
---

<BaseLayout
  title="Il Programma"
  description="Il programma di Milan Cocktail Week 2027. 10 serate, date e venue TBA. Iscriviti per ricevere gli aggiornamenti prima di tutti."
>

  <SectionHero
    title="Il Programma"
    subtitle="10 serate · TBA"
    overline="Milano · Aprile–Maggio 2027"
  />

  <TbaBox
    title="Il programma sarà annunciato presto"
    body="Stiamo definendo il calendario delle 10 serate con i bar partner. Il programma dettagliato — date, venue, cocktail signature e bartender — sarà pubblicato nei prossimi mesi."
    ctaText="Ricevi gli aggiornamenti →"
    ctaHref="/contatti"
  />

  <!-- CALENDARIO PLACEHOLDER (dark) ----------------------- -->
  <section class="s-cal" aria-labelledby="cal-h2">
    <div class="wrap">
      <h2 id="cal-h2" class="cal-heading">
        Le 10 Serate <span aria-hidden="true">✶</span>
      </h2>

      <ol class="serate-list" role="list">
        {serate.map(({ num }) => (
          <li class="serata">
            <div class="serata-inner">
              <div class="serata-top mcw-filetto">
                <div class="serata-meta">
                  <span class="serata-num">SERATA {num}</span>
                  <span class="badge-soon" aria-label="Prossimamente">Prossimamente</span>
                </div>
              </div>

              <div class="serata-body">
                <h3 class="serata-title">TBA</h3>
                <p class="serata-details">
                  Data TBA
                  <span class="dot" aria-hidden="true">✶</span>
                  Venue TBA
                  <span class="dot" aria-hidden="true">✶</span>
                  Ore TBA
                </p>
              </div>

              <button
                class="btn-prenota"
                disabled
                aria-disabled="true"
                aria-label={`Prenotazione serata ${num}: non ancora disponibile`}
              >
                Prenota
              </button>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBanner
    title="Vuoi essere tra i primi a sapere?"
    subtitle="Iscriviti alla lista d'attesa e ricevi il programma in anteprima."
    ctaText="Iscriviti →"
    ctaHref="/contatti"
    variant="borgogna"
  />

</BaseLayout>

<style>
  .wrap {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ---- CALENDARIO (dark) -------------------------------- */
  .s-cal {
    background-color: var(--color-fumo);
    padding: var(--section-py) 0;
  }

  .cal-heading {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h1);
    color: var(--color-avorio);
    line-height: 1.05;
    margin-bottom: var(--space-lg);
  }

  .cal-heading span {
    color: var(--color-oro);
    font-size: 0.5em;
    vertical-align: middle;
  }

  .serate-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .serata {
    border-bottom: var(--border-hairline);
  }

  .serata:last-child { border-bottom: none; }

  .serata-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-xs) var(--space-md);
    padding: var(--space-md) 0;
  }

  .serata-top {
    grid-column: 1 / -1;
    padding-top: var(--space-xs);
  }

  .serata-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding-top: var(--space-xs);
  }

  .serata-num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--text-h2);
    color: var(--color-oro);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .badge-soon {
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    background-color: var(--color-borgogna);
    color: var(--color-avorio);
    white-space: nowrap;
  }

  .serata-body {
    grid-column: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .serata-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
    color: var(--color-avorio);
    line-height: 1.2;
  }

  .serata-details {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-pietra);
    margin: 0;
    opacity: 0.7;
  }

  .dot {
    color: var(--color-oro);
    font-size: 0.4rem;
    line-height: 1.8;
  }

  .btn-prenota {
    grid-column: 2;
    grid-row: 2;
    padding: 6px 16px;
    font-family: var(--font-body);
    font-size: var(--text-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fumo);
    background-color: var(--color-oro);
    border: 1px solid var(--color-oro);
    border-radius: var(--radius-sm);
    cursor: default;
    opacity: 0.4;
    pointer-events: none;
  }

  /* ---- RESPONSIVE --------------------------------------- */
  @media (max-width: 768px) {
    .serata-inner { grid-template-columns: 1fr; }
    .serata-top { grid-column: 1; }
    .btn-prenota { grid-column: 1; grid-row: auto; align-self: flex-start; }
  }
</style>
